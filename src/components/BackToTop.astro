---
// Back-to-Top Button
// Fixed bottom-right, hidden by IntersectionObserver when footer is visible
// Shows after scrolling past one viewport height
---

<button
  type="button"
  aria-label="Back to top"
  class="back-to-top"
  data-scroll-button
>
  <svg
    viewBox="0 0 48 48"
    width="24"
    height="24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M24 8L8 24M24 8L40 24M24 8V40" />
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    background-color: var(--surface-ink);
    color: var(--text-on-ink);
    border: none;
    border-radius: 8px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: 40;
  }

  .back-to-top.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .back-to-top:focus-visible {
    outline: 2px solid var(--text-on-ink);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
</style>

<script>
  const button = document.querySelector('[data-scroll-button]') as HTMLButtonElement;
  const baseFooter = document.querySelector('.base-footer') as HTMLElement;

  if (!button) {
    throw new Error('Back-to-top button not found');
  }

  // Check if reduced motion is preferred
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let rafId: number | null = null;

  // Show button after scrolling past one viewport height, hide when footer is visible
  const handleScroll = () => {
    if (rafId !== null) {
      cancelAnimationFrame(rafId);
    }

    rafId = requestAnimationFrame(() => {
      const scrolled = window.scrollY > window.innerHeight;
      const footerTop = baseFooter.getBoundingClientRect().top;
      const footerVisible = footerTop < window.innerHeight - 80;
      const shouldShow = scrolled && !footerVisible;

      button.classList.toggle('visible', shouldShow);
      rafId = null;
    });
  };

  // Scroll to top handler
  button.addEventListener('click', () => {
    if (prefersReducedMotion) {
      window.scrollTo(0, 0);
      const topElement = document.querySelector('main') || document.body;
      (topElement as HTMLElement).focus({ preventScroll: true });
    } else {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
      setTimeout(() => {
        const topElement = document.querySelector('main') || document.body;
        (topElement as HTMLElement).focus({ preventScroll: true });
      }, 1000);
    }
  });

  // Listen for scroll events with requestAnimationFrame throttling
  window.addEventListener('scroll', handleScroll, { passive: true });

  // Call once on load to set initial state
  handleScroll();

  // Cleanup on page unload
  window.addEventListener('beforeunload', () => {
    window.removeEventListener('scroll', handleScroll);
    if (rafId !== null) {
      cancelAnimationFrame(rafId);
    }
  });
</script>
