---
// Blocks Carousel - Page-based carousel with hover-zones and visible arrow buttons
// Two-column layout: LEFT (500px text/button) | RIGHT (carousel 1109px)

import TwoPillButton from './TwoPillButton.astro';

const icons = import.meta.glob('/public/assets/icons/blocks/*.svg', {
  query: '?raw', import: 'default', eager: true
});

interface Block {
  title: string;
  description: string;
  image?: string;
  link?: string;
  slug?: string;
}

interface Props {
  blocks?: Block[];
  sectionLabel?: string;
  sectionHeading?: string;
  ctaLabel?: string;
  ctaLink?: string;
}

const {
  blocks = [],
  sectionLabel = "OUR BLOCKS",
  sectionHeading = "Blocks",
  ctaLabel = "Explore",
  ctaLink = "#"
} = Astro.props;
---

<section class="courses" id="blocks" data-surface="paper">
  <div class="courses-inner">
    <!-- LEFT COLUMN: 500px, eyebrow + heading + button + pagination -->
    <div class="courses-left">
      <div class="courses-header">
        <p class="courses-eyebrow">{sectionLabel}</p>
        <h2 class="courses-heading">{sectionHeading}</h2>
      </div>

      <!-- VIEW ALL BUTTON: Shared two-pill component -->
      <TwoPillButton label={ctaLabel} href={ctaLink} />

      <!-- PAGINATION CONTROLS: Below the button on the left side -->
      <div class="pagination-controls">
        <button class="carousel-button carousel-button-prev" aria-label="Previous blocks" data-direction="prev">
          <div class="button-icon-wrapper">
            <svg width="100%" height="100%" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <line x1="2.5" y1="12" x2="23.5" y2="12" fill="none" stroke="currentColor" stroke-miterlimit="10" stroke-width="1.5"></line>
              <polyline points="10.14 4.36 2.5 12 10.14 19.64" fill="none" stroke="currentColor" stroke-miterlimit="10" stroke-width="1.5"></polyline>
            </svg>
          </div>
        </button>
        <button class="carousel-button carousel-button-next" aria-label="Next blocks" data-direction="next">
          <div class="button-icon-wrapper">
            <svg width="100%" height="100%" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <line x1="21.5" y1="12" x2="0.5" y2="12" fill="none" stroke="currentColor" stroke-miterlimit="10" stroke-width="1.5"></line>
              <polyline points="13.86 4.36 21.5 12 13.86 19.64" fill="none" stroke="currentColor" stroke-miterlimit="10" stroke-width="1.5"></polyline>
            </svg>
          </div>
        </button>
      </div>
    </div>

    <!-- RIGHT COLUMN: Carousel (1109px, or fill remaining) -->
    <div class="courses-right">
      <!-- Invisible left hover zone -->
      <div class="carousel-zone carousel-zone-left" data-direction="prev"></div>

      <!-- Carousel viewport (overflow clip) -->
      <div class="carousel-viewport">
        <!-- Track: position absolute, flex row, gap 20px, overflowing -->
        <div class="carousel-track">
          {blocks.map((block, index) => {
            return (
              <a href={block.link || "#"} class="block-card">
                <div class="block-image-wrapper">
                  <div class="block-icon-tile">
                    <span class="block-icon" set:html={block.slug ? icons[`/public/assets/icons/blocks/${block.slug}.svg`] : ''} aria-hidden="true" />
                  </div>
                </div>
                <h3 class="block-card-title">{block.title}</h3>
                <p class="block-card-description">{block.description}</p>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Invisible right hover zone -->
      <div class="carousel-zone carousel-zone-right" data-direction="next"></div>
    </div>
  </div>
</section>

<style>
  /* SECTION SHELL: flex column, center alignment, padding 200px 40px, gap 40px */
  .courses {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 200px 40px;
    gap: 40px;
    background: var(--surface-paper);
    width: 100%;
    box-sizing: border-box;
  }

  /* INNER ROW: flex row, space-between, align-items flex-start, two columns */
  .courses-inner {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    gap: 20px;
  }

  /* LEFT COLUMN: 500px wide, flex column, match carousel height (571px) */
  .courses-left {
    flex: 0 0 500px;
    display: flex;
    flex-direction: column;
    height: 571px;
  }

  /* Eyebrow + heading block (natural document flow spacing) */
  .courses-header {
    display: flex;
    flex-direction: column;
  }

  .courses-eyebrow {
    font-size: 14px;
    font-weight: var(--font-weight-medium);
    line-height: 19.6px;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: var(--text-on-paper);
    margin: 0 0 12px 0;
  }

  .courses-heading {
    font-size: 40px;
    font-weight: var(--font-weight-normal);
    line-height: 48px;
    letter-spacing: var(--heading-letter-spacing);
    color: var(--text-on-paper);
    margin: 0 0 40px 0;
    white-space: pre-line;
  }

  /* TwoPillButton component handles styling */
  :global(.two-pill-button) {
    margin-top: 40px;
  }

  /* PAGINATION CONTROLS: At bottom of left column with spacing */
  .pagination-controls {
    display: flex;
    flex-direction: row;
    gap: 12px;
    margin-top: auto;
  }

  /* Icon wrapper for SVG centering */
  .button-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
  }

  /* Visible navigation buttons (white by default, invert on hover) */
  .carousel-button {
    width: 70px;
    height: 70px;
    border-radius: 8px;
    background: var(--surface-paper);
    color: var(--text-on-paper);
    border: 1px solid var(--surface-alt);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 20;
    transition: all 200ms ease;
    flex: 0 0 70px;
  }

  .carousel-button:disabled {
    pointer-events: none;
    opacity: 0.5;
  }

  .carousel-button:hover:not(:disabled) {
    background: var(--surface-ink);
    color: var(--surface-paper);
    border-color: var(--surface-ink);
  }

  /* RIGHT COLUMN: Carousel (1109px wide, or fill remaining space) */
  .courses-right {
    flex: 1;
    position: relative;
    overflow: clip;
    min-height: 571px;
  }

  /* Invisible hover zones (left and right edges) */
  .carousel-zone {
    position: absolute;
    top: 0;
    height: 100%;
    width: 15%;
    opacity: 0;
    cursor: pointer;
    z-index: 10;
  }

  .carousel-zone-left {
    left: 0;
  }

  .carousel-zone-right {
    right: 0;
  }

  .carousel-zone:disabled,
  .carousel-zone[data-disabled] {
    pointer-events: none;
  }

  /* Carousel viewport (overflow clip, position relative for absolute track) */
  .carousel-viewport {
    position: relative;
    overflow: clip;
    width: 100%;
    height: 571px;
  }

  /* Track: position absolute, flex row, gap 20px, width = sum of cards + gaps */
  .carousel-track {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    flex-direction: row;
    gap: 20px;
    transition: transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Course cards: fixed size 500x571px */
  .block-card {
    flex: 0 0 var(--card-w, 500px);
    height: 571px;
    background: var(--surface-paper);
    border-radius: 6px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    text-align: left;
    box-sizing: border-box;
    overflow: visible;
  }

  .block-card:focus-visible {
    outline: 2px solid var(--text-on-paper);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px var(--surface-paper);
  }

  .block-image-wrapper {
    width: 100%;
    aspect-ratio: 3 / 2;
    background: var(--acid);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .block-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: filter 300ms ease;
  }

  .block-image:not([src]),
  .block-image[src=""] {
    display: none;
  }

  .block-card-title {
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
    line-height: 1.4;
    color: var(--text-on-paper);
    margin: 0;
    text-align: left;
  }

  .block-card-description {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: var(--font-weight-normal);
    line-height: 1.4;
    color: var(--text-on-paper-muted);
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    text-align: left;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 300ms ease, transform 300ms ease;
  }

  .block-card:hover .block-image {
    transform: scale(1.08);
  }

  .block-card:hover .block-card-title,
  .block-card:hover .block-card-description {
    opacity: 1;
    transform: translateY(0);
  }

  .block-icon-tile {
    background: var(--acid);
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }

  .block-icon {
    color: var(--text-on-acid);
    display: block;
    width: clamp(77px, 21.6%, 125px);
  }

  .block-icon svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* RESPONSIVE: Stack layout below 640px */
  @media (max-width: 640px) {
    .courses {
      padding: 60px 20px;
    }

    .courses-inner {
      flex-direction: column;
      gap: 40px;
    }

    .courses-left {
      flex: 0 0 auto;
      max-width: 100%;
      width: 100%;
      height: auto;
    }

    .courses-right {
      flex: 0 0 auto;
      width: 100%;
      max-width: 100vw;
      min-height: auto;
    }

    /* Mobile carousel: responsive peek-scroll pattern */
    .carousel-viewport {
      width: 100%;
      height: auto;
      overflow: clip;
    }

    .carousel-track {
      position: relative;
      gap: 14px;
    }

    .block-card {
      flex: 0 0 var(--card-w, 280px);
      height: auto;
      padding: 20px;
    }

    .block-image-wrapper {
      aspect-ratio: 3 / 2;
    }

    .block-card-title {
      font-size: var(--font-size-body);
    }

    .block-card-description {
      font-size: 14px;
    }
  }

  /* WCAG 1.4.10 REFLOW: Below 375px, reduce container and remove peek */
  @media (max-width: 374px) {
    .courses-right {
      width: 280px;
    }

    .carousel-viewport {
      width: 280px;
    }
  }

</style>

<script is:inline>
  // PAGE-BASED CAROUSEL NAVIGATION
  // Paging logic: calculate how many cards fit in viewport, advance by one page per action

  const track = document.querySelector('.carousel-track');
  const viewport = document.querySelector('.carousel-viewport');
  const cards = document.querySelectorAll('.block-card');
  const prevBtn = document.querySelector('.carousel-button-prev');
  const nextBtn = document.querySelector('.carousel-button-next');
  const leftZone = document.querySelector('.carousel-zone-left');
  const rightZone = document.querySelector('.carousel-zone-right');

  if (track && viewport && cards.length > 0) {
    let currentPage = 0;
    let totalPages = 1;

    // Detect mobile vs desktop and set card dimensions
    const getCardDimensions = () => {
      const isMobile = window.innerWidth <= 640;
      if (isMobile) {
        // Mobile: responsive peek pattern
        // Section has 20px padding each side = 40px total
        // Container width = viewport - 40px
        // Card width = container - 55px peek
        const sectionPadding = 40; // 20px left + 20px right
        const peek = 55;
        const containerWidth = window.innerWidth - sectionPadding;
        const cardWidth = Math.max(280, containerWidth - peek); // Never shrink below 280px
        return { cardWidth: Math.floor(cardWidth), gap: 14 };
      } else {
        // Calculate card width from viewport width at desktop
        const cardsPerRow = 2;
        const gap = 20;
        const calculatedCardWidth = (viewport.offsetWidth - gap * (cardsPerRow - 1)) / cardsPerRow;
        return { cardWidth: Math.floor(calculatedCardWidth), gap: gap };
      }
    };

    // Calculate paging based on viewport width
    const calculatePaging = () => {
      const { cardWidth, gap } = getCardDimensions();
      // Add gap to viewport to account for last card having no trailing gap
      const cardsPerView = Math.max(1, Math.floor((viewport.offsetWidth + gap) / (cardWidth + gap)));
      totalPages = Math.max(1, Math.ceil(cards.length / Math.max(1, cardsPerView)));

      // Set CSS custom property for responsive card width
      viewport.style.setProperty('--card-w', cardWidth + 'px');

      return cardsPerView;
    };

    // Update track position based on current page
    const updateTrackPosition = () => {
      const { cardWidth, gap } = getCardDimensions();
      const cardsPerView = Math.max(1, Math.floor((viewport.offsetWidth + gap) / (cardWidth + gap)));
      const offset = currentPage * cardsPerView * (cardWidth + gap);
      track.style.transform = `translateX(-${offset}px)`;
      updateButtonStates();
    };

    // Enable/disable buttons based on boundary logic
    const updateButtonStates = () => {
      const isFirstPage = currentPage === 0;
      const isLastPage = currentPage === totalPages - 1;

      prevBtn.disabled = isFirstPage;
      nextBtn.disabled = isLastPage;
      leftZone.style.pointerEvents = isFirstPage ? 'none' : 'auto';
      rightZone.style.pointerEvents = isLastPage ? 'none' : 'auto';

      if (isFirstPage) {
        leftZone.setAttribute('data-disabled', 'true');
      } else {
        leftZone.removeAttribute('data-disabled');
      }

      if (isLastPage) {
        rightZone.setAttribute('data-disabled', 'true');
      } else {
        rightZone.removeAttribute('data-disabled');
      }
    };

    // Navigate to next or previous page
    const navigate = (direction) => {
      if (direction === 'next' && currentPage < totalPages - 1) {
        currentPage++;
        updateTrackPosition();
      } else if (direction === 'prev' && currentPage > 0) {
        currentPage--;
        updateTrackPosition();
      }
    };

    // Initialize paging
    calculatePaging();
    updateButtonStates();

    // Attach click handlers to visible buttons
    prevBtn?.addEventListener('click', () => navigate('prev'));
    nextBtn?.addEventListener('click', () => navigate('next'));

    // Attach mouseenter handlers to invisible hover zones
    leftZone?.addEventListener('mouseenter', () => navigate('prev'));
    rightZone?.addEventListener('mouseenter', () => navigate('next'));

    // Recalculate paging on window resize
    window.addEventListener('resize', () => {
      calculatePaging();
      currentPage = Math.min(currentPage, totalPages - 1);
      updateTrackPosition();
    });
  }
</script>
