---
// Reusable FAQ Accordion Component
// Accepts faqs array and optional heading as props
// Usage: <FAQ faqs={faqs} heading="Questions" />

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQItem[];
  heading?: string;
  backgroundColor?: string;
}

const {
  faqs,
  heading = "FAQ",
  backgroundColor = "#000000"
} = Astro.props;

// Create a data attribute string for client-side JavaScript
const faqDataJson = JSON.stringify(faqs);
---

<section class="faq" style={`background-color: ${backgroundColor};`}>
  <div class="faq-header">
    <h2 class="faq-title">{heading}</h2>
  </div>

  <div class="faq-list-wrapper">
    <div class="faq-list-spacer"></div>

    <div class="faq-list" data-faqs={faqDataJson}>
      {faqs.map((item, index) => (
        <div class="faq-item" data-index={index} data-open="false">
          <div class="faq-card">
            <div class="faq-question-row" data-index={index}>
              <span class="faq-question-text">{item.question}</span>
              <div class="faq-icon">
                <svg class="faq-icon-plus" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="rgb(255, 255, 255)">
                  <path fill-rule="evenodd" d="M 8 2 A 0.5 0.5 0 0 1 8.5 2.5 V 7.5 H 13.5 A 0.5 0.5 0 0 1 13.5 8.5 H 8.5 V 13.5 A 0.5 0.5 0 0 1 7.5 13.5 V 8.5 H 2.5 A 0.5 0.5 0 0 1 2.5 7.5 H 7.5 V 2.5 A 0.5 0.5 0 0 1 8 2"/>
                </svg>
                <svg class="faq-icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="rgb(255, 255, 255)" style="display: none;">
                  <path fill-rule="evenodd" d="M 13.854 2.854 a 0.5 0.5 0 0 0 -0.708 0 L 8 8.293 L 2.854 2.854 a 0.5 0.5 0 1 0 -0.708 0.708 L 7.293 9 l -5.147 5.146 a 0.5 0.5 0 0 0 0.708 0.708 L 8 9.707 l 5.146 5.147 a 0.5 0.5 0 0 0 0.708 -0.708 L 8.707 9 l 5.147 -5.146 a 0.5 0.5 0 0 0 0 -0.708 Z"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background-color: rgb(0, 0, 0);
    display: flex;
    flex-direction: column;
    padding: 40px;
    gap: 40px;
    width: 100%;
    box-sizing: border-box;
    border-bottom-left-radius: 40px;
    border-bottom-right-radius: 40px;
    margin-bottom: -40px;
    padding-bottom: 200px;
    position: relative;
    z-index: 2;
  }

  .faq-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    gap: 40px;
  }

  .faq-title {
    font-family: Switzer, "Switzer Placeholder", sans-serif;
    font-size: 40px;
    font-weight: 400;
    line-height: 48px;
    letter-spacing: -0.8px;
    color: #FFFFFF;
    margin: 0;
    padding: 0;
    flex: 1 1 0%;
    max-width: 35%;
  }

  .faq-list-wrapper {
    display: flex;
    flex-direction: row;
    width: 100%;
    gap: 40px;
  }

  .faq-list-spacer {
    flex: 1 1 0%;
    max-width: 35%;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    flex: 1;
    max-width: 65%;
    gap: 12px;
    width: 100%;
  }

  .faq-item {
    width: 100%;
    position: relative;
  }

  .faq-card {
    background: rgb(0, 0, 0);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    cursor: pointer;
  }

  .faq-question-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    cursor: pointer;
    width: 100%;
  }

  .faq-question-text {
    font-size: 18px;
    font-weight: 500;
    line-height: 25.2px;
    letter-spacing: -0.36px;
    color: #FFFFFF;
    flex-grow: 1;
    margin: 0;
  }

  .faq-icon {
    aspect-ratio: 1 / 1;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .faq-icon:hover {
    background-color: #FFED4E !important;
  }

  .faq-icon:hover svg {
    fill: rgb(0, 0, 0) !important;
  }

  .faq-icon svg {
    width: 24px !important;
    height: 24px !important;
    fill: rgb(255, 255, 255);
    transition: fill 0.2s ease;
  }

  .faq-answer {
    font-family: Switzer, "Switzer Placeholder", sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 22.4px;
    color: #FFFFFF !important;
    margin: 20px 0 0 0;
    padding: 0;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 1024px) {
    .faq {
      padding: 60px 20px;
    }

    .faq-list-spacer {
      max-width: 35%;
    }

    .faq-list {
      max-width: 65%;
    }
  }

  @media (max-width: 768px) {
    .faq {
      padding: 40px 20px;
    }

    .faq-title {
      font-size: 32px;
      line-height: 40px;
    }

    .faq-list-wrapper {
      flex-direction: column;
    }

    .faq-list-spacer {
      max-width: 100%;
    }

    .faq-list {
      max-width: 100%;
    }
  }
</style>

<script>
  const openItems = new Set();

  document.querySelectorAll('.faq-question-row').forEach((row) => {
    row.addEventListener('click', () => {
      const index = parseInt(row.getAttribute('data-index'));
      const card = row.closest('.faq-card');
      const item = row.closest('.faq-item');
      const iconPlus = item.querySelector('.faq-icon-plus');
      const iconClose = item.querySelector('.faq-icon-close');

      if (openItems.has(index)) {
        // Close this item
        openItems.delete(index);
        item.setAttribute('data-open', 'false');
        const existingAnswer = card.querySelector('.faq-answer');
        if (existingAnswer) {
          existingAnswer.remove();
        }
        iconPlus.style.display = 'block';
        iconClose.style.display = 'none';
      } else {
        // Open this item
        openItems.add(index);
        item.setAttribute('data-open', 'true');

        // Get FAQ data from the list element
        const faqList = document.querySelector('.faq-list');
        const faqDataJson = faqList.getAttribute('data-faqs');
        const faqs = JSON.parse(faqDataJson);

        if (faqs[index]) {
          const answerDiv = document.createElement('p');
          answerDiv.className = 'faq-answer';
          answerDiv.textContent = faqs[index].answer;
          answerDiv.style.cssText = 'color: #FFFFFF !important; font-size: 16px; font-weight: 400; line-height: 22.4px; margin: 20px 0 0 0; padding: 0; margin-top: 20px; padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.1); font-family: Switzer, "Switzer Placeholder", sans-serif;';
          card.appendChild(answerDiv);
        }

        iconPlus.style.display = 'none';
        iconClose.style.display = 'block';
      }
    });
  });
</script>
