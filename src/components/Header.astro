---
import { headerNav } from '../data/navigation';

interface Props {
  surface?: 'paper' | 'ink';
  // acid variant removed: identical to paper in all styles, dead code
}

const { surface = 'paper' } = Astro.props;
---

<div class="header-container" data-surface={surface}>
  <a href="/" class="brand-logo">Basalio.</a>
  <div class="menu-wrapper">
    <button id="menu-toggle" class="menu-btn" aria-label="Toggle menu">
      <span>MENU</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="currentColor" class="plus-icon">
        <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2"/>
      </svg>
    </button>

    <!-- Menu Dropdown -->
    <div class="menu-dropdown" id="menu-dropdown" data-surface="ink">
      {headerNav.map((item) => (
        <a href={item.href} class="menu-item">{item.label}</a>
      ))}
    </div>
  </div>
</div>

<script>
  // Menu toggle functionality
  const menuToggle = document.getElementById('menu-toggle');
  const menuDropdown = document.getElementById('menu-dropdown');

  if (menuToggle && menuDropdown) {
    // Toggle menu on button click
    menuToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      menuDropdown.classList.toggle('active');
    });

    // Close menu when clicking on a menu item
    menuDropdown.querySelectorAll('.menu-item').forEach(item => {
      item.addEventListener('click', () => {
        menuDropdown.classList.remove('active');
      });
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      if (!menuToggle.contains(e.target) && !menuDropdown.contains(e.target)) {
        menuDropdown.classList.remove('active');
      }
    });
  }

  // Surface tracking: update header based on which section is under the header
  const headerContainer = document.querySelector('.header-container');

  if (headerContainer) {
    // Calculate header height dynamically
    const getHeaderHeight = () => {
      const header = document.querySelector('.base-header');
      return header?.offsetHeight || 80;
    };

    const updateHeaderSurface = (entries) => {
      // Find which section is occupying the header's band
      // Sections that are visible in the header's area win
      const visibleSections = entries
        .filter(entry => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

      if (visibleSections.length > 0) {
        const section = visibleSections[0].target;
        const surface = section.getAttribute('data-surface') || 'paper';
        headerContainer.setAttribute('data-surface', surface);
      } else {
        // Fallback to paper if no sections are visible
        headerContainer.setAttribute('data-surface', 'paper');
      }
    };

    // Create observer with rootMargin tuned to header height
    let observer;
    const createObserver = () => {
      const headerHeight = getHeaderHeight();
      observer = new IntersectionObserver(updateHeaderSurface, {
        root: null,
        rootMargin: `-${headerHeight}px 0px -${window.innerHeight - headerHeight}px 0px`,
        threshold: [0, 0.1, 0.25, 0.5, 0.75, 1.0]
      });

      // Observe all sections with data-surface attribute
      document.querySelectorAll('section[data-surface]').forEach(section => {
        observer.observe(section);
      });
    };

    createObserver();

    // Handle window resize to recalculate header height
    window.addEventListener('resize', () => {
      if (observer) observer.disconnect();
      createObserver();
    });
  }
</script>

<style>
  .header-container {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    box-sizing: border-box;
  }

  /* Logo - paper is light background (dark text), ink is dark (light text) */
  .header-container[data-surface='paper'] .brand-logo {
    color: rgb(0, 0, 0);
  }

  .header-container[data-surface='ink'] .brand-logo {
    color: var(--text-on-ink);
  }

  .brand-logo {
    background-color: rgba(0, 0, 0, 0);
    box-sizing: border-box;
    cursor: pointer;
    display: inline;
    font-family: var(--font-sans);
    font-size: 30px;
    font-weight: 600;
    height: auto;
    letter-spacing: -1.5px;
    line-height: 30px;
    padding: 0;
    text-align: start;
    text-decoration: none;
    text-wrap-mode: nowrap;
    transition: color 0.3s cubic-bezier(0, 0, 1, 1), outline-offset 0.2s ease;
    width: auto;
    -webkit-font-smoothing: antialiased;
    outline-offset: 4px;
  }

  .brand-logo:focus-visible {
    outline: 3px solid currentColor;
  }

  /* Menu button - paper is light (dark pill), ink is dark (light pill) */
  .header-container[data-surface='paper'] .menu-btn {
    background: var(--surface-ink);
    color: var(--text-on-ink);
  }

  .header-container[data-surface='ink'] .menu-btn {
    background: var(--surface-paper);
    color: var(--text-on-paper);
  }

  .menu-btn {
    border: none;
    padding: 0px 16px;
    border-radius: 6px;
    font-family: 'Azeret Mono', monospace;
    font-size: 14px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 182px;
    height: 41px;
  }

  .menu-btn:hover {
    opacity: 0.8;
  }

  .plus-icon {
    flex-shrink: 0;
  }

  /* MENU DROPDOWN */
  .menu-wrapper {
    position: relative;
  }

  .menu-dropdown {
    position: absolute;
    top: 36px;
    right: 0;
    width: 182px;
    height: auto;
    background: var(--surface-ink);
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    box-shadow: rgba(0, 0, 0, 0.05) 0px 10px 20px 0px;
    display: flex;
    flex-direction: column;
    align-items: center;
    align-content: center;
    justify-content: center;
    padding: 8px 16px;
    box-sizing: border-box;
    row-gap: 1px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 10;
  }

  .menu-dropdown.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .menu-item {
    width: 150px;
    display: flex;
    flex-direction: row;
    align-items: center;
    align-content: center;
    justify-content: flex-start;
    padding: 14px 0px;
    column-gap: 15px;
    row-gap: 15px;
    font-family: 'Azeret Mono', monospace;
    font-size: 14px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--surface-paper);
    text-decoration: none;
    cursor: pointer;
    box-sizing: border-box;
    white-space: nowrap;
    transition: opacity 0.2s ease;
    min-height: 24px;
  }

  .menu-item:hover {
    color: var(--acid);
  }

  @media (max-width: 768px) {
    .header-container {
      padding: 0 20px;
      height: 60px;
    }

    .brand-logo {
      font-size: 24px;
    }

    .menu-btn {
      width: 160px;
      height: 36px;
      padding: 0px 12px;
      font-size: 12px;
    }

    .menu-dropdown {
      width: 160px;
      height: auto;
    }
  }
</style>
