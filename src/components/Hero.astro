---
// Ramp Hero - 1:1 PIXEL-PERFECT REPLICA
// Exact dimensions from original: 1791×914px
// Hero container: 1791×840px with 74px blocks teaser

import Button from './Button.astro';

interface Props {
  teaserLabel?: string;
  teaserText?: string;
  teaserButton?: string;
  teaserLink?: string;
  buttonVariant?: 'acid' | 'paper' | 'ink';
  eyebrow?: string;
  background?:
    | { type: 'color'; token: 'acid' | 'paper' | 'ink' | 'alt' }
    | { type: 'image'; src: string; position?: string; scrim?: number }
    | { type: 'video'; src: string; poster: string; position?: string; scrim?: number }
    | { type: 'gradient'; from: string; to: string; angle?: string };
  surface?: 'acid' | 'paper' | 'ink';
}

const {
  teaserLabel,
  teaserText,
  teaserButton,
  teaserLink,
  buttonVariant = 'paper',
  eyebrow,
  background = { type: 'color', token: 'acid' },
  surface = 'acid'
} = Astro.props;

const colorMap = {
  acid: 'var(--acid)',
  paper: 'var(--surface-paper)',
  ink: 'var(--surface-ink)',
  alt: 'var(--surface-alt)'
};

const scrimOpacity = background.type === 'image' || background.type === 'video' ? (background.scrim ?? 0.4) : 0;

// Scrim color derives from surface to push background away from text
// ink (light text) → dark scrim darkens background further
// paper/acid (dark text) → light scrim lightens background further
const scrimColorMap = {
  ink: 'var(--surface-ink)',
  paper: 'var(--surface-paper)',
  acid: 'var(--surface-paper)'
};
const scrimColor = scrimColorMap[surface];
---

<section class="hero" id="hero" data-surface={surface}>
  <!-- BACKGROUND LAYER: Color, image, video, gradient, or monumental -->
  <div class="hero-background" style={background.type === 'video' && background.poster ? { backgroundImage: `url('${background.poster}')` } : {}}>
    {background.type === 'color' && (
      <div class="hero-bg-color" style={{ backgroundColor: colorMap[background.token] }} />
    )}
    {background.type === 'image' && (
      <img src={background.src} alt="" class="hero-bg-image" style={{ objectPosition: background.position || 'center' }} />
    )}
    {background.type === 'video' && (
      <>
        <video preload="auto" poster={background.poster} muted autoplay loop playsinline class="hero-bg-video" style={{ objectPosition: background.position || 'center' }}>
          <source src={background.src} type="video/mp4" />
        </video>
        <img src={background.poster} alt="" class="hero-bg-poster" />
      </>
    )}
    {background.type === 'gradient' && (
      <div class="hero-bg-gradient" style={{ background: `linear-gradient(${background.angle || '135deg'}, ${background.from}, ${background.to})` }} />
    )}
    {scrimOpacity > 0 && (
      <div class="hero-bg-scrim" style={{ backgroundColor: scrimColor, opacity: scrimOpacity.toString() }} />
    )}
  </div>

  <div class="hero-container">
    <!-- LEFT: Heading overlaid on image -->
    <div class="hero-left">
      {eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
      <slot name="heading">
        <h1 class="hero-heading">Framer-quality<br/>interactions,<br/>native to WordPress.</h1>
      </slot>
    </div>
  </div>

  <!-- BOTTOM: Blocks Teaser (74px height) - only renders if teaserText is provided -->
  {teaserText && (
    <div class="block-teaser">
      <div class="block-left">
        {teaserLabel && <p class="block-label">{teaserLabel}</p>}
        <p class="block-description">{teaserText}</p>
      </div>
      {teaserButton && teaserLink && <Button label={teaserButton} href={teaserLink} variant={buttonVariant} />}
    </div>
  )}
</section>

<style>
  /* EXACT PIXEL SPECIFICATIONS - RESPONSIVE VERSION */
  .hero {
    width: 100%;
    max-width: 1791px;
    min-height: 100vh;
    padding: 0;
    margin: 0 auto;
    margin-top: -80px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    overflow: visible;
    position: relative;
    padding-top: 80px;
    --hero-heading-color: var(--text-on-acid);
    --hero-eyebrow-color: var(--text-on-acid);
  }

  .hero[data-surface='ink'] {
    --hero-heading-color: var(--text-on-ink);
    --hero-eyebrow-color: var(--text-on-ink-muted);
  }

  .hero[data-surface='paper'] {
    --hero-heading-color: var(--text-on-paper);
    --hero-eyebrow-color: var(--text-on-paper);
  }

  .hero[data-surface='acid'] {
    --hero-heading-color: var(--text-on-acid);
    --hero-eyebrow-color: var(--text-on-acid);
  }

  /* Background layer - z-index 0 */
  .hero-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    min-height: 100vh;
    background-size: cover;
    background-position: center;
  }

  .hero-bg-color,
  .hero-bg-image,
  .hero-bg-video,
  .hero-bg-gradient,
  .hero-bg-scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-bg-image,
  .hero-bg-video {
    object-fit: cover;
    display: block;
  }

  .hero-bg-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
  }

  .hero-bg-scrim {
    pointer-events: none;
  }

  /* Hero uses layout's universal header via slot */

  .hero-container {
    width: 100%;
    max-width: 1791px;
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 0;
    margin: 0 auto;
    box-sizing: border-box;
    position: relative;
    overflow: visible;
    z-index: 1;
  }

  .hero-left {
    width: 50%;
    padding: 40px 40px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    box-sizing: border-box;
    position: relative;
    z-index: 1;
  }

  .hero-eyebrow {
    font-family: 'Azeret Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 20px 0;
    padding: 0;
    line-height: 1.4;
    color: var(--hero-eyebrow-color);
  }

  /* Heading color uses CSS variable set on .hero, reaches across scope boundaries */
  .hero-heading {
    color: var(--hero-heading-color);
  }



  /* COURSE TEASER CARD - Transparent, shows image behind */
  .block-teaser {
    width: 100%;
    max-width: 1791px;
    padding: 40px 40px;
    background: transparent;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
    margin: 0 auto;
    box-sizing: border-box;
    position: relative;
    z-index: 2;
    flex-shrink: 0;
  }

  .block-left {
    flex: 0 1 auto;
    max-width: 365px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Surface-specific course label color */
  .hero[data-surface='acid'] .block-label {
    color: var(--text-on-acid);
  }

  .hero[data-surface='paper'] .block-label {
    color: var(--text-on-paper);
  }

  .hero[data-surface='ink'] .block-label {
    color: var(--text-on-ink);
  }

  .block-label {
    font-family: 'Azeret Mono', monospace;
    font-size: 14px;
    font-weight: 500;
    line-height: 19.6px;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    display: block;
    width: auto;
    height: auto;
    margin: 0 0 12px 0;
    padding: 0;
    cursor: pointer;
    transition: color 0.3s cubic-bezier(0, 0, 1, 1);
    text-wrap-style: balance;
  }

  /* Surface-specific course description color */
  .hero[data-surface='acid'] .block-description {
    color: var(--text-on-acid);
  }

  .hero[data-surface='paper'] .block-description {
    color: var(--text-on-paper);
  }

  .hero[data-surface='ink'] .block-description {
    color: var(--text-on-ink);
  }

  .block-description {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 400;
    line-height: 22.4px;
    width: 500px;
    margin: 0;
    padding: 0;
    text-wrap-style: balance;
  }


  /* Reduced motion — show poster, hide video */
  @media (prefers-reduced-motion: reduce) {
    .hero-bg-video {
      display: none;
    }

    .hero-bg-poster {
      display: block;
    }
  }

  /* RESPONSIVE OVERRIDES */
  @media (max-width: 1024px) {
    .hero {
      width: 100%;
      height: auto;
    }

    .hero-container {
      width: 100%;
      height: auto;
      flex-direction: column;
    }

    .hero-left, .hero-right {
      width: 100%;
    }

    .block-teaser {
      width: 100%;
      flex-direction: column;
      height: auto;
    }
  }

  @media (max-width: 768px) {
    .hero {
      width: 100%;
    }
  }

  /* Menu dropdown is now in Header component */
</style>

<script>
  const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const videoEl = document.querySelector('.hero-bg-video') as HTMLVideoElement;

  function setVideoPreference(e: MediaQueryListEvent | MediaQueryList) {
    if (!videoEl) return;

    if (e.matches) {
      videoEl.src = '';
      videoEl.pause();
    } else {
      const source = videoEl.querySelector('source');
      if (source) {
        videoEl.src = source.getAttribute('src') || '';
      }
    }
  }

  if (videoEl) {
    mediaQuery.addEventListener('change', setVideoPreference);
    setVideoPreference(mediaQuery);
  }
</script>
