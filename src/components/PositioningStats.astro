---
// Positioning Stats - Two-column Basalio positioning section
// Two-column layout: LEFT (35%, eyebrow) | RIGHT (65%, paragraph + stats)

interface Service {
  value: number | string;
  description: string;
}

interface Props {
  eyebrow?: string;
  introText?: string;
  services?: Service[];
}

const {
  eyebrow = "What we do",
  introText = "We believe in providing solutions that work.",
  services = []
} = Astro.props;
---

<section class="what-we-do" data-surface="paper">
  <!-- LEFT COLUMN: Eyebrow label (35%) -->
  <div class="column-left">
    <p class="eyebrow">{eyebrow}</p>
  </div>

  <!-- RIGHT COLUMN: Paragraph + Stats (65%) -->
  <div class="column-right">
    <!-- Block 1: Intro paragraph (max-width 800px) -->
    <div class="paragraph-block">
      <p class="intro-text">{introText}</p>
    </div>

    <!-- Block 2: Stats list (width 554px, with dividers) -->
    <div class="stats-block">
      <div class="divider"></div>
      {services.map((service) => (
        <>
          <div class="stat-row">
            <span class="stat-value">{service.value}</span>
            <span class="stat-description">{service.description}</span>
          </div>
          <div class="divider"></div>
        </>
      ))}
    </div>
  </div>
</section>

<style>
  /* SECTION: flex row, 40px padding, var(--surface-alt) background */
  .what-we-do {
    display: flex;
    flex-direction: row;
    padding: 40px;
    background-color: var(--surface-alt);
    width: 100%;
    box-sizing: border-box;
  }

  /* LEFT COLUMN: max-width 35%, flex: 1 1 0% */
  .column-left {
    flex: 1 1 0%;
    max-width: 35%;
  }

  /* Eyebrow label */
  .eyebrow {
    font-family: 'Azeret Mono', 'Courier New', monospace;
    font-size: 14px;
    font-weight: var(--font-weight-medium);
    line-height: 19.6px;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: var(--text-on-paper);
    margin: 0;
  }

  /* RIGHT COLUMN: max-width 65%, flex: 1 1 0%, flex column, align-items flex-start, gap 100px */
  .column-right {
    flex: 1 1 0%;
    max-width: 65%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 100px;
  }

  /* Block 1: Paragraph (max-width 800px) */
  .paragraph-block {
    max-width: 800px;
  }

  .intro-text {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: var(--font-weight-normal);
    line-height: 26.4px;
    letter-spacing: -0.22px;
    color: var(--text-on-paper);
    margin: 0;
  }

  /* Block 2: Stats (flex column, gap 20px, responsive width) */
  .stats-block {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    max-width: 554px;
  }

  /* Divider: 1px, light gray to match original template */
  .divider {
    height: 1px;
    width: 100%;
    background-color: var(--surface-alt);
  }

  /* Stat row: flex row, align-items center, width 100% */
  .stat-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
  }

  /* Stat value: left-aligned, bold number */
  .stat-value {
    flex-grow: 0;
    flex-shrink: 0;
    width: auto;
    font-family: 'Azeret Mono', 'Courier New', monospace;
    font-size: 32px;
    font-weight: var(--font-weight-bold);
    line-height: 32px;
    letter-spacing: -1.28px;
    color: var(--text-on-paper);
    margin-right: 16px;
  }

  /* Stat description: right side, body text */
  .stat-description {
    flex-grow: 1;
    flex-shrink: 1;
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-normal);
    line-height: 22.4px;
    letter-spacing: normal;
    color: rgb(87, 87, 87);
  }

  /* RESPONSIVE: Stack layout below 640px */
  @media (max-width: 640px) {
    .what-we-do {
      flex-direction: column;
      gap: 40px;
    }

    .column-left {
      flex: 0 0 auto;
      max-width: 100%;
      width: 100%;
    }

    .column-right {
      flex: 0 0 auto;
      max-width: 100%;
      width: 100%;
    }
  }
</style>
