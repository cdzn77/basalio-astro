---
import { headerNav } from '../data/navigation';

interface Props {}
---

<div class="header-container">
  <a href="/" class="brand-logo">Basalio.</a>
  <div class="menu-wrapper">
    <button id="menu-toggle" class="menu-btn" aria-label="Toggle menu">
      <span>MENU</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="currentColor" class="plus-icon">
        <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2"/>
      </svg>
    </button>

    <!-- Menu Dropdown -->
    <div class="menu-dropdown" id="menu-dropdown">
      {headerNav.map((item) => (
        <a href={item.href} class="menu-item">{item.label}</a>
      ))}
    </div>
  </div>
</div>

<script>
  // Detect if a background color is dark (luminance < 0.5)
  function isColorDark(rgbString) {
    const match = rgbString.match(/\d+/g);
    if (!match || match.length < 3) return false;
    const [r, g, b] = match.slice(0, 3).map(Number);
    // Standard luminance formula
    const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
    return luminance < 0.5;
  }

  // Initialize header state based on first section's background
  const headerContainer = document.querySelector('.header-container');
  const baseMain = document.querySelector('.base-main');

  function updateHeaderState() {
    if (!headerContainer || !baseMain) return;

    // Find the section currently visible under the header
    const sections = baseMain.querySelectorAll('section');
    let shouldInvert = false;

    for (const section of sections) {
      const rect = section.getBoundingClientRect();
      // Check if this section is under the header (top of section < 100px from top)
      if (rect.top < 100 && rect.bottom > 100) {
        const bgColor = window.getComputedStyle(section).backgroundColor;
        shouldInvert = isColorDark(bgColor);
        break;
      }
    }

    if (shouldInvert) {
      headerContainer.classList.add('is-inverted');
    } else {
      headerContainer.classList.remove('is-inverted');
    }
  }

  // Set initial state on page load
  updateHeaderState();

  // Update on scroll with throttling
  let scrollTimeout;
  window.addEventListener('scroll', () => {
    if (scrollTimeout) clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(updateHeaderState, 50);
  }, { passive: true });

  // Menu toggle functionality
  const menuToggle = document.getElementById('menu-toggle');
  const menuDropdown = document.getElementById('menu-dropdown');

  if (menuToggle && menuDropdown) {
    // Toggle menu on button click
    menuToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      menuDropdown.classList.toggle('active');
    });

    // Close menu when clicking on a menu item
    menuDropdown.querySelectorAll('.menu-item').forEach(item => {
      item.addEventListener('click', () => {
        menuDropdown.classList.remove('active');
      });
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      if (!menuToggle.contains(e.target) && !menuDropdown.contains(e.target)) {
        menuDropdown.classList.remove('active');
      }
    });
  }
</script>

<style>
  .header-container {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    box-sizing: border-box;
  }

  .brand-logo {
    background-color: rgba(0, 0, 0, 0);
    box-sizing: border-box;
    color: var(--text-on-paper);
    cursor: pointer;
    display: inline;
    font-family: Manrope, "Manrope Placeholder", sans-serif;
    font-size: 30px;
    font-weight: 600;
    height: auto;
    letter-spacing: -1.5px;
    line-height: 30px;
    padding: 0;
    text-align: start;
    text-decoration: none;
    text-wrap-mode: nowrap;
    transition: color 0.3s cubic-bezier(0, 0, 1, 1);
    width: auto;
    -webkit-font-smoothing: antialiased;
  }

  .brand-logo:hover {
    color: var(--text-on-paper);
  }

  .header-container.is-inverted .brand-logo {
    color: var(--surface-paper);
  }

  .header-container.is-inverted .brand-logo:hover {
    color: var(--surface-paper);
  }

  .menu-btn {
    background: var(--surface-ink);
    color: var(--surface-paper);
    border: none;
    padding: 0px 16px;
    border-radius: 6px;
    font-family: 'Azeret Mono', monospace;
    font-size: 14px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 182px;
    height: 41px;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .menu-btn:hover {
    opacity: 0.8;
  }

  .header-container.is-inverted .menu-btn {
    background: var(--surface-paper);
    color: var(--surface-ink);
  }

  .plus-icon {
    flex-shrink: 0;
  }

  /* MENU DROPDOWN */
  .menu-wrapper {
    position: relative;
  }

  .menu-dropdown {
    position: absolute;
    top: 36px;
    right: 0;
    width: 182px;
    height: auto;
    background: var(--surface-ink);
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    box-shadow: rgba(0, 0, 0, 0.05) 0px 10px 20px 0px;
    display: flex;
    flex-direction: column;
    align-items: center;
    align-content: center;
    justify-content: center;
    padding: 8px 16px;
    box-sizing: border-box;
    row-gap: 1px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease, background-color 0.3s ease;
    z-index: 10;
  }

  .menu-dropdown.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .header-container.is-inverted .menu-dropdown {
    background: var(--surface-paper);
  }

  .menu-item {
    width: 150px;
    height: 40px;
    background: rgba(255, 222, 222, 0);
    border-radius: 15px;
    display: flex;
    flex-direction: row;
    align-items: center;
    align-content: center;
    justify-content: flex-start;
    padding: 10px 0px;
    column-gap: 15px;
    row-gap: 15px;
    font-family: 'Azeret Mono', monospace;
    font-size: 14px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--surface-paper);
    text-decoration: none;
    cursor: pointer;
    box-sizing: border-box;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .menu-item:hover {
    color: var(--acid);
  }

  .header-container.is-inverted .menu-item {
    color: var(--surface-ink);
  }

  .header-container.is-inverted .menu-item:hover {
    color: var(--acid);
  }

  @media (max-width: 768px) {
    .header-container {
      padding: 0 20px;
      height: 60px;
    }

    .brand-logo {
      font-size: 24px;
    }

    .menu-btn {
      width: 160px;
      height: 36px;
      padding: 0px 12px;
      font-size: 12px;
    }

    .menu-dropdown {
      width: 160px;
      height: auto;
    }
  }
</style>
