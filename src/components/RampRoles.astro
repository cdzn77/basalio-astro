---
// Ramp Roles - Based on proven RampTestimonialsV2 structure
// Two-column layout with left heading + right grid of role cards
// Each role card has colored header block with emoji + title

interface Role {
  title: string;
  description: string;
  blocks: string[];
  emoji: string;
  accentColor: string;
}

interface Props {
  sectionHeading?: string;
  bodyText?: string;
  closingLine?: string;
  roles?: Role[];
}

const {
  sectionHeading = "Built for people whose work has to move.",
  bodyText = "Basalio is nine blocks, not ninety. That only works if the nine are the right ones — so they were picked for a specific kind of site: the portfolio, the case study, the reel.",
  roles = [
    {
      title: "Portfolio & Brand Designers",
      description: "Your portfolio is the pitch. It has to feel considered before anyone reads a word of it.",
      blocks: ["Grid Reveal for the work index,", "Case Study Transition between projects,", "Text Reveal for the pacing of a long-form write-up,", "Magnetic Button where the CTA needs to feel like software rather than a link."],
      emoji: "🎨",
      accentColor: "#FF6B9D"
    },
    {
      title: "Videographers & Motion Designers",
      description: "Your work moves. Most WordPress themes don't, and an embedded player is a poor substitute for a site that behaves like your reel.",
      blocks: ["Scroll Sequence turns a frame set into scroll-driven playback.", "Pinned Scroll holds a panel while the story runs past it."],
      emoji: "🎬",
      accentColor: "#00D9FF"
    },
    {
      title: "Photographers",
      description: "Image-led sites need presentation, not chrome.",
      blocks: ["Before/After for retouching and process work.", "Filterable Grid for a body of work with categories.", "Grid Reveal so the set arrives with intent instead of all at once."],
      emoji: "📷",
      accentColor: "#FFB800"
    },
    {
      title: "Studios & Agencies",
      description: "You build client sites and then hand them over. Whatever you install has to still work when you're not there.",
      blocks: ["Nine blocks, theme-agnostic,", "no page builder dependency.", "Content survives uninstall.", "One license covers every site you build."],
      emoji: "🏢",
      accentColor: "#7B61FF"
    }
  ],
  closingLine = "If you need a general-purpose animation engine, this isn't it. Nine blocks, opinionated, built for one kind of site."
} = Astro.props;
---

<section class="roles">
  <div class="roles-inner">
    <!-- LEFT COLUMN: 400px wide heading + description -->
    <div class="roles-left">
      <div class="roles-header">
        <p class="roles-eyebrow">WHO IT'S FOR</p>
        <h2 class="roles-heading">{sectionHeading}</h2>
      </div>
      <p class="roles-body">{bodyText}</p>
      <p class="roles-closing">{closingLine}</p>
    </div>

    <!-- RIGHT COLUMN: 2x2 grid of role cards -->
    <div class="roles-right">
      <div class="roles-grid">
        {roles.map((role) => (
          <div class="role-card">
            <!-- Colored header block with emoji + title -->
            <div class="role-header" style={`background-color: ${role.accentColor}`}>
              <div class="role-emoji">{role.emoji}</div>
              <h3 class="role-title">{role.title}</h3>
            </div>
            <!-- Content section: description + blocks -->
            <div class="role-content">
              <p class="role-description">{role.description}</p>
              <div class="role-blocks">
                {role.blocks.map((block) => (
                  <p class="role-block">{block}</p>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* SECTION SHELL */
  .roles {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 200px 40px;
    gap: 40px;
    background: var(--surface-paper);
    width: 100%;
    box-sizing: border-box;
  }

  /* INNER ROW: two columns */
  .roles-inner {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    max-width: 1786px;
    gap: 60px;
  }

  /* LEFT COLUMN: 400px wide */
  .roles-left {
    flex: 0 0 400px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .roles-header {
    display: flex;
    flex-direction: column;
  }

  .roles-eyebrow {
    font-size: 14px;
    font-weight: 500;
    line-height: 19.6px;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: var(--text-on-paper);
    margin: 0 0 12px 0;
  }

  .roles-heading {
    font-size: 40px;
    font-weight: 400;
    line-height: 48px;
    letter-spacing: -0.8px;
    color: var(--text-on-paper);
    margin: 0;
    white-space: pre-line;
  }

  .roles-body {
    font-size: 15px;
    font-weight: 400;
    line-height: 24px;
    color: var(--text-on-paper-muted);
    margin: 0;
  }

  .roles-closing {
    font-size: 13px;
    font-weight: 400;
    line-height: 20px;
    color: var(--text-on-paper-muted);
    margin: 0;
  }

  /* RIGHT COLUMN: Grid */
  .roles-right {
    flex: 1;
  }

  .roles-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  /* Role card */
  .role-card {
    background: #FFFFFF;
    border: 1px solid #E8E8E8;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 300ms ease, transform 300ms ease;
  }

  .role-card:hover {
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
    transform: translateY(-4px);
  }

  /* Colored header block */
  .role-header {
    padding: 40px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
    text-align: center;
    min-height: 160px;
    justify-content: center;
  }

  .role-emoji {
    font-size: 48px;
    line-height: 1;
  }

  .role-title {
    font-family: Switzer, sans-serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    color: #FFFFFF;
    margin: 0;
  }

  /* Content section */
  .role-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .role-description {
    font-family: Switzer, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    color: #666666;
    margin: 0;
  }

  .role-blocks {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 12px;
    border-top: 1px solid #E8E8E8;
  }

  .role-block {
    font-family: 'Azeret Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5px;
    line-height: 18px;
    color: #666666;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .roles {
      padding: 120px 40px;
    }

    .roles-inner {
      flex-direction: column;
      gap: 40px;
    }

    .roles-left {
      flex: 1;
    }

    .roles-grid {
      grid-template-columns: 1fr;
    }

    .roles-heading {
      font-size: 32px;
      line-height: 40px;
    }
  }

  @media (max-width: 768px) {
    .roles {
      padding: 60px 20px;
    }

    .roles-heading {
      font-size: 28px;
      line-height: 36px;
    }

    .role-header {
      padding: 32px 20px;
      min-height: auto;
    }

    .role-emoji {
      font-size: 40px;
    }
  }
</style>
