---
// Ramp Roles - WHO IT'S FOR section with bold color-blocked layout
// Icon + title in prominent header bar with 20-30% colored block
// Inspired by RampCourses bold color treatment

interface Role {
  title: string;
  description: string;
  blocks: string[];
  emoji: string;
  accentColor: string;
}

interface Props {
  sectionLabel?: string;
  sectionHeading?: string;
  bodyText?: string;
  roles?: Role[];
  closingLine?: string;
}

const {
  sectionLabel = "WHO IT'S FOR",
  sectionHeading = "Built for people whose work has to move.",
  bodyText = "Basalio is nine blocks, not ninety. That only works if the nine are the right ones — so they were picked for a specific kind of site: the portfolio, the case study, the reel.",
  roles = [
    {
      title: "Portfolio & Brand Designers",
      description: "Your portfolio is the pitch. It has to feel considered before anyone reads a word of it.",
      blocks: ["Grid Reveal for the work index,", "Case Study Transition between projects,", "Text Reveal for the pacing of a long-form write-up,", "Magnetic Button where the CTA needs to feel like software rather than a link."],
      emoji: "🎨",
      accentColor: "#FF6B9D"
    },
    {
      title: "Videographers & Motion Designers",
      description: "Your work moves. Most WordPress themes don't, and an embedded player is a poor substitute for a site that behaves like your reel.",
      blocks: ["Scroll Sequence turns a frame set into scroll-driven playback.", "Pinned Scroll holds a panel while the story runs past it."],
      emoji: "🎬",
      accentColor: "#00D9FF"
    },
    {
      title: "Photographers",
      description: "Image-led sites need presentation, not chrome.",
      blocks: ["Before/After for retouching and process work.", "Filterable Grid for a body of work with categories.", "Grid Reveal so the set arrives with intent instead of all at once."],
      emoji: "📷",
      accentColor: "#FFB800"
    },
    {
      title: "Studios & Agencies",
      description: "You build client sites and then hand them over. Whatever you install has to still work when you're not there.",
      blocks: ["Nine blocks, theme-agnostic,", "no page builder dependency.", "Content survives uninstall.", "One license covers every site you build."],
      emoji: "🏢",
      accentColor: "#7B61FF"
    }
  ],
  closingLine = "If you need a general-purpose animation engine, this isn't it. Nine blocks, opinionated, built for one kind of site."
} = Astro.props;
---

<section class="roles" id="roles">
  <div class="roles-inner">
    <!-- LEFT COLUMN: Header + Body Text -->
    <div class="roles-left">
      <div class="roles-header">
        <p class="roles-eyebrow">{sectionLabel}</p>
        <h2 class="roles-heading">{sectionHeading}</h2>
      </div>
      <p class="roles-body">{bodyText}</p>
      <p class="roles-closing">{closingLine}</p>
    </div>

    <!-- RIGHT COLUMN: Role Cards Stack -->
    <div class="roles-right">
      <div class="roles-stack">
        {roles.map((role, index) => (
          <div class="role-card" style={`--accent-color: ${role.accentColor}`}>
            <!-- LEFT: Color-blocked header with icon and title -->
            <div class="role-header-block">
              <div class="role-icon">{role.emoji}</div>
              <h3 class="role-title">{role.title}</h3>
            </div>

            <!-- RIGHT: Content section -->
            <div class="role-content">
              <p class="role-description">{role.description}</p>
              <div class="role-blocks">
                {role.blocks.map((block) => (
                  <p class="role-block">{block}</p>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .roles {
    width: 100%;
    background: #FFFFFF;
    padding: 80px 40px;
    box-sizing: border-box;
  }

  .roles-inner {
    width: 100%;
    max-width: 1786px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: flex-start;
  }

  .roles-left {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .roles-header {
    margin-bottom: 0;
  }

  .roles-eyebrow {
    font-family: 'Azeret Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: #666666;
    margin: 0 0 16px 0;
    padding: 0;
  }

  .roles-heading {
    font-family: Switzer, sans-serif;
    font-size: 40px;
    font-weight: 400;
    line-height: 48px;
    letter-spacing: -0.8px;
    color: #000000;
    margin: 0;
    padding: 0;
  }

  .roles-body {
    font-family: Switzer, sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 24px;
    color: #575757;
    margin: 0;
    padding: 0;
  }

  .roles-closing {
    font-family: Switzer, sans-serif;
    font-size: 13px;
    font-weight: 400;
    line-height: 20px;
    color: #888888;
    margin: 0;
    padding: 0;
  }

  .roles-right {
    width: 100%;
  }

  .roles-stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Role cards: side-by-side layout with color-blocked header (30% width) */
  .role-card {
    display: flex;
    gap: 0;
    border-radius: 8px;
    overflow: hidden;
    background: #FFFFFF;
    border: 1px solid #E8E8E8;
    transition: box-shadow 300ms cubic-bezier(0.215, 0.61, 0.355, 1), transform 300ms cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  .role-card:hover {
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }

  /* Color-blocked header: 30% width with accent background */
  .role-header-block {
    flex: 0 0 30%;
    background: var(--accent-color);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 40px 20px;
    box-sizing: border-box;
    min-height: 240px;
  }

  .role-icon {
    font-size: 56px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .role-title {
    font-family: Switzer, sans-serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    color: #FFFFFF;
    margin: 0;
    padding: 0;
    text-align: center;
  }

  /* Content section: 70% width */
  .role-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 40px;
    box-sizing: border-box;
    justify-content: flex-start;
  }

  .role-description {
    font-family: Switzer, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 21px;
    color: #666666;
    margin: 0;
    padding: 0;
  }

  .role-blocks {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 12px;
    padding-top: 16px;
    border-top: 1px solid #E8E8E8;
  }

  .role-block {
    font-family: 'Azeret Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5px;
    line-height: 18px;
    color: #666666;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 1024px) {
    .roles {
      padding: 60px 20px;
    }

    .roles-inner {
      grid-template-columns: 1fr;
      gap: 60px;
    }

    .roles-heading {
      font-size: 32px;
      line-height: 40px;
    }

    .role-card {
      flex-direction: row;
    }

    .role-header-block {
      flex: 0 0 28%;
      padding: 32px 20px;
      min-height: auto;
    }

    .role-content {
      padding: 32px;
    }
  }

  @media (max-width: 768px) {
    .roles {
      padding: 40px 20px;
    }

    .roles-inner {
      gap: 40px;
    }

    .roles-heading {
      font-size: 28px;
      line-height: 36px;
    }

    .roles-body {
      font-size: 14px;
    }

    .role-card {
      flex-direction: column;
    }

    .role-header-block {
      flex: 0 0 auto;
      padding: 32px 24px;
      min-height: auto;
    }

    .role-title {
      font-size: 15px;
    }

    .role-content {
      padding: 24px;
    }
  }
</style>
