---
// Page-based carousel with hover-zones and visible arrow buttons
// Built from scratch using exact BlocksCarousel pattern
// Two-column layout: LEFT (500px text/button) | RIGHT (carousel 1109px)

import { whoIsThisFor } from '../data/whoitsfor';

interface Testimonial {
  image: string;
  eyebrow?: string;
  title: string;
  description: string;
  features: string[];
  icon?: string;
  quote?: string;
  name?: string;
  results?: string;
}

interface Props {
  testimonials?: Testimonial[];
  sectionHeading?: string;
  bodyText?: string;
  eyebrow?: string;
  closingLine?: string;
}

const {
  eyebrow = "WHO IT'S FOR",
  bodyText = "",
  closingLine = "",
  testimonials = whoIsThisFor,
  sectionHeading = "Built for people who\nactually make things."
} = Astro.props;
---

<section class="testimonials-v2 section-with-footer-overlap" id="testimonials-v2">
  <div class="testimonials-v2-inner">
    <!-- LEFT COLUMN: 500px, eyebrow + heading + pagination -->
    <div class="testimonials-v2-left">
      <div class="testimonials-v2-header">
        <p class="testimonials-v2-eyebrow">{eyebrow}</p>
        <h2 class="testimonials-v2-heading">{sectionHeading}</h2>
      </div>
      {bodyText && <p class="testimonials-v2-body">{bodyText}</p>}
      {closingLine && <p class="testimonials-v2-closing">{closingLine}</p>}

      <!-- PAGINATION CONTROLS: Below the heading on the left side -->
      <div class="pagination-controls-v2">
        <button class="carousel-button-v2 carousel-button-prev-v2" aria-label="Previous testimonial" data-direction="prev">
          <div class="button-icon-wrapper-v2">
            <svg width="100%" height="100%" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <line x1="2.5" y1="12" x2="23.5" y2="12" fill="none" stroke="currentColor" stroke-miterlimit="10" stroke-width="1.5"></line>
              <polyline points="10.14 4.36 2.5 12 10.14 19.64" fill="none" stroke="currentColor" stroke-miterlimit="10" stroke-width="1.5"></polyline>
            </svg>
          </div>
        </button>
        <button class="carousel-button-v2 carousel-button-next-v2" aria-label="Next testimonial" data-direction="next">
          <div class="button-icon-wrapper-v2">
            <svg width="100%" height="100%" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <line x1="21.5" y1="12" x2="0.5" y2="12" fill="none" stroke="currentColor" stroke-miterlimit="10" stroke-width="1.5"></line>
              <polyline points="13.86 4.36 21.5 12 13.86 19.64" fill="none" stroke="currentColor" stroke-miterlimit="10" stroke-width="1.5"></polyline>
            </svg>
          </div>
        </button>
      </div>
    </div>

    <!-- RIGHT COLUMN: Carousel (1109px, or fill remaining) -->
    <div class="testimonials-v2-right" tabindex="0" role="region" aria-label="WHO IT'S FOR carousel">
      <!-- Invisible left hover zone -->
      <div class="carousel-zone-v2 carousel-zone-left-v2" data-direction="prev"></div>

      <!-- Carousel viewport (overflow clip) -->
      <div class="carousel-viewport-v2">
        <!-- Track: position absolute, flex row, gap 20px, overflowing -->
        <div class="carousel-track-v2" aria-live="polite" aria-label="Carousel cards">
          {testimonials.map((testimonial, index) => {
            return (
              <div class="testimonial-card-v2">
                <img src={testimonial.image} alt={testimonial.title} class="testimonial-image-v2" />
                {testimonial.eyebrow && <span class="testimonial-label-v2">{testimonial.eyebrow}</span>}
                <div class="testimonial-title-row-v2">
                  {testimonial.icon && (
                    <div class="testimonial-icon-v2" set:html={testimonial.icon}></div>
                  )}
                  <h3 class="testimonial-name-v2">{testimonial.title}</h3>
                </div>
                {testimonial.description && <p class="testimonial-description-v2">{testimonial.description}</p>}
                {testimonial.features && testimonial.features.length > 0 && (
                  <div class="testimonial-features-v2">
                    {testimonial.features.map((feature) => (
                      <p class="testimonial-feature-v2">{feature}</p>
                    ))}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>

      <!-- Invisible right hover zone -->
      <div class="carousel-zone-v2 carousel-zone-right-v2" data-direction="next"></div>
    </div>
  </div>
</section>

<style>
  /* SECTION SHELL: flex column, center alignment, padding 200px 40px, gap 40px */
  .audience {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
    gap: 40px;
    background: var(--surface-paper);
    width: 100%;
    box-sizing: border-box;
    border-radius: 0 0 40px 40px;
    margin-bottom: -40px;
    padding-bottom: 200px;
    position: relative;
    z-index: 2;
    padding-top: 200px;
  }

  /* INNER ROW: flex row, space-between, align-items flex-start, two columns */
  .audience-inner {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    gap: 20px;
  }

  /* LEFT COLUMN: 500px wide, flex column, match carousel height (700px) */
  .audience-left {
    flex: 0 0 500px;
    display: flex;
    flex-direction: column;
    height: 700px;
  }

  /* Eyebrow + heading block (natural document flow spacing) */
  .audience-header {
    display: flex;
    flex-direction: column;
  }

  .audience-eyebrow {
    font-size: 14px;
    font-weight: var(--font-weight-medium);
    line-height: 19.6px;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: var(--text-on-paper);
    margin: 0 0 12px 0;
  }

  .audience-heading {
    font-size: 40px;
    font-weight: var(--font-weight-normal);
    line-height: 48px;
    letter-spacing: var(--heading-letter-spacing);
    color: var(--text-on-paper);
    margin: 0 0 40px 0;
    white-space: pre-line;
  }

  .audience-body {
    font-size: 15px;
    font-weight: var(--font-weight-normal);
    line-height: 24px;
    color: var(--text-on-paper-muted);
    margin: 0;
    white-space: pre-line;
  }

  .audience-closing {
    font-size: 13px;
    font-weight: var(--font-weight-normal);
    line-height: 20px;
    color: var(--text-on-paper-muted);
    margin: 28px 0 20px 0;
  }

  /* PAGINATION CONTROLS: At bottom of left column with spacing */
  .pagination-controls-v2 {
    display: flex;
    flex-direction: row;
    gap: 12px;
    margin-top: auto;
  }

  /* Icon wrapper for SVG centering */
  .button-icon-wrapper-v2 {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
  }

  /* Visible navigation buttons (white by default, invert on hover) */
  .carousel-button-v2 {
    width: 70px;
    height: 70px;
    border-radius: 8px;
    background: var(--surface-paper);
    color: var(--text-on-paper);
    border: 1px solid var(--surface-alt);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 20;
    transition: all 200ms ease;
    flex: 0 0 70px;
  }

  .carousel-button-v2:disabled {
    pointer-events: none;
    opacity: 0.5;
  }

  .carousel-button-v2:hover:not(:disabled) {
    background: var(--text-on-paper);
    color: var(--surface-paper);
    border-color: var(--text-on-paper);
  }

  .carousel-button-v2:focus-visible {
    outline: 2px solid var(--text-on-paper);
    outline-offset: 2px;
  }

  /* RIGHT COLUMN: Carousel (1109px wide, or fill remaining space) */
  .audience-right {
    flex: 1;
    position: relative;
    overflow: clip;
    min-height: 700px;
  }

  .audience-right:focus-visible {
    outline: 2px solid var(--text-on-paper);
    outline-offset: 2px;
  }

  /* Invisible hover zones (left and right edges) */
  .carousel-zone-v2 {
    position: absolute;
    top: 0;
    height: 100%;
    width: 15%;
    opacity: 0;
    cursor: pointer;
    z-index: 10;
  }

  .carousel-zone-left-v2 {
    left: 0;
  }

  .carousel-zone-right-v2 {
    right: 0;
  }

  .carousel-zone-v2:disabled,
  .carousel-zone-v2[data-disabled] {
    pointer-events: none;
  }

  /* Carousel viewport (overflow clip, position relative for absolute track) */
  .carousel-viewport-v2 {
    position: relative;
    overflow: clip;
    width: 100%;
    max-width: 1020px;
    height: 700px;
  }

  /* Track: position absolute, flex row, gap 20px, width = sum of cards + gaps */
  .carousel-track-v2 {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    flex-direction: row;
    gap: 20px;
    transition: transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track-v2 {
      transition: none;
    }
  }

  /* Testimonial cards: fixed size 500x700px */
  .testimonial-card-v2 {
    flex: 0 0 var(--card-w, 500px);
    height: 700px;
    background: var(--surface-paper);
    border: 1px solid var(--surface-alt);
    border-radius: 6px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-decoration: none;
    color: inherit;
    box-sizing: border-box;
  }

  .testimonial-image-v2 {
    width: 100%;
    height: 300px;
    object-fit: cover;
    object-position: center;
    border-radius: 8px;
    display: block;
  }

  .testimonial-quote-v2 {
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-normal);
    line-height: 22px;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .testimonial-label-v2 {
    font-family: 'Azeret Mono', monospace;
    font-size: 12px;
    font-weight: var(--font-weight-medium);
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
    display: block;
  }

  .testimonial-title-row-v2 {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .testimonial-icon-v2 {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    color: var(--text-on-paper);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .testimonial-icon-v2 svg {
    width: 100%;
    height: 100%;
  }

  .audience-segment {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: var(--font-weight-semibold);
    line-height: 19.6px;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .testimonial-results-v2 {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: var(--font-weight-normal);
    line-height: 18.2px;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
    display: block;
  }

  .testimonial-description-v2 {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: var(--font-weight-normal);
    line-height: 22px;
    color: var(--text-on-paper);
    margin: 0 0 16px 0;
    padding: 0;
  }

  .testimonial-features-v2 {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  .testimonial-feature-v2 {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: var(--font-weight-normal);
    line-height: 18px;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
    white-space: pre-line;
  }

  /* RESPONSIVE: Stack layout below 640px */
  @media (max-width: 640px) {
    .audience {
      padding: 60px 20px;
      padding-top: 200px;
      padding-bottom: 200px;
    }

    .audience-inner {
      flex-direction: column;
      gap: 40px;
    }

    .audience-left {
      flex: 0 0 auto;
      max-width: 100%;
      width: 100%;
      height: auto;
    }

    .audience-right {
      flex: 0 0 auto;
      width: 100%;
      max-width: 100vw;
      min-height: auto;
    }

    /* Mobile carousel: responsive peek-scroll pattern */
    .carousel-viewport-v2 {
      width: 100%;
      max-width: 100%;
      height: auto;
      overflow: clip;
    }

    .carousel-track-v2 {
      position: relative;
      gap: 14px;
    }

    /* Mobile: responsive cards, 24px padding, 140px image */
    .testimonial-card-v2 {
      flex: 0 0 var(--card-w, 280px);
      height: auto;
      padding: 24px;
    }

    .testimonial-image-v2 {
      height: 140px;
    }

    .audience-segment {
      font-size: 14px;
    }

    .testimonial-description-v2 {
      font-size: 14px;
    }

    /* Hide 4th feature on cards 1 and 3 (Portfolio & Directors) to reduce height */
    .carousel-track-v2 > .testimonial-card-v2:nth-child(1) .testimonial-feature-v2:nth-child(4),
    .carousel-track-v2 > .testimonial-card-v2:nth-child(3) .testimonial-feature-v2:nth-child(4) {
      display: none;
    }
  }

  /* WCAG 1.4.10 REFLOW: Below 375px, reduce container and remove peek */
  @media (max-width: 374px) {
    .audience-right {
      width: 280px;
    }

    .carousel-viewport-v2 {
      width: 280px;
      max-width: 280px;
    }
  }
</style>

<script is:inline>
  // PAGE-BASED CAROUSEL NAVIGATION
  // Paging logic: calculate how many cards fit in viewport, advance by one page per action
  // This script targets V2 elements specifically

  const testimonialsV2 = document.querySelector('.audience');
  if (!testimonialsV2) {
    console.error('[TestimonialsV2] .audience section not found');
  } else {
    const track = testimonialsV2.querySelector('.carousel-track-v2');
    const viewport = testimonialsV2.querySelector('.carousel-viewport-v2');
    const cards = testimonialsV2.querySelectorAll('.testimonial-card-v2');
    const prevBtn = testimonialsV2.querySelector('.carousel-button-prev-v2');
    const nextBtn = testimonialsV2.querySelector('.carousel-button-next-v2');
    const leftZone = testimonialsV2.querySelector('.carousel-zone-left-v2');
    const rightZone = testimonialsV2.querySelector('.carousel-zone-right-v2');

    if (track && viewport && cards.length > 0) {
      let currentPage = 0;
      let totalPages = 1;

      // Detect mobile vs desktop and set card dimensions
      const getCardDimensions = () => {
        const isMobile = window.innerWidth <= 640;
        if (isMobile) {
          // Mobile: responsive peek pattern (same as BlocksCarousel)
          // Section has 20px padding each side = 40px total
          // Container width = viewport - 40px
          // Card width = container - 55px peek
          const sectionPadding = 40; // 20px left + 20px right
          const peek = 55;
          const containerWidth = window.innerWidth - sectionPadding;
          const cardWidth = Math.max(280, containerWidth - peek); // Never shrink below 280px
          return { cardWidth: Math.floor(cardWidth), gap: 14 };
        } else {
          // Calculate card width from viewport width at desktop
          const cardsPerRow = 2;
          const gap = 20;
          const calculatedCardWidth = (viewport.offsetWidth - gap * (cardsPerRow - 1)) / cardsPerRow;
          return { cardWidth: Math.floor(calculatedCardWidth), gap: gap };
        }
      };

      // Calculate paging based on viewport width
      const calculatePaging = () => {
        const { cardWidth, gap } = getCardDimensions();
        // Add gap to viewport to account for last card having no trailing gap
        const cardsPerView = Math.max(1, Math.floor((viewport.offsetWidth + gap) / (cardWidth + gap)));
        totalPages = Math.max(1, Math.ceil(cards.length / Math.max(1, cardsPerView)));

        // Set CSS custom property for responsive card width
        viewport.style.setProperty('--card-w', cardWidth + 'px');

        return cardsPerView;
      };

      // Update track position based on current page
      const updateTrackPosition = () => {
        const { cardWidth, gap } = getCardDimensions();
        // Use same formula as calculatePaging: account for missing trailing gap
        const cardsPerView = Math.max(1, Math.floor((viewport.offsetWidth + gap) / (cardWidth + gap)));
        const offset = currentPage * cardsPerView * (cardWidth + gap);
        track.style.transform = `translateX(-${offset}px)`;
        updateButtonStates();
      };

      // Enable/disable buttons based on boundary logic
      const updateButtonStates = () => {
        const isFirstPage = currentPage === 0;
        const isLastPage = currentPage === totalPages - 1;

        prevBtn.disabled = isFirstPage;
        nextBtn.disabled = isLastPage;
        leftZone.style.pointerEvents = isFirstPage ? 'none' : 'auto';
        rightZone.style.pointerEvents = isLastPage ? 'none' : 'auto';

        if (isFirstPage) {
          leftZone.setAttribute('data-disabled', 'true');
        } else {
          leftZone.removeAttribute('data-disabled');
        }

        if (isLastPage) {
          rightZone.setAttribute('data-disabled', 'true');
        } else {
          rightZone.removeAttribute('data-disabled');
        }
      };

      // Navigate to next or previous page
      const navigate = (direction) => {
        if (direction === 'next' && currentPage < totalPages - 1) {
          currentPage++;
          updateTrackPosition();
        } else if (direction === 'prev' && currentPage > 0) {
          currentPage--;
          updateTrackPosition();
        }
      };

      // Initialize paging
      calculatePaging();
      updateButtonStates();

      // Attach click handlers to visible buttons
      prevBtn?.addEventListener('click', () => navigate('prev'));
      nextBtn?.addEventListener('click', () => navigate('next'));

      // Attach mouseenter handlers to invisible hover zones
      leftZone?.addEventListener('mouseenter', () => navigate('prev'));
      rightZone?.addEventListener('mouseenter', () => navigate('next'));

      // Keyboard navigation: Arrow keys
      const carouselContainer = testimonialsV2.querySelector('.audience-right');
      carouselContainer?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          navigate('prev');
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          navigate('next');
        }
      });

      // Recalculate paging on window resize
      window.addEventListener('resize', () => {
        calculatePaging();
        currentPage = Math.min(currentPage, totalPages - 1);
        updateTrackPosition();
      });
    }
  }

  // SCROLL OVERLAP ANIMATION - Section moves up to reveal footer
  const testimonialSection = document.querySelector('.audience');
  if (testimonialSection) {
    const updateScroll = () => {
      const rect = testimonialSection.getBoundingClientRect();
      const sectionBottom = rect.bottom;
      const windowHeight = window.innerHeight;

      // Calculate scroll progress - how far past the viewport bottom
      const distancePastViewport = sectionBottom - windowHeight;

      // Animate when section is exiting bottom of viewport
      if (distancePastViewport < 0) {
        // Clamp between 0 and -40px (moving up)
        const moveAmount = Math.max(-40, distancePastViewport * 0.1);
        testimonialSection.style.transform = `translateY(${moveAmount}px)`;
      } else {
        testimonialSection.style.transform = 'translateY(0)';
      }
    };

    window.addEventListener('scroll', updateScroll, { passive: true });
    updateScroll();
  }

</script>
