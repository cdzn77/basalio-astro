---
// InteractiveHeroDemo — client-side magnetic button or custom cursor demo
// for the hero right column. Respects reduced motion and coarse pointers.
interface Props {
  type: 'magnetic' | 'cursor';
}

const { type } = Astro.props;
---

<div class="interactive-hero" data-interactive-hero={type}>
  {
    type === 'magnetic' ? (
      <button class="magnetic-target" type="button" aria-label="Magnetic button demo">
        <span class="magnetic-label">Explore</span>
      </button>
    ) : (
      <>
        <div class="cursor-target">Move</div>
        <div class="custom-cursor" aria-hidden="true" />
      </>
    )
  }
</div>

<script>
  (function () {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const coarsePointer = window.matchMedia('(pointer: coarse)');

    // Skip motion effects when the user prefers reduced motion or is on a touch device.
    if (reducedMotion.matches || coarsePointer.matches) {
      return;
    }

    const containers = document.querySelectorAll('[data-interactive-hero]');

    containers.forEach((container) => {
      const type = container.getAttribute('data-interactive-hero');

      if (type === 'magnetic') {
        const target = container.querySelector('.magnetic-target');
        if (!target) return;

        const strength = 0.4;

        const handleMove = (event) => {
          const rect = container.getBoundingClientRect();
          const x = event.clientX - rect.left - rect.width / 2;
          const y = event.clientY - rect.top - rect.height / 2;
          target.style.transform = `translate(${x * strength}px, ${y * strength}px)`;
        };

        const handleLeave = () => {
          target.style.transform = '';
        };

        container.addEventListener('mousemove', handleMove);
        container.addEventListener('mouseleave', handleLeave);
      }

      if (type === 'cursor') {
        const cursor = container.querySelector('.custom-cursor');
        if (!cursor) return;

        container.style.cursor = 'none';

        const handleMove = (event) => {
          const rect = container.getBoundingClientRect();
          const x = event.clientX - rect.left;
          const y = event.clientY - rect.top;
          cursor.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
        };

        container.addEventListener('mousemove', handleMove);
      }
    });
  })();
</script>

<style>
  .interactive-hero {
    width: 100%;
    height: 100%;
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-on-ink);
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.03);
  }

  .magnetic-target {
    appearance: none;
    border: none;
    background-color: var(--acid);
    color: var(--text-on-acid);
    border-radius: 999px;
    padding: 0 48px;
    height: 96px;
    font-family: var(--font-mono);
    font-size: var(--font-size-18);
    font-weight: var(--font-weight-medium);
    letter-spacing: 2.8px;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.15s ease-out;
    will-change: transform;
  }

  .magnetic-target:hover {
    opacity: 0.9;
  }

  .cursor-target {
    font-family: var(--font-mono);
    font-size: var(--label-size);
    font-weight: var(--label-weight);
    letter-spacing: var(--label-letter-spacing);
    text-transform: uppercase;
    color: var(--text-on-ink-muted);
    pointer-events: none;
  }

  .custom-cursor {
    position: absolute;
    top: 0;
    left: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 2px solid var(--acid);
    pointer-events: none;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .magnetic-target {
      transition: none;
    }
  }
</style>
