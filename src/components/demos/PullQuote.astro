---
// PullQuote — large quoted statement for editorial breaks
interface Props {
  quote: string;
  attribution?: string;
  surface?: 'paper' | 'alt';
}

const { quote, attribution, surface = 'paper' } = Astro.props;

const bgMap: Record<Props['surface'], string> = {
  paper: 'var(--surface-paper)',
  alt: 'var(--surface-alt)',
};

const colorMap: Record<Props['surface'], string> = {
  paper: 'var(--text-on-paper)',
  alt: 'var(--text-on-paper)',
};

const mutedMap: Record<Props['surface'], string> = {
  paper: 'var(--text-on-paper-muted)',
  alt: 'var(--text-on-paper-muted)',
};
---

<figure class="pull-quote" data-surface={surface}>
  <blockquote>
    <p>{quote}</p>
  </blockquote>
  {attribution && <figcaption>{attribution}</figcaption>}
</figure>

<style define:vars={{ bg: bgMap[surface], color: colorMap[surface], muted: mutedMap[surface] }}>
  .pull-quote {
    width: 100%;
    background-color: var(--bg);
    padding: 120px 40px;
    box-sizing: border-box;
    margin: 0;
  }

  blockquote {
    max-width: var(--container-narrow);
    margin: 0 auto;
    border: none;
    padding: 0;
    font-style: normal;
  }

  blockquote p {
    font-family: var(--font-sans);
    font-size: clamp(32px, 5vw, 64px);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: var(--heading-letter-spacing);
    color: var(--color);
    margin: 0;
    text-wrap: balance;
  }

  figcaption {
    max-width: var(--container-narrow);
    margin: 32px auto 0;
    font-family: var(--font-mono);
    font-size: var(--label-size);
    font-weight: var(--label-weight);
    letter-spacing: var(--label-letter-spacing);
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .pull-quote {
      padding: 80px 20px;
    }
  }
</style>
