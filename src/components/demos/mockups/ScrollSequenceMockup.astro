---
// ScrollSequenceMockup — frame strip scrolls upward in a loop
import BrowserFrame from '../BrowserFrame.astro';
---

<BrowserFrame>
  <div class="scroll-sequence">
    <div class="ss-strip">
      <div class="ss-frame ss-frame-1"></div>
      <div class="ss-frame ss-frame-2"></div>
      <div class="ss-frame ss-frame-3"></div>
      <div class="ss-frame ss-frame-4"></div>
    </div>
  </div>
</BrowserFrame>

<style>
  .scroll-sequence {
    width: 100%;
    height: 260px;
    overflow: hidden;
    border-radius: 8px;
    position: relative;
  }

  .ss-strip {
    display: flex;
    flex-direction: column;
    gap: 12px;
    animation: scrollSequence 4s ease-in-out infinite;
  }

  .ss-frame {
    height: 220px;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .ss-frame-1 { background: linear-gradient(135deg, var(--acid) 0%, var(--surface-paper) 100%); }
  .ss-frame-2 { background: linear-gradient(135deg, var(--surface-paper) 0%, var(--surface-alt) 100%); }
  .ss-frame-3 { background: linear-gradient(135deg, var(--acid) 0%, var(--surface-ink) 100%); }
  .ss-frame-4 { background: linear-gradient(135deg, var(--surface-alt) 0%, var(--acid) 100%); }

  @keyframes scrollSequence {
    0%, 20% { transform: translateY(0); }
    33%, 53% { transform: translateY(-232px); }
    66%, 86% { transform: translateY(-464px); }
    100% { transform: translateY(-696px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-sequence { height: auto; }
    .ss-strip { animation: none; }
    .ss-frame { height: 80px; }
  }
</style>
