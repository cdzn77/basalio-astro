---
import SampleIcons from './SampleIcons.astro';
import './sample-styles.css';
---

<div class="sample-editor-shot" data-sample-editor-shot style="aspect-ratio: 16 / 10.4;">
  {/* ---------- editor chrome ---------- */}
  <div class="sample-editor-chrome">
    <div class="sample-editor-logo">B.</div>

    <div class="sample-editor-chrome-left">
      <span class="sample-editor-chrome-icon"><SampleIcons name="type" size={15} /></span>
      <span class="sample-editor-chrome-icon"><SampleIcons name="image" size={15} /></span>
      <span class="sample-editor-chrome-icon"><SampleIcons name="columns" size={15} /></span>
      <span class="sample-editor-chrome-icon"><SampleIcons name="gallery" size={15} /></span>
      <span class="sample-editor-chrome-icon"><SampleIcons name="sparkle" size={15} /></span>
      <span class="sample-editor-chrome-icon"><SampleIcons name="sliders" size={15} /></span>
    </div>

    <div class="sample-editor-tabs">
      <span class="sample-editor-tab active">Blocks</span>
      <span class="sample-editor-tab sample-editor-tab-hide-sm">Patterns</span>
      <span class="sample-editor-tab sample-editor-tab-hide-sm">Cover</span>
    </div>

    <div class="sample-editor-window-dots">
      <i></i><i></i><i></i>
    </div>

    <div class="sample-editor-chrome-right">
      <span class="sample-editor-chrome-icon"><SampleIcons name="gear" size={14} /></span>
      <span class="sample-editor-chrome-icon"><SampleIcons name="mobile" size={14} /></span>
      <span class="sample-editor-chrome-icon"><SampleIcons name="history" size={14} /></span>
      <span class="sample-editor-chrome-icon"><SampleIcons name="eye" size={14} /></span>
    </div>

    <span class="sample-editor-publish">Publish</span>
    <span class="sample-editor-save">Save</span>
  </div>

  {/* ---------- cover canvas ---------- */}
  <div class="sample-editor-canvas">
    <div class="sample-editor-canvas-bg"></div>

    <div class="sample-editor-slats sample-slats">
      {Array.from({ length: 26 }, (_, i) => <i style={`--i: ${i}`}></i>)}
    </div>

    <div class="sample-editor-radial-glow"></div>
    <div class="sample-editor-bottom-fade"></div>

    {/* cover site chrome */}
    <div class="sample-editor-cover-header">
      <span class="sample-editor-cover-brand">northwind<sup>®</sup></span>
      <nav class="sample-editor-cover-nav">
        <span>IDENTITY</span>
        <span>PACKAGING</span>
        <span>EDITORIAL</span>
        <span class="sample-editor-cover-nav-active">MOTION</span>
      </nav>
    </div>

    {/* cover headline */}
    <div class="sample-editor-cover-headline">
      <p class="sample-editor-mono-label">CASE STUDY, 2026</p>
      <p class="sample-editor-display">Salt &amp; Pine<br />Packaging</p>
    </div>

    {/* left rail */}
    <div class="sample-editor-rail">
      <span class="sample-editor-rail-btn"><SampleIcons name="image" size={15} /></span>
      <span class="sample-editor-rail-btn"><SampleIcons name="columns" size={15} /></span>
      <span class="sample-editor-rail-btn sample-editor-rail-btn-accent"><SampleIcons name="plus" size={15} /></span>
    </div>

    {/* ---------- floating settings panel ---------- */}
    <div class="sample-editor-settings sample-bob">
      <div class="sample-editor-settings-header">
        <span class="sample-editor-settings-title">Section</span>
        <span class="sample-editor-row sample-editor-row-padded">
          Row <SampleIcons name="chevron" size={11} />
        </span>
        <span class="sample-editor-check"><SampleIcons name="check" size={14} /></span>
      </div>

      <p class="sample-editor-settings-label">Spacing</p>
      <div class="sample-editor-spacing-grid">
        <div class="sample-editor-box">
          <span class="sample-editor-box-value">0</span>
          <span class="sample-editor-box-unit">Top</span>
        </div>
        <div class="sample-editor-box">
          <span class="sample-editor-box-value">48</span>
          <span class="sample-editor-box-unit">Right</span>
        </div>
        <div class="sample-editor-box">
          <span class="sample-editor-box-value">0</span>
          <span class="sample-editor-box-unit">Bottom</span>
        </div>
        <div class="sample-editor-box sample-editor-box-hot">
          <span class="sample-editor-box-value px-value">47</span>
          <span class="sample-editor-box-unit sample-editor-box-unit-accent">PX</span>
        </div>
      </div>

      <div class="sample-editor-bg-row">
        <p class="sample-editor-settings-label">Background</p>
        <div class="sample-editor-bg-options">
          <span class="sample-editor-row sample-editor-row-small">Image</span>
          <span class="sample-editor-row sample-editor-row-small">Video</span>
          <span class="sample-editor-bg-swatch"></span>
        </div>
      </div>

      <div class="sample-editor-bg-preview">
        <div class="sample-editor-bg-thumb">
          <div class="sample-editor-bg-thumb-gradient"></div>
          <div class="sample-editor-slats-mini sample-slats">
            {Array.from({ length: 8 }, (_, i) => <i style={`--i: ${i}`}></i>)}
          </div>
        </div>
        <div class="sample-editor-bg-meta">
          <span class="sample-editor-row sample-editor-row-padded">
            No Scale <SampleIcons name="chevron" size={10} />
          </span>
          <span class="sample-editor-row sample-editor-row-padded">
            Middle Center <SampleIcons name="chevron" size={10} />
          </span>
          <span class="sample-editor-row sample-editor-row-padded">
            No Repeat <SampleIcons name="chevron" size={10} />
          </span>
        </div>
      </div>

      <div class="sample-editor-layout-list">
        <span class="sample-editor-row sample-editor-row-wide">
          Grid Reveal <span class="sample-editor-row-plus">+</span>
        </span>
        <span class="sample-editor-row sample-editor-row-wide">
          Scroll Sequence <span class="sample-editor-row-plus">+</span>
        </span>
      </div>

      <div class="sample-editor-settings-footer">
        <SampleIcons name="duplicate" size={15} />
        <SampleIcons name="trash" size={15} />
        <SampleIcons name="plus" size={15} />
      </div>

      <span class="sample-editor-tap-ring"></span>
      <div class="sample-editor-hand" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 48 48" fill="none">
          <path
            d="M16.5 25.2V9.6a3.1 3.1 0 0 1 6.2 0v11.4l1.6-9.9a2.9 2.9 0 0 1 5.7 1l-1 8.4 2.3-6.6a2.8 2.8 0 0 1 5.3 1.6l-2.4 7 2.1-3.5a2.7 2.7 0 0 1 4.9 2.3l-5.6 12.6c-2 4.4-5.6 7.1-10.6 7.1-4.2 0-7-1.7-9.3-5l-5-7.6a2.9 2.9 0 0 1 4.8-3.2l1 1.4z"
            fill="#ffffff"
            stroke="#0a0a0a"
            stroke-width="2.4"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    </div>

    {/* mobile simplified chip */}
    <div class="sample-editor-mobile-chip sample-glass-2">
      <span class="sample-editor-check sample-editor-check-small"><SampleIcons name="check" size={12} /></span>
      <span class="sample-editor-mobile-chip-text">Section · Row</span>
      <span class="sample-editor-box sample-editor-box-hot sample-editor-box-chip">
        <span class="px-value">47</span>px
      </span>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const roots = document.querySelectorAll('[data-sample-editor-shot]');
    if (!roots.length) return;

    const vals = [47, 48, 48, 47, 46, 47];
    let i = 0;

    setInterval(() => {
      i = (i + 1) % vals.length;
      roots.forEach((root) => {
        const target = root.querySelector('.px-value');
        if (target) target.textContent = String(vals[i]);
      });
    }, 1400);
  })();
</script>

<style>
  .sample-editor-shot {
    position: relative;
    overflow: hidden;
    background: var(--surface-ink);
    border-radius: 20px;
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.75);
  }

  /* ---------- chrome ---------- */
  .sample-editor-chrome {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 9%;
    min-height: 42px;
    padding: 0 10px;
    background: #0c0d10;
    border-bottom: 1px solid var(--overlay-light-08);
  }

  .sample-editor-logo {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    flex: none;
    display: grid;
    place-items: center;
    background: var(--acid);
    color: var(--text-on-acid);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: -0.05em;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.25) inset;
  }

  .sample-editor-chrome-left,
  .sample-editor-chrome-right {
    display: none;
    align-items: center;
    gap: 2px;
  }

  .sample-editor-chrome-icon {
    width: 30px;
    height: 30px;
    border-radius: 7px;
    display: grid;
    place-items: center;
    color: var(--text-on-ink);
    opacity: 0.9;
    transition: background 0.2s, opacity 0.2s;
  }

  .sample-editor-chrome-icon:hover {
    background: var(--overlay-light-08);
    opacity: 1;
  }

  .sample-editor-tabs {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1px;
  }

  .sample-editor-tab {
    font-size: 12.5px;
    font-weight: var(--font-weight-medium);
    color: var(--text-on-ink-muted);
    padding: 7px 12px;
    border-radius: 7px;
    transition: color 0.2s, background 0.2s;
  }

  .sample-editor-tab.active {
    color: var(--text-on-ink);
    background: var(--overlay-light-10);
  }

  .sample-editor-tab-hide-sm {
    display: none;
  }

  .sample-editor-window-dots {
    display: none;
    align-items: center;
    gap: 6px;
    margin-right: 8px;
  }

  .sample-editor-window-dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: block;
  }

  .sample-editor-window-dots i:nth-child(1) { background: #ff5f57; }
  .sample-editor-window-dots i:nth-child(2) { background: #febc2e; }
  .sample-editor-window-dots i:nth-child(3) { background: #28c840; }

  .sample-editor-publish {
    display: none;
    font-size: 12.5px;
    font-weight: var(--font-weight-semibold);
    color: var(--text-on-ink);
    padding: 0 8px;
  }

  .sample-editor-save {
    background: var(--acid);
    color: var(--text-on-acid);
    font-weight: var(--font-weight-bold);
    font-size: 12.5px;
    padding: 8px 16px;
    border-radius: 8px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.28) inset,
      0 8px 22px -8px color-mix(in srgb, var(--acid) 70%, transparent);
  }

  @media (min-width: 640px) {
    .sample-editor-chrome-left,
    .sample-editor-window-dots,
    .sample-editor-publish {
      display: flex;
    }
  }

  @media (min-width: 768px) {
    .sample-editor-chrome-right {
      display: flex;
    }

    .sample-editor-tab-hide-sm {
      display: inline-block;
    }
  }

  /* ---------- canvas ---------- */
  .sample-editor-canvas {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    top: 9%;
    overflow: hidden;
  }

  .sample-editor-canvas-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(155deg, color-mix(in srgb, var(--acid) 8%, transparent), transparent 60%),
      linear-gradient(155deg, var(--surface-ink) 0%, #121110 38%, #0a0908 78%, #000 100%);
  }

  .sample-editor-slats {
    opacity: 0.9;
  }

  .sample-editor-radial-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(90% 70% at 30% 20%, rgba(237, 255, 16, 0.16), transparent 60%);
    pointer-events: none;
  }

  .sample-editor-bottom-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 50%;
    background: linear-gradient(180deg, transparent, rgba(4, 4, 4, 0.72));
    pointer-events: none;
  }

  /* ---------- cover content ---------- */
  .sample-editor-cover-header {
    position: absolute;
    top: 7%;
    left: 5%;
    right: 5%;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .sample-editor-cover-brand {
    color: var(--text-on-ink);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
    font-size: clamp(13px, 1.9vw, 24px);
  }

  .sample-editor-cover-brand sup {
    font-weight: var(--font-weight-normal);
    font-size: 0.55em;
    vertical-align: super;
  }

  .sample-editor-cover-nav {
    display: none;
    gap: clamp(8px, 2.2vw, 32px);
    color: var(--text-on-ink-muted);
    font-weight: var(--font-weight-medium);
    font-size: clamp(7px, 0.85vw, 11px);
    letter-spacing: 0.18em;
  }

  .sample-editor-cover-nav-active {
    color: var(--text-on-ink);
  }

  @media (min-width: 640px) {
    .sample-editor-cover-nav {
      display: flex;
    }
  }

  .sample-editor-cover-headline {
    position: absolute;
    left: 5%;
    bottom: 7%;
  }

  .sample-editor-mono-label {
    font-family: var(--font-mono);
    font-size: clamp(6px, 0.8vw, 10px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-ink-muted);
    margin: 0 0 0.6em;
  }

  .sample-editor-display {
    margin: 0;
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: var(--text-on-ink);
    font-size: clamp(20px, 4.6vw, 58px);
  }

  /* ---------- left rail ---------- */
  .sample-editor-rail {
    position: absolute;
    left: 2.2%;
    top: 30%;
    display: none;
    flex-direction: column;
    gap: 8px;
    z-index: 10;
  }

  @media (min-width: 640px) {
    .sample-editor-rail {
      display: flex;
    }
  }

  .sample-editor-rail-btn {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    background: rgba(16, 18, 22, 0.9);
    border: 1px solid var(--overlay-light-10);
    color: rgba(255, 255, 255, 0.85);
  }

  .sample-editor-rail-btn-accent {
    border-color: var(--acid);
    color: var(--acid);
    box-shadow: 0 0 18px -4px color-mix(in srgb, var(--acid) 80%, transparent);
  }

  /* ---------- settings panel ---------- */
  .sample-editor-settings {
    position: absolute;
    z-index: 20;
    right: 3%;
    top: 6%;
    width: 240px;
    padding: 14px;
    display: none;
    background: color-mix(in srgb, var(--surface-ink) 92%, transparent);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    border: 1px solid var(--overlay-light-10);
    border-radius: 14px;
    box-shadow:
      0 30px 70px -25px rgba(0, 0, 0, 0.9),
      0 1px 0 rgba(255, 255, 255, 0.06) inset;
  }

  @media (min-width: 640px) {
    .sample-editor-settings {
      display: block;
    }
  }

  @media (min-width: 1024px) {
    .sample-editor-settings {
      width: 272px;
    }
  }

  .sample-editor-settings-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--overlay-light-08);
  }

  .sample-editor-settings-title {
    font-size: 12px;
    font-weight: var(--font-weight-semibold);
    color: var(--text-on-ink);
    padding: 0 4px;
  }

  .sample-editor-settings-label {
    font-size: 11px;
    font-weight: var(--font-weight-medium);
    color: var(--text-on-ink-muted);
    margin: 12px 0 8px;
  }

  .sample-editor-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #0c0e12;
    border: 1px solid var(--overlay-light-08);
    border-radius: 8px;
    color: var(--text-on-ink-muted);
    font-size: 11px;
  }

  .sample-editor-row-padded {
    padding: 6px 10px;
  }

  .sample-editor-row-small {
    padding: 4px 8px;
    color: rgba(255, 255, 255, 0.8);
  }

  .sample-editor-row-wide {
    width: 100%;
    padding: 8px 10px;
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.7);
  }

  .sample-editor-row-plus {
    color: rgba(255, 255, 255, 0.4);
    font-size: 13px;
  }

  .sample-editor-check {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    flex: none;
    display: grid;
    place-items: center;
    background: var(--acid);
    color: var(--text-on-acid);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.3) inset;
  }

  .sample-editor-check-small {
    width: 24px;
    height: 24px;
  }

  .sample-editor-spacing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }

  .sample-editor-box {
    background: #0c0e12;
    border: 1px solid var(--overlay-light-08);
    border-radius: 9px;
    color: var(--text-on-ink);
    text-align: center;
    padding: 6px 0;
  }

  .sample-editor-box-hot {
    border-color: var(--acid);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--acid) 25%, transparent);
  }

  .sample-editor-box-value {
    display: block;
    font-size: 13px;
    font-weight: var(--font-weight-semibold);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .sample-editor-box-unit {
    display: block;
    font-size: 8px;
    color: var(--text-on-ink-muted);
    margin-top: 4px;
  }

  .sample-editor-box-unit-accent {
    color: var(--acid);
  }

  .sample-editor-bg-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
  }

  .sample-editor-bg-options {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .sample-editor-bg-swatch {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    border: 1px solid var(--overlay-light-15);
    background: linear-gradient(140deg, #2a2724, #0d0c0b);
  }

  .sample-editor-bg-preview {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }

  .sample-editor-bg-thumb {
    width: 64px;
    height: 48px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--overlay-light-10);
    position: relative;
    flex: none;
  }

  .sample-editor-bg-thumb-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(155deg, var(--surface-ink), #0a0908);
  }

  .sample-editor-slats-mini {
    opacity: 0.8;
  }

  .sample-editor-bg-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sample-editor-layout-list {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sample-editor-settings-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--overlay-light-08);
    color: rgba(255, 255, 255, 0.6);
  }

  /* ---------- tap ring + hand ---------- */
  .sample-editor-tap-ring {
    position: absolute;
    right: 14px;
    top: 86px;
    width: 34px;
    height: 34px;
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    animation: sample-editor-tap-ring 4.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .sample-editor-hand {
    position: absolute;
    right: -6px;
    top: 96px;
    pointer-events: none;
    z-index: 30;
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.55));
    will-change: transform;
    animation: sample-editor-hand-tap 4.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  @keyframes sample-editor-hand-tap {
    0%, 84%, 100% { transform: translate(0, 0) rotate(-8deg); }
    88% { transform: translate(-3px, 4px) rotate(-8deg) scale(0.9); }
    93% { transform: translate(0, 0) rotate(-8deg) scale(1.04); }
  }

  @keyframes sample-editor-tap-ring {
    0%, 85% { opacity: 0; transform: scale(0.4); }
    89% { opacity: 0.9; transform: scale(0.55); }
    98%, 100% { opacity: 0; transform: scale(1.5); }
  }

  /* ---------- mobile chip ---------- */
  .sample-editor-mobile-chip {
    position: absolute;
    right: 4%;
    top: 10%;
    z-index: 20;
    border-radius: 12px;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @media (min-width: 640px) {
    .sample-editor-mobile-chip {
      display: none;
    }
  }

  .sample-editor-mobile-chip-text {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.8);
    font-weight: var(--font-weight-medium);
  }

  .sample-editor-box-chip {
    padding: 4px 8px;
    font-size: 12px;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- reduced motion ---------- */
  @media (prefers-reduced-motion: reduce) {
    .sample-editor-hand,
    .sample-editor-tap-ring {
      animation: none !important;
    }
  }
</style>
