---
interface Props {
  label: string;
  showReplay?: boolean;
}

const { label, showReplay = false } = Astro.props;
---

<div class="sample-stage sample-stage-grid-lines" data-sample-stage data-stage-label={label}>
  <span class="sample-stage-label">{label}</span>
  {showReplay && <button class="sample-stage-replay" data-sample-replay-trigger type="button">↺ Replay</button>}
  <slot />
</div>

<script is:inline>
  document.querySelectorAll('[data-sample-stage]').forEach(stage => {
    const btn = stage.querySelector('[data-sample-replay-trigger]');
    if (!btn || btn.dataset.sampleReplayWired === 'true') return;
    btn.dataset.sampleReplayWired = 'true';
    btn.addEventListener('click', () => {
      stage.dispatchEvent(new CustomEvent('basalio:replay', { bubbles: true }));
    });
  });
</script>

<style>
  .sample-stage-label {
    position: absolute;
    top: 12px;
    left: 14px;
    z-index: 20;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-ink-muted);
  }

  .sample-stage-replay {
    position: absolute;
    top: 10px;
    right: 12px;
    z-index: 20;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.05em;
    line-height: 1;
    color: var(--text-on-ink-muted);
    background: var(--overlay-light-05);
    border: 1px solid var(--overlay-light-15);
    border-radius: 6px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .sample-stage-replay:hover {
    color: var(--text-on-ink);
    background: var(--overlay-light-08);
    border-color: var(--overlay-light-30);
  }

  .sample-stage-replay:focus-visible {
    outline: 2px solid var(--acid);
    outline-offset: 2px;
  }
</style>
