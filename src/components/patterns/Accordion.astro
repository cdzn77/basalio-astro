---
// Accordion: Accessible disclosure widget with WCAG compliance
// - aria-expanded and aria-controls for screen readers
// - ≥24x24px hit targets (WCAG 2.5.8)
// - Visible focus ring ≥3:1 contrast
// - prefers-reduced-motion support
// - Can be used standalone or with eyebrow/title wrapper

interface AccordionItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  items: AccordionItem[];
  surface?: 'paper' | 'ink' | 'alt';
}

const { eyebrow, title, items, surface = 'paper' } = Astro.props;

const surfaceVars = {
  paper: {
    bg: 'var(--surface-paper)',
    text: 'var(--text-on-paper)',
    textMuted: 'var(--text-on-paper-muted)',
    border: 'rgba(0, 0, 0, 0.08)',
  },
  ink: {
    bg: 'var(--surface-ink)',
    text: 'var(--text-on-ink)',
    textMuted: 'var(--text-on-ink-muted)',
    border: 'rgba(255, 255, 255, 0.1)',
  },
  alt: {
    bg: 'var(--surface-alt)',
    text: 'var(--text-on-paper)',
    textMuted: 'var(--text-on-paper-muted)',
    border: 'rgba(0, 0, 0, 0.08)',
  },
}[surface];

const accentColor = surface === 'ink' ? 'var(--text-on-ink)' : 'var(--acid)';
const itemId = (index: number) => `accordion-item-${index}`;
const buttonId = (index: number) => `accordion-button-${index}`;
---

<section class="accordion" style={`--surface-bg: ${surfaceVars.bg}; --surface-text: ${surfaceVars.text}; --surface-text-muted: ${surfaceVars.textMuted}; --surface-border: ${surfaceVars.border}; --accent-color: ${accentColor};`}>
  {(eyebrow || title) && (
    <div class="accordion-header">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      {title && <h2 class="title">{title}</h2>}
    </div>
  )}

  <div class="accordion-list">
    {items.map((item, index) => (
      <div class="accordion-item" id={itemId(index)}>
        <button
          id={buttonId(index)}
          aria-expanded="false"
          aria-controls={`${itemId(index)}-panel`}
          class="accordion-button"
        >
          <span class="accordion-question">{item.question}</span>
          <span class="accordion-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
              <path fill-rule="evenodd" d="M 8 2 A 0.5 0.5 0 0 1 8.5 2.5 V 7.5 H 13.5 A 0.5 0.5 0 0 1 13.5 8.5 H 8.5 V 13.5 A 0.5 0.5 0 0 1 7.5 13.5 V 8.5 H 2.5 A 0.5 0.5 0 0 1 2.5 7.5 H 7.5 V 2.5 A 0.5 0.5 0 0 1 8 2"/>
            </svg>
          </span>
        </button>
        <div id={`${itemId(index)}-panel`} role="region" aria-labelledby={buttonId(index)} class="accordion-panel" hidden>
          <p class="accordion-answer">{item.answer}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style define:vars={{
  surfaceBg: surfaceVars.bg,
  surfaceText: surfaceVars.text,
  surfaceTextMuted: surfaceVars.textMuted,
  surfaceBorder: surfaceVars.border,
  accentColor: accentColor
}}>
  .accordion {
    width: 100%;
    padding: 60px 40px;
    box-sizing: border-box;
    background: var(--surface-bg);
  }

  .accordion-header {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 40px;
  }

  .eyebrow {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: var(--surface-text);
    margin: 0;
    padding: 0;
    line-height: 1.6;
  }

  .title {
    font-size: 40px;
    font-weight: 400;
    line-height: 48px;
    letter-spacing: var(--heading-letter-spacing);
    color: var(--surface-text);
    margin: 0;
    padding: 0;
    max-width: 60%;
  }

  .accordion-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 800px;
  }

  .accordion-item {
    width: 100%;
  }

  .accordion-button {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px;
    background: transparent;
    border: 1px solid var(--surface-border);
    border-radius: 6px;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.2s ease, background-color 0.2s ease;
    font-family: inherit;
  }

  .accordion-button:hover {
    border-color: var(--accent-color);
  }

  .accordion-button:focus-visible {
    outline: 3px solid var(--accent-color);
    outline-offset: 2px;
  }

  .accordion-question {
    font-size: 18px;
    font-weight: 500;
    line-height: 25.2px;
    letter-spacing: -0.36px;
    color: var(--surface-text);
    flex-grow: 1;
    margin: 0;
  }

  .accordion-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    color: var(--surface-text-muted);
    transition: transform 0.3s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  .accordion-icon svg {
    width: 20px;
    height: 20px;
  }

  .accordion-button[aria-expanded="true"] .accordion-icon {
    transform: rotate(45deg);
    color: var(--accent-color);
  }

  .accordion-panel {
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .accordion-panel[hidden] {
    display: none;
  }

  .accordion-answer {
    font-size: var(--font-size-body);
    font-weight: 400;
    line-height: 24px;
    color: var(--surface-text-muted);
    margin: 0;
    padding: 20px 20px 20px 20px;
    background: transparent;
    border-top: 1px solid var(--surface-border);
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion-icon {
      transition: none;
    }

    .accordion-button {
      transition: none;
    }
  }

  @media (max-width: 1024px) {
    .accordion {
      padding: 40px 30px;
    }

    .title {
      font-size: 32px;
      line-height: 40px;
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .accordion {
      padding: 30px 20px;
    }

    .accordion-header {
      margin-bottom: 30px;
    }

    .eyebrow {
      font-size: 12px;
      letter-spacing: 2.4px;
    }

    .title {
      font-size: 24px;
      line-height: 32px;
    }

    .accordion-button {
      padding: 16px;
    }

    .accordion-question {
      font-size: var(--font-size-body);
      line-height: 22px;
    }

    .accordion-answer {
      padding: 16px;
      font-size: 15px;
    }
  }
</style>

<script>
  document.querySelectorAll('.accordion-button').forEach((button) => {
    button.addEventListener('click', () => {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      const panelId = button.getAttribute('aria-controls');
      const panel = document.getElementById(panelId);

      if (isExpanded) {
        button.setAttribute('aria-expanded', 'false');
        panel.hidden = true;
      } else {
        button.setAttribute('aria-expanded', 'true');
        panel.hidden = false;
      }
    });

    // Keyboard support: Space and Enter
    button.addEventListener('keydown', (e) => {
      if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        button.click();
      }
    });
  });
</script>
