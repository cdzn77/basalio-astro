---
// HeaderSplit: 35-65 flex header section with eyebrow, heading, body left, slot right
// Always light surface for header legibility
// Constrained spacing to prevent drift

import Button from '../Button.astro';

interface Props {
  eyebrow: string;
  heading: string;
  body: string | string[];
  level?: 'h1' | 'h2';
  cta?: {
    label: string;
    href: string;
    variant?: 'acid' | 'ink';
  };
  surface?: 'paper' | 'ink' | 'alt';
}

const { eyebrow, heading, body, level = 'h2', cta, surface = 'paper' } = Astro.props;
const Tag = level;

const surfaceClass = {
  paper: 'var(--surface-paper)',
  ink: 'var(--surface-ink)',
  alt: 'var(--surface-alt)',
}[surface] || 'var(--surface-paper)';

const bodyArray = Array.isArray(body) ? body : [body];
---

<section class="header-split" data-surface={surface} style={`background: ${surfaceClass};`}>
  <div class="header-split-inner">
    <!-- LEFT: Eyebrow, heading, body -->
    <div class="header-split-left">
      <p class="eyebrow">{eyebrow}</p>
      <Tag class="heading">{heading}</Tag>
      <div class="body">
        {bodyArray.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      {cta && (
        <Button
          label={cta.label}
          href={cta.href}
          variant={cta.variant || 'acid'}
          fontSize="14px"
          fontWeight="600"
          letterSpacing="0.2em"
        />
      )}
    </div>

    <!-- RIGHT: Slot for right-column content -->
    <div class="header-split-right">
      <slot />
    </div>
  </div>
</section>

<style define:vars={{ surfaceClass }}>
  .header-split {
    width: 100%;
    padding-top: 250px;
    padding-bottom: 40px;
  }

  .header-split-inner {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    gap: 60px;
    padding: 0 40px;
    box-sizing: border-box;
  }

  .header-split-left {
    flex: 0 1 28%;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .eyebrow {
    font-size: 14px;
    font-weight: var(--font-weight-medium);
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
    line-height: 1.6;
  }

  .heading {
    font-size: 40px;
    font-weight: var(--font-weight-normal);
    line-height: 48px;
    letter-spacing: var(--heading-letter-spacing);
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .body p {
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-normal);
    line-height: 24px;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
  }

  .header-split[data-surface="ink"] .eyebrow,
  .header-split[data-surface="ink"] .heading,
  .header-split[data-surface="ink"] .body p,
  .header-split[data-surface="ink"] .hero-right-heading,
  .header-split[data-surface="ink"] .hero-right-subheading,
  .header-split[data-surface="ink"] .hacks-hero-lead,
  .header-split[data-surface="ink"] .hacks-hero-body,
  .header-split[data-surface="ink"] .terms-scope-content .scope-label,
  .header-split[data-surface="ink"] .terms-scope-content .scope-statement,
  .header-split[data-surface="ink"] .privacy-scope-content .scope-label,
  .header-split[data-surface="ink"] .privacy-scope-content .scope-statement {
    color: var(--text-on-ink);
  }

  .header-split[data-surface="ink"] .body p,
  .header-split[data-surface="ink"] .hero-right-subheading,
  .header-split[data-surface="ink"] .hacks-hero-body {
    color: var(--text-on-ink-muted);
  }

  .header-split-right {
    flex: 1;
    width: 100%;
  }

  @media (max-width: 1024px) {
    .header-split {
      padding-top: 180px;
      padding-bottom: 30px;
    }

    .header-split-inner {
      flex-direction: column;
      gap: 40px;
      padding: 0 30px;
    }

    .header-split-left {
      flex: 1 1 100%;
    }

    .header-split-right {
      flex: 1 1 100%;
    }

    .heading {
      font-size: 32px;
      line-height: 40px;
    }
  }

  @media (max-width: 640px) {
    .header-split {
      padding-top: 120px;
      padding-bottom: 20px;
    }

    .header-split-inner {
      padding: 0 20px;
      gap: 30px;
    }

    .eyebrow {
      font-size: 12px;
      letter-spacing: 2.4px;
    }

    .heading {
      font-size: 24px;
      line-height: 32px;
    }

    .body p {
      font-size: 14px;
      line-height: 20px;
    }
  }

  /* WCAG 1.4.10 REFLOW: Below 375px, constrain header-split-left to container */
  @media (max-width: 374px) {
    .header-split-inner {
      padding: 0 20px;
    }

    .header-split-left {
      flex-basis: 100%;
      max-width: 100%;
    }
  }
</style>
