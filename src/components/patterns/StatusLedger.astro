---
// StatusLedger: Static table for displaying status items with badges
// Status badges include both text and color per WCAG 1.4.1 (color not sole means of conveyance)

interface StatusItem {
  label: string;
  status: 'LIVE' | 'IN PROGRESS' | 'PLANNED' | 'IN TESTING' | 'NOT STARTED' | 'ONGOING';
  note: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  items: StatusItem[];
  surface?: 'paper' | 'ink' | 'alt';
}

const { eyebrow, title, description, items, surface = 'paper' } = Astro.props;

const surfaceVars = {
  paper: {
    bg: 'var(--surface-paper)',
    text: 'var(--text-on-paper)',
    textMuted: 'var(--text-on-paper-muted)',
    border: 'rgba(0, 0, 0, 0.08)',
  },
  ink: {
    bg: 'var(--surface-ink)',
    text: 'var(--text-on-ink)',
    textMuted: 'var(--text-on-ink-muted)',
    border: 'rgba(255, 255, 255, 0.1)',
  },
  alt: {
    bg: 'var(--surface-alt)',
    text: 'var(--text-on-paper)',
    textMuted: 'var(--text-on-paper-muted)',
    border: 'rgba(0, 0, 0, 0.08)',
  },
}[surface];

const statusStyles = {
  'LIVE': { bg: 'var(--acid)', text: 'var(--text-on-acid)' },
  'IN PROGRESS': { bg: 'transparent', text: 'var(--text-on-paper)', border: '1px solid var(--text-on-paper-muted)' },
  'PLANNED': { bg: 'var(--stone)', text: 'var(--text-on-paper)' },
  'IN TESTING': { bg: 'transparent', text: 'var(--text-on-paper)', border: '1px solid var(--text-on-paper-muted)' },
  'NOT STARTED': { bg: 'transparent', text: 'var(--text-on-paper)', border: '1px solid var(--text-on-paper-muted)' },
  'ONGOING': { bg: 'transparent', text: 'var(--text-on-paper)', border: '1px solid var(--text-on-paper-muted)' },
};
---

<section class="ledger" style={`--ledger-bg: ${surfaceVars.bg}; --ledger-text: ${surfaceVars.text}; --ledger-text-muted: ${surfaceVars.textMuted}; --ledger-border: ${surfaceVars.border};`}>
  <div class="ledger-header">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="title">{title}</h2>
    <p class="description">{description}</p>
  </div>

  <div class="ledger-table">
    {items.map((item) => (
      <div class="ledger-row">
        <div class="ledger-label">{item.label}</div>
        <div class="ledger-status-cell">
          <span
            class="ledger-badge"
            style={`background-color: ${statusStyles[item.status].bg}; color: ${statusStyles[item.status].text}; border: ${statusStyles[item.status].border || 'none'};`}
          >
            {item.status}
          </span>
        </div>
        <div class="ledger-note">{item.note}</div>
      </div>
    ))}
  </div>
</section>

<style define:vars={{
  ledgerBg: surfaceVars.bg,
  ledgerText: surfaceVars.text,
  ledgerTextMuted: surfaceVars.textMuted,
  ledgerBorder: surfaceVars.border,
}}>
  .ledger {
    width: 100%;
    padding: 60px 40px;
    box-sizing: border-box;
    background: var(--ledger-bg);
  }

  .ledger-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 40px;
    max-width: 800px;
  }

  .eyebrow {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: var(--ledger-text);
    margin: 0;
    padding: 0;
    line-height: 1.6;
  }

  .title {
    font-size: 40px;
    font-weight: 400;
    line-height: 48px;
    letter-spacing: -0.8px;
    color: var(--ledger-text);
    margin: 0;
    padding: 0;
  }

  .description {
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: var(--ledger-text-muted);
    margin: 0;
    padding: 0;
  }

  .ledger-table {
    display: flex;
    flex-direction: column;
    gap: 1px;
    border: 1px solid var(--ledger-border);
    border-radius: 8px;
    overflow: hidden;
  }

  .ledger-row {
    display: grid;
    grid-template-columns: 1fr 140px 2fr;
    gap: 20px;
    padding: 20px;
    align-items: center;
    border-bottom: 1px solid var(--ledger-border);
    background: var(--ledger-bg);
  }

  .ledger-row:last-child {
    border-bottom: none;
  }

  .ledger-label {
    font-size: 15px;
    font-weight: 500;
    line-height: 22px;
    color: var(--ledger-text);
    margin: 0;
  }

  .ledger-status-cell {
    display: flex;
    justify-content: center;
  }

  .ledger-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 1;
  }

  .ledger-note {
    font-size: 15px;
    font-weight: 400;
    line-height: 22px;
    color: var(--ledger-text-muted);
    margin: 0;
  }

  @media (max-width: 1024px) {
    .ledger {
      padding: 40px 30px;
    }

    .title {
      font-size: 32px;
      line-height: 40px;
    }

    .ledger-row {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .ledger-status-cell {
      justify-content: flex-start;
    }
  }

  @media (max-width: 640px) {
    .ledger {
      padding: 30px 20px;
    }

    .ledger-header {
      margin-bottom: 30px;
    }

    .eyebrow {
      font-size: 12px;
      letter-spacing: 2.4px;
    }

    .title {
      font-size: 24px;
      line-height: 32px;
    }

    .ledger-row {
      padding: 16px;
    }

    .ledger-label {
      font-size: 14px;
    }

    .ledger-note {
      font-size: 14px;
    }

    .ledger-badge {
      font-size: 11px;
      padding: 5px 10px;
    }
  }
</style>
