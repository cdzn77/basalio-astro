---
/* BaseLayout – Shared HTML shell for all pages
   - Wraps page content
   - Manages head meta, fonts, global styles
   - Provides header and footer slots
   - Props: title, description, headerType (for future variants)
*/

import '../styles/global.css';
import '../styles/tokens.css';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title?: string;
  description?: string;
  headerType?: 'split' | 'simple';
  noindex?: boolean;
}

const {
  title = 'Basalio',
  description = 'Basalio - WordPress Portfolio Blocks',
  headerType = 'split',
  noindex = false
} = Astro.props;

const siteOrigin = 'https://basalio.com';
const canonical = new URL(Astro.url.pathname, Astro.site || siteOrigin);
const pageTitle = title && title !== 'Basalio' && !title.includes('Basalio')
  ? `${title} | Basalio`
  : title;
const ogImage = new URL('/assets/basalio-hero-poster.webp', Astro.site || siteOrigin);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical.href} />

  <!-- Open Graph / Twitter -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical.href} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Basalio" />
  <meta property="og:image" content={ogImage.href} />
  <meta property="og:image:alt" content="Basalio - WordPress Portfolio Blocks" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage.href} />

  <!-- Fonts -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/instrument-sans-var.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/azeret-mono-var.woff2" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Azeret+Mono:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cpolygon points='8,56 56,56 46,44 18,44' fill='%23F6F4EF'/%3E%3Crect x='23' y='20' width='18' height='24' fill='%23EDFF10'/%3E%3C/svg%3E" />
  
  <slot name="head" />
</head>

<body>
  <header class="base-header" id="base-header">
    <slot name="header" />
  </header>

  <main class="base-main" tabindex="-1">
    <slot />
  </main>

  <footer class="base-footer">
    <slot name="footer" />
  </footer>

  <BackToTop />

  <script>
    const header = document.getElementById('base-header');

    function handleScroll() {
      if (window.scrollY > 100) {
        header?.classList.add('scrolled');
      } else {
        header?.classList.remove('scrolled');
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
  </script>
</body>
</html>

<style>
  /* Global layout */
  :global(body) {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding-top: 80px;
  }

  .base-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 20px 40px;
    width: 100%;
    box-sizing: border-box;
    height: 80px;
    display: flex;
    align-items: center;
    background: transparent;
    transition: background-color 0.3s ease, backdrop-filter 0.3s ease;
  }

  .base-header.scrolled {
    background: rgba(255, 255, 255, 0.08);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    backdrop-filter: blur(12px) saturate(160%);
  }

  .base-main {
    flex: 1;
    position: relative;
    z-index: 10;
  }

  .base-footer {
    position: relative;
    z-index: 1;
  }
</style>
