---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="404 — this page does not exist">
  <main style="display: flex; flex-direction: column; justify-content: center; align-items: center; min-height: 70vh; padding: 80px 40px; text-align: center;">
    <h1 style="font-size: clamp(48px, 8vw, 96px); font-weight: 700; margin: 0 0 20px 0; color: var(--text-on-paper);">
      404
    </h1>
    <p style="font-size: 18px; color: var(--text-on-paper-muted); margin: 0 0 40px 0; max-width: 500px;">
      This page does not exist. Let's get you back on track.
    </p>
    <a href="/" style="display: inline-block; padding: 12px 24px; background-color: var(--acid); color: var(--text-on-acid); text-decoration: none; border-radius: 4px; font-weight: 600; font-size: 14px; text-transform: uppercase; letter-spacing: 0.1em;">
      Back home
    </a>
  </main>
</BaseLayout>
