---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="404 — this page does not exist">
  <section class="not-found-container" data-surface="paper">
    <h1 class="not-found-heading">404</h1>
    <p class="not-found-text">
      This page does not exist. Let's get you back on track.
    </p>
    <a href="/" class="not-found-cta">
      Back home
    </a>
  </section>
</BaseLayout>

<style scoped>
  .not-found-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 70vh;
    padding: 80px 40px;
    text-align: center;
  }

  .not-found-heading {
    font-size: clamp(48px, 8vw, 96px);
    font-weight: 700;
    margin: 0 0 20px 0;
    color: var(--text-on-paper);
  }

  .not-found-text {
    font-size: var(--font-size-body);
    color: var(--text-on-paper-muted);
    margin: 0 0 40px 0;
    max-width: 500px;
  }

  .not-found-cta {
    display: inline-block;
    padding: 12px 24px;
    background-color: var(--acid);
    color: var(--text-on-acid);
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .not-found-cta:hover {
    opacity: 0.9;
  }
</style>
