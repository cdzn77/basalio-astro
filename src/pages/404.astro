---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="404 — this page does not exist">
  <section class="not-found-container" data-surface="paper">
    <h1 class="not-found-heading">404</h1>
    <p class="not-found-text">
      This page does not exist. Let's get you back on track.
    </p>
    <a href="/" class="not-found-cta">
      Back home
    </a>
  </section>
</BaseLayout>

<style>
  .not-found-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 70vh; /* DESIGN-SYSTEM.md: no token for viewport-height, hero type scale */
    padding: 80px 40px; /* TODO: add token for 80px, use var(--gap-40) for right/left */
    text-align: center;
  }

  .not-found-heading {
    /* Hero type scale (shared with Hero.astro): clamp(48px, 8vw, 96px) */
    font-size: clamp(48px, 8vw, 96px);
    font-weight: 700; /* TODO: add --font-weight-bold token */
    margin: 0 0 var(--space-20) 0;
    color: var(--text-on-paper);
  }

  .not-found-text {
    font-size: var(--font-size-body);
    color: var(--text-on-paper-muted);
    margin: 0 0 var(--space-40) 0;
    max-width: 500px; /* TODO: add token for body-max-width */
  }

  .not-found-cta {
    display: inline-block;
    padding: 12px var(--space-24); /* TODO: add token for 12px vertical padding */
    background-color: var(--acid);
    color: var(--text-on-acid);
    text-decoration: none;
    border-radius: var(--radius-4);
    font-weight: 600; /* TODO: add --font-weight-semibold token */
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .not-found-cta:hover {
    opacity: 0.9;
  }

  .not-found-cta:focus-visible {
    outline: 2px solid var(--text-on-paper);
    outline-offset: 2px;
  }
</style>
