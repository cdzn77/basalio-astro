---
// Blocks Page - All 9 interaction blocks for WordPress portfolios
// Reuses Nav, Testimonials, Footer from homepage

import BaseLayout from '../layouts/BaseLayout.astro';
import RampHeader from '../components/RampHeader.astro';
import RampTestimonialsV2 from '../components/RampTestimonialsV2.astro';
import RampFooter from '../components/RampFooter.astro';
import HeaderSplit from '../components/patterns/HeaderSplit.astro';

const title = "Blocks - Basalio";
const description = "Nine curated interaction blocks built for WordPress portfolios. Grid reveals, case study transitions, scroll sequences, and more.";

const blocks = [
  {
    title: "Grid Reveal",
    description: "Reveal content in a cascading grid pattern as users scroll down the page",
    tag: "Layout Block",
    slug: "grid-reveal"
  },
  {
    title: "Case Study Transition",
    description: "Smooth transitions between case studies with parallax and fade effects",
    tag: "Navigation Block",
    slug: "case-study-transition"
  },
  {
    title: "Scroll Sequence",
    description: "Trigger animations based on scroll position for synchronized storytelling",
    tag: "Animation Block",
    slug: "scroll-sequence"
  },
  {
    title: "Image Counter",
    description: "Animate numerical counters that respond to viewport interactions",
    tag: "Interaction Block",
    slug: "image-counter"
  },
  {
    title: "Timeline",
    description: "Interactive timeline component for process documentation and milestones",
    tag: "Content Block",
    slug: "timeline"
  },
  {
    title: "Image Carousel",
    description: "Responsive carousel for showcasing multiple images with smooth transitions",
    tag: "Gallery Block",
    slug: "image-carousel"
  },
  {
    title: "Fullscreen Video",
    description: "Full-width video player with autoplay and custom controls for portfolio reels",
    tag: "Media Block",
    slug: "fullscreen-video"
  },
  {
    title: "Smooth Scroll",
    description: "Custom scroll behavior with easing and anchor linking for polished navigation",
    tag: "Navigation Block",
    slug: "smooth-scroll"
  },
  {
    title: "Hover Effects",
    description: "Advanced hover states and interactive feedback for all interactive elements",
    tag: "Interaction Block",
    slug: "hover-effects"
  }
];

// Split description text into words for per-word animation
const descriptionWords = description.split(' ');
---

<BaseLayout title={title} description={description}>
  <!-- HEADER: Navigation bar -->
  <Fragment slot="header">
    <RampHeader />
  </Fragment>

  <!-- HERO SECTION: HeaderSplit pattern with eyebrow, headline, and description in right column -->
  <HeaderSplit
    eyebrow="OUR BLOCKS"
    heading="Nine blocks. Nothing you don't need."
    body={description}
    surface="paper"
  >
    <!-- RIGHT SLOT: Description with per-word animation -->
    <p class="hero-description">
      {descriptionWords.map((word, index) => (
        <span key={index} class="word-span" style={`--word-index: ${index}`}>
          {word}
        </span>
      ))}
    </p>
  </HeaderSplit>

  <!-- BLOCKS GRID -->
  <section class="courses-grid-section">
    <div class="courses-grid">
      {blocks.map((block, index) => {
        const imageMap = [
          'course-1.png',
          'course-2.png',
          'course-3.png',
          'course-4.png',
          'course-1.png',
          'course-2.png',
          'course-3.png',
          'course-4.png',
          'course-1.png'
        ];
        return (
        <div class={`course-card ${index >= 9 ? 'hidden-course' : ''}`}>
          <!-- Block Image Placeholder -->
          <div class="course-image-placeholder">
            <img
              src={`/assets/${imageMap[index]}`}
              alt={block.title}
              class="course-image"
            />
          </div>

          <!-- Block Info -->
          <div class="course-info">
            <a href={`/blocks/${block.slug}`} class="course-link">
              <h2 class="course-title">{block.title}</h2>
              <p class="course-description">{block.description}</p>
            </a>

            <!-- Tag Pill -->
            <a href={`/blocks/${block.slug}`} class="course-tag">{block.tag}</a>
          </div>
        </div>
      );
      })}
    </div>
  </section>

  <!-- WHO IT'S FOR CAROUSEL: Uses default whoIsThisFor data from RampTestimonialsV2 -->
  <RampTestimonialsV2 />

  <!-- FOOTER: Reused from homepage -->
  <Fragment slot="footer">
    <RampFooter />
  </Fragment>
</BaseLayout>

<style>
  /* HERO DESCRIPTION: Right slot content in HeaderSplit (animates on page load) */
  .hero-description {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
    width: 100%;
    word-wrap: break-word;
  }

  /* Per-word span animation */
  .word-span {
    display: inline-block;
    margin-right: 0.3em;
    opacity: 0;
    filter: blur(8px);
    animation: wordBlurIn 0.8s ease-out forwards;
    animation-delay: calc(var(--word-index) * 70ms);
  }

  @keyframes wordBlurIn {
    to {
      opacity: 1;
      filter: blur(0px);
    }
  }

  /* BLOCKS GRID SECTION: Full width container, content centered via HeaderSplit layout above */
  .courses-grid-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 80px 40px;
    padding-left: calc(35% + 40px);
    background: var(--surface-paper);
    width: 100%;
    max-width: 1792px;
    box-sizing: border-box;
    gap: 80px;
    overflow-x: hidden;
    margin: 0 auto;
  }

  /* BLOCKS GRID: 2 columns, full width of right container */
  .courses-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 60px;
    width: 100%;
    overflow: hidden;
  }

  /* BLOCK CARD */
  .course-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
    overflow: visible;
  }

  /* Hide courses 4-9 initially */
  .course-card.hidden-course {
    display: none;
  }

  /* Show courses when loaded */
  .courses-grid.loaded .course-card.hidden-course {
    display: flex;
  }

  /* Block Image Placeholder - Yellow background with black icon */
  .course-image-placeholder {
    width: 100%;
    aspect-ratio: 2/1;
    background: var(--acid);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .course-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 6px;
    transition: transform 300ms ease;
  }

  .course-card:hover .course-image {
    transform: scale(1.08);
  }

  .course-image:not([src]),
  .course-image[src=""] {
    display: none;
  }

  /* Block Info */
  .course-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .course-title {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .course-description {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    color: rgb(87, 87, 87);
    margin: 0;
    padding: 0;
  }

  /* Block Link */
  .course-link {
    text-decoration: none;
    cursor: pointer;
    transition: opacity 200ms ease;
  }

  .course-link:hover {
    opacity: 0.8;
  }

  /* Tag Pill */
  .course-tag {
    display: inline-flex;
    width: fit-content;
    padding: 8px;
    background: rgba(0, 0, 0, 0.1);
    border-radius: 6px;
    font-family: "Azeret Mono", monospace;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2.8px;
    color: rgb(87, 87, 87);
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: all 200ms ease;
  }

  .course-tag:hover {
    background: rgb(87, 87, 87);
    color: var(--surface-paper);
  }

  /* LOAD MORE BUTTON */
  .load-more-wrapper {
    display: flex;
    justify-content: flex-end;
    width: 100%;
    padding-right: 40px;
  }

  .load-more-button {
    padding: 14px 32px;
    background: rgb(235, 235, 235);
    border-radius: 6px;
    border: none;
    color: rgb(0, 0, 0);
    font-family: "Azeret Mono", monospace;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2.8px;
    line-height: 19.6px;
    text-align: start;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 200ms ease;
    -webkit-font-smoothing: antialiased;
  }


  .load-more-button:hover {
    opacity: 0.8;
  }

  .load-more-button:active {
    transform: scale(0.98);
  }

  /* Testimonials section: Background only (structure from BaseLayout) */
  .testimonials-rounded {
    overflow: visible;
    padding-bottom: 200px;
    background: var(--surface-paper);
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .courses-hero {
      flex-direction: column;
      gap: 40px;
      padding: 80px 20px;
    }

    .hero-left {
      flex: 0 0 auto;
    }

    .hero-description {
      font-size: 36px;
    }

    .courses-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media (max-width: 768px) {
    .courses-hero {
      flex-direction: column;
      gap: 40px;
      padding: 60px 20px;
    }

    .hero-left {
      flex: 0 0 auto;
    }

    .hero-description {
      font-size: 28px;
      line-height: 1.3;
    }

    .courses-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .courses-grid-section {
      padding: 60px 20px;
    }

    .course-title {
      font-size: 16px;
    }

    .course-description {
      font-size: 13px;
    }
  }
</style>

<script>
  // NAV BAR ENTRANCE ANIMATION
  // opacity: 0→1, y: -50→0, spring, 1000ms, bounce: 0, delay: 0
  const navHeader = document.querySelector('.ramp-header');
  if (navHeader) {
    navHeader.style.opacity = '0';
    navHeader.style.transform = 'translateY(-50px)';

    // Use CSS animation for spring effect
    navHeader.style.animation = 'navBarIn 1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards';
  }

  // MENU BUTTON LABEL ENTRANCE ANIMATION
  // opacity: 0→1, y: 10→0, spring, 600ms, bounce: 0, delay: 0
  // (Applied via CSS with .menu-label class if it exists in nav component)

  // Show all blocks on load (no "Load More" button)
  const coursesGrid = document.querySelector('.courses-grid');
  if (coursesGrid) {
    coursesGrid.classList.add('loaded');
  }
</script>

<style>
  /* Spring animation for nav bar */
  @keyframes navBarIn {
    from {
      opacity: 0;
      transform: translateY(-50px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
