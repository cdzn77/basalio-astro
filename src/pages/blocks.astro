---
// Blocks Page - All 9 interaction blocks for WordPress portfolios
// Reuses Nav, Testimonials, Footer from homepage

import BaseLayout from '../layouts/BaseLayout.astro';
import RampHeader from '../components/RampHeader.astro';
import RampTestimonialsV2 from '../components/RampTestimonialsV2.astro';
import RampFooter from '../components/RampFooter.astro';
import HeaderSplit from '../components/patterns/HeaderSplit.astro';
import Button from '../components/Button.astro';

const icons = import.meta.glob('/public/assets/icons/blocks/*.svg', {
  as: 'raw', eager: true
});

const title = "Blocks - Basalio";
const description = "Nine curated interaction blocks built for WordPress portfolios. Grid reveals, case study transitions, scroll sequences, and more.";

const blocks = [
  {
    title: "Grid Reveal",
    description: "Reveal content in a cascading grid pattern as users scroll down the page",
    tag: "Layout Block",
    slug: "grid-reveal"
  },
  {
    title: "Case Study Transition",
    description: "Smooth transitions between case studies with parallax and fade effects",
    tag: "Navigation Block",
    slug: "case-study-transition"
  },
  {
    title: "Text Reveal",
    description: "Reveal text character-by-character or word-by-word as users scroll",
    tag: "Typography Block",
    slug: "text-reveal"
  },
  {
    title: "Magnetic Button",
    description: "Interactive button that responds to mouse movement with magnetic attraction",
    tag: "Interaction Block",
    slug: "magnetic-button"
  },
  {
    title: "Before/After",
    description: "Side-by-side image comparison with draggable divider",
    tag: "Media Block",
    slug: "before-after"
  },
  {
    title: "Filterable Grid",
    description: "Grid content that filters and animates on category selection",
    tag: "Layout Block",
    slug: "filterable-grid"
  },
  {
    title: "Custom Cursor",
    description: "Replace browser cursor with custom branded interaction feedback",
    tag: "Interaction Block",
    slug: "custom-cursor"
  },
  {
    title: "Scroll Sequence",
    description: "Trigger animations based on scroll position for synchronized storytelling",
    tag: "Animation Block",
    slug: "scroll-sequence"
  },
  {
    title: "Pinned Scroll",
    description: "Lock elements in place while content scrolls for immersive narratives",
    tag: "Animation Block",
    slug: "pinned-scroll"
  }
];
---

<BaseLayout title={title} description={description}>
  <!-- HEADER: Navigation bar -->
  <Fragment slot="header">
    <RampHeader />
  </Fragment>

  <!-- HERO SECTION: HeaderSplit pattern with eyebrow, headline, and description in right column -->
  <HeaderSplit
    eyebrow="OUR BLOCKS"
    heading="Nine blocks. Nothing you don't need."
    body={description}
    surface="paper"
  >
    <!-- RIGHT SLOT: Hero copy about block features -->
    <div class="hero-right-content">
      <h2 class="hero-right-heading">Every one of them is keyboard-operable, reduced-motion aware, and loaded only on the pages that use it.</h2>
      <p class="hero-right-subheading">That isn't a Pro feature. That's the floor.</p>
    </div>
  </HeaderSplit>

  <!-- BLOCKS GRID -->
  <section class="courses-grid-section">
    <div class="courses-grid">
      {blocks.map((block, index) => {
        return (
        <a href={`#${block.slug}`} class={`block-card ${index >= 9 ? 'hidden-course' : ''}`}>
          <!-- Block Icon Tile -->
          <div class="block-image-placeholder">
            <div class="block-icon-tile">
              <span class="block-icon" set:html={icons[`/public/assets/icons/blocks/${block.slug}.svg`]} aria-hidden="true" />
            </div>
          </div>

          <!-- Block Info -->
          <div class="block-info">
            <h2 class="block-title">{block.title}</h2>
            <p class="block-description">{block.description}</p>

            <!-- Tag Pill -->
            <span class="block-tag">{block.tag}</span>
          </div>
        </a>
      );
      })}
    </div>
  </section>

  <!-- BLOCK DETAIL SECTIONS -->

  <!-- 1. GRID REVEAL SECTION -->
  <section id="grid-reveal" class="block-detail-section">
    <HeaderSplit
      eyebrow="GRID REVEAL"
      heading="Cascading grid reveal"
      body="Reveal content in a cascading grid pattern as users scroll down the page. Perfect for portfolio pages where you want to introduce work gradually, guiding the viewer's eye through your case studies one by one."
      surface="paper"
    >
      <div class="demo-container">
        <div class="grid-reveal-demo">
          {/* Placeholder portfolio tiles — not real client work */}
          <div class="grid-tile" style={`--tile-index: 0`} data-surface="ink">
            <div class="tile-content">
              <h3 class="tile-title">NORTHWIND</h3>
              <p class="tile-category">IDENTITY</p>
            </div>
          </div>
          <div class="grid-tile" style={`--tile-index: 1`} data-surface="alt">
            <div class="tile-content">
              <h3 class="tile-title">SALT & PINE</h3>
              <p class="tile-category">PACKAGING</p>
            </div>
          </div>
          <div class="grid-tile" style={`--tile-index: 2`} data-surface="ink">
            <div class="tile-content">
              <h3 class="tile-title">MERIDIAN</h3>
              <p class="tile-category">ART DIRECTION</p>
            </div>
          </div>
          <div class="grid-tile" style={`--tile-index: 3`} data-surface="alt">
            <div class="tile-content">
              <h3 class="tile-title">FIELD NOTES</h3>
              <p class="tile-category">EDITORIAL</p>
            </div>
          </div>
          <div class="grid-tile" style={`--tile-index: 4`} data-surface="ink">
            <div class="tile-content">
              <h3 class="tile-title">ATLAS & CO</h3>
              <p class="tile-category">BRAND SYSTEM</p>
            </div>
          </div>
          <div class="grid-tile" style={`--tile-index: 5`} data-surface="alt">
            <div class="tile-content">
              <h3 class="tile-title">LOW TIDE</h3>
              <p class="tile-category">MOTION</p>
            </div>
          </div>
        </div>
        <div class="grid-replay-controls">
          <Button id="grid-replay-btn" label="Replay" variant="ink" fontSize="13px" fontWeight="600" letterSpacing="0.05em" type="button" />
        </div>
        <p class="demo-caption">Recreated for the web. See it running in WordPress →</p>
      </div>
      <div class="block-controls">
        <h3 class="controls-heading">What you can control</h3>
        <div class="controls-list">
          <div class="control-item">
            <span class="control-name">data-delay</span>
            <span class="control-desc">Milliseconds between each item reveal (default: 100)</span>
          </div>
          <div class="control-item">
            <span class="control-name">data-duration</span>
            <span class="control-desc">Animation duration for each item in milliseconds (default: 600)</span>
          </div>
          <div class="control-item">
            <span class="control-name">data-easing</span>
            <span class="control-desc">CSS easing function (default: cubic-bezier(0.34, 1.56, 0.64, 1))</span>
          </div>
        </div>

        <div class="accessibility-note">
          <strong>Accessible:</strong> Grid Reveal respects prefers-reduced-motion and is fully keyboard-navigable. Content reveals without disabling interactions.
        </div>
      </div>
    </HeaderSplit>
  </section>

  <!-- 2. SCROLL SEQUENCE SECTION -->
  <section id="scroll-sequence" class="block-detail-section">
    <HeaderSplit
      eyebrow="SCROLL SEQUENCE"
      heading="Synchronized scroll storytelling"
      body="Trigger animations based on scroll position for synchronized storytelling. Ideal for case studies where you want to reveal key moments at precise scroll points, creating a cinematic experience."
      surface="paper"
    >
      <div class="demo-container">
        <div class="scroll-sequence-demo">
          <div class="sequence-left">
            <div class="sequence-copy-block" data-state="0">
              <p class="sequence-number">01</p>
              <p class="sequence-label">THE PROBLEM</p>
              <p class="sequence-body">Outline the challenge</p>
            </div>
            <div class="sequence-copy-block" data-state="1">
              <p class="sequence-number">02</p>
              <p class="sequence-label">THE APPROACH</p>
              <p class="sequence-body">Describe the strategy</p>
            </div>
            <div class="sequence-copy-block" data-state="2">
              <p class="sequence-number">03</p>
              <p class="sequence-label">THE RESULT</p>
              <p class="sequence-body">Show the outcome</p>
            </div>
          </div>
          <div class="sequence-right">
            <div class="sequence-panel sequence-state-0"></div>
          </div>
        </div>
        <p class="demo-caption">Recreated for the web. See it running in WordPress →</p>
      </div>
      <div class="block-controls">
        <h3 class="controls-heading">What you can control</h3>
        <div class="controls-list">
          <div class="control-item">
            <span class="control-name">data-trigger</span>
            <span class="control-desc">Scroll threshold percentage to trigger animation (default: 50)</span>
          </div>
          <div class="control-item">
            <span class="control-name">data-duration</span>
            <span class="control-desc">Animation duration in milliseconds (default: 800)</span>
          </div>
          <div class="control-item">
            <span class="control-name">data-easing</span>
            <span class="control-desc">CSS easing function (default: ease-out-quart)</span>
          </div>
        </div>

        <div class="accessibility-note">
          <strong>Accessible:</strong> Scroll Sequence respects prefers-reduced-motion and does not block content interaction during animations.
        </div>
      </div>
    </HeaderSplit>
  </section>

  <!-- 3. BEFORE/AFTER SECTION -->
  <section id="before-after" class="block-detail-section">
    <HeaderSplit
      eyebrow="BEFORE/AFTER"
      heading="Before and after, side by side"
      body="Compare two states of the same image with a divider between them. Show retouching, design iterations, or transformation work."
      surface="paper"
    >
      <div class="demo-container">
        <div class="before-after-demo"
             role="slider"
             tabindex="0"
             aria-valuemin="10"
             aria-valuemax="90"
             aria-valuenow="50"
             aria-label="Comparison divider position"
             data-initial-position="50"
             data-min-position="10"
             data-max-position="90">
          <div class="comparison-before">
            <h3 class="comparison-heading-before">LAYOUT</h3>
            <div class="comparison-caption-row">
              <span>GRID</span>
              <span>TYPE</span>
              <span>SPACE</span>
            </div>
            <div class="comparison-rule-before"></div>
          </div>
          <div class="comparison-after">
            <h3 class="comparison-heading-after">LAYOUT</h3>
            <div class="comparison-caption-row-after">
              <span>GRID</span>
              <span>TYPE</span>
              <span>SPACE</span>
            </div>
            <div class="comparison-rule-after"></div>
          </div>
          <div class="comparison-divider" aria-hidden="true">
            <svg class="comparison-handle" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <polyline points="6,4 10,8 6,12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <polyline points="10,4 6,8 10,12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
        </div>
        <p class="demo-caption">Recreated for the web. See it running in WordPress →</p>
      </div>
      <div class="block-controls">
        <h3 class="controls-heading">What you can control</h3>
        <div class="controls-list">
          <div class="control-item">
            <span class="control-name">data-initial-position</span>
            <span class="control-desc">Starting divider position as percentage (default: 50)</span>
          </div>
          <div class="control-item">
            <span class="control-name">data-min-position</span>
            <span class="control-desc">Minimum allowed divider position (default: 10)</span>
          </div>
          <div class="control-item">
            <span class="control-name">data-max-position</span>
            <span class="control-desc">Maximum allowed divider position (default: 90)</span>
          </div>
        </div>

        <div class="accessibility-note">
          <strong>Accessible:</strong> Before/After slider is fully keyboard-operable (arrow keys) and touch-friendly. Screen reader announces position updates.
        </div>
      </div>
    </HeaderSplit>
  </section>

  <!-- 4. CASE STUDY TRANSITION SECTION -->
  <section id="case-study-transition" class="block-detail-section">
    <HeaderSplit
      eyebrow="CASE STUDY TRANSITION"
      heading="Smooth transitions between case studies"
      body="Smooth transitions between case studies with parallax and fade effects"
      surface="paper"
    >
    </HeaderSplit>
  </section>

  <!-- 5. TEXT REVEAL SECTION -->
  <section id="text-reveal" class="block-detail-section">
    <HeaderSplit
      eyebrow="TEXT REVEAL"
      heading="Reveal text character by character"
      body="Reveal text character-by-character or word-by-word as users scroll"
      surface="paper"
    >
    </HeaderSplit>
  </section>

  <!-- 6. MAGNETIC BUTTON SECTION -->
  <section id="magnetic-button" class="block-detail-section">
    <HeaderSplit
      eyebrow="MAGNETIC BUTTON"
      heading="Interactive button with magnetic attraction"
      body="Interactive button that responds to mouse movement with magnetic attraction"
      surface="paper"
    >
    </HeaderSplit>
  </section>

  <!-- 7. FILTERABLE GRID SECTION -->
  <section id="filterable-grid" class="block-detail-section">
    <HeaderSplit
      eyebrow="FILTERABLE GRID"
      heading="Grid content that filters and animates"
      body="Grid content that filters and animates on category selection"
      surface="paper"
    >
    </HeaderSplit>
  </section>

  <!-- 8. CUSTOM CURSOR SECTION -->
  <section id="custom-cursor" class="block-detail-section">
    <HeaderSplit
      eyebrow="CUSTOM CURSOR"
      heading="Replace the browser cursor with custom feedback"
      body="Replace browser cursor with custom branded interaction feedback"
      surface="paper"
    >
    </HeaderSplit>
  </section>

  <!-- 9. PINNED SCROLL SECTION -->
  <section id="pinned-scroll" class="block-detail-section">
    <HeaderSplit
      eyebrow="PINNED SCROLL"
      heading="Lock elements in place while content scrolls"
      body="Lock elements in place while content scrolls for immersive narratives"
      surface="paper"
    >
    </HeaderSplit>
  </section>

  <!-- WHO IT'S FOR CAROUSEL: Uses default whoIsThisFor data from RampTestimonialsV2 -->
  <RampTestimonialsV2 />

  <!-- FOOTER: Reused from homepage -->
  <Fragment slot="footer">
    <RampFooter />
  </Fragment>
</BaseLayout>

<style>
  /* HERO DESCRIPTION: Right slot content in HeaderSplit (animates on page load) */
  .hero-description {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
    width: 100%;
    word-wrap: break-word;
  }

  /* Hero Right Content */
  .hero-right-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hero-right-heading {
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 700;
    line-height: 1.4;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .hero-right-subheading {
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 400;
    line-height: 1.4;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
  }

  /* BLOCKS GRID SECTION: Full width container, content centered via HeaderSplit layout above */
  .courses-grid-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 80px 40px;
    padding-left: calc(35% + 40px);
    background: var(--surface-paper);
    width: 100%;
    max-width: 1792px;
    box-sizing: border-box;
    gap: 80px;
    overflow-x: hidden;
    margin: 0 auto;
  }

  /* BLOCKS GRID: 2 columns, full width of right container */
  .courses-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 60px;
    width: 100%;
    overflow: hidden;
  }

  /* BLOCK CARD */
  .block-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
    overflow: visible;
  }

  .block-card:focus-visible {
    outline: 2px solid var(--text-on-paper);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px var(--surface-paper);
  }

  /* Hide courses 4-9 initially */
  .block-card.hidden-course {
    display: none;
  }

  /* Show courses when loaded */
  .courses-grid.loaded .block-card.hidden-course {
    display: flex;
  }

  /* Block Image Placeholder - Yellow background with black icon */
  .block-image-placeholder {
    width: 100%;
    aspect-ratio: 2/1;
    background: var(--acid);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    position: relative;
  }

  .block-icon-tile {
    background: var(--acid);
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }

  .block-icon {
    color: var(--text-on-acid);
    display: block;
    width: clamp(77px, 21.6%, 125px);
  }

  .block-icon svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Block Info */
  .block-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .block-title {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .block-description {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
  }

  /* Tag Pill */
  .block-tag {
    display: inline-flex;
    width: fit-content;
    padding: 8px;
    background: rgba(0, 0, 0, 0.1);
    border-radius: 6px;
    font-family: "Azeret Mono", monospace;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2.8px;
    color: var(--text-on-paper-muted);
    text-transform: uppercase;
    transition: all 200ms ease;
  }

  .block-card:hover .block-tag {
    background: var(--text-on-paper-muted);
    color: var(--surface-paper);
  }

  /* LOAD MORE BUTTON */
  .load-more-wrapper {
    display: flex;
    justify-content: flex-end;
    width: 100%;
    padding-right: 40px;
  }

  .load-more-button {
    padding: 14px 32px;
    background: rgb(235, 235, 235);
    border-radius: 6px;
    border: none;
    color: rgb(0, 0, 0);
    font-family: "Azeret Mono", monospace;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2.8px;
    line-height: 19.6px;
    text-align: start;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 200ms ease;
    -webkit-font-smoothing: antialiased;
  }


  .load-more-button:hover {
    opacity: 0.8;
  }

  .load-more-button:active {
    transform: scale(0.98);
  }

  /* Testimonials section: Background only (structure from BaseLayout) */
  .testimonials-rounded {
    overflow: visible;
    padding-bottom: 200px;
    background: var(--surface-paper);
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .courses-hero {
      flex-direction: column;
      gap: 40px;
      padding: 80px 20px;
    }

    .hero-left {
      flex: 0 0 auto;
    }

    .hero-description {
      font-size: 36px;
    }

    .courses-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media (max-width: 768px) {
    .courses-hero {
      flex-direction: column;
      gap: 40px;
      padding: 60px 20px;
    }

    .hero-left {
      flex: 0 0 auto;
    }

    .hero-description {
      font-size: 28px;
      line-height: 1.3;
    }

    .courses-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .courses-grid-section {
      padding: 60px 20px;
    }

    .block-title {
      font-size: 16px;
    }

    .block-description {
      font-size: 13px;
    }

    .grid-reveal-demo {
      max-width: 300px;
    }

    .grid-tile {
      aspect-ratio: 0.75;
    }

    .tile-title {
      font-size: 12px;
    }

    .tile-category {
      font-size: 10px;
    }
  }

  /* BLOCK DETAIL SECTIONS */
  .block-detail-section {
    scroll-margin-top: 80px;
    width: 100%;
  }

  .demo-container {
    width: 100%;
    min-height: 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--surface-alt);
    border-radius: 8px;
    border: 1px solid var(--stone);
    padding: 40px;
    box-sizing: border-box;
    gap: 24px;
  }

  .demo-caption {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
    text-align: center;
  }

  /* GRID REVEAL DEMO */
  .grid-reveal-demo {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    width: 100%;
    max-width: 450px;
  }

  .grid-tile {
    aspect-ratio: 0.75;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 20px;
    border-radius: 0;
    opacity: 0;
    transform: translateY(24px);
  }

  .grid-tile.is-revealed {
    animation: tileReveal 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: calc(var(--tile-index) * 180ms);
  }

  .grid-tile[data-surface="ink"] {
    background: var(--surface-ink);
    color: var(--text-on-ink);
  }

  .grid-tile[data-surface="alt"] {
    background: var(--surface-paper);
    color: var(--text-on-paper);
  }

  .tile-content {
    width: 100%;
  }

  .tile-title {
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 4px 0;
    padding: 0;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .tile-category {
    font-size: 11px;
    font-weight: 400;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: reduce) {
    .grid-tile {
      animation: none;
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes tileReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .grid-replay-controls {
    display: flex;
    justify-content: center;
    margin-top: 40px;
    width: 100%;
  }

  /* SCROLL SEQUENCE DEMO */
  .scroll-sequence-demo {
    display: flex;
    width: 100%;
    max-width: 1000px;
    height: 160vh;
    gap: 40px;
    position: relative;
  }

  .sequence-left {
    flex: 0 0 40%;
    display: flex;
    flex-direction: column;
    padding-top: 120px;
  }

  .sequence-copy-block {
    height: 50vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0.6;
    transition: opacity 0.4s ease-out;
  }

  .sequence-copy-block[data-state="0"],
  .sequence-copy-block[data-state="1"],
  .sequence-copy-block[data-state="2"] {
    opacity: 0.35;
  }

  .sequence-copy-block.is-active {
    opacity: 1;
  }

  .sequence-number {
