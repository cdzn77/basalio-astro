---
// Blocks Page - All 9 interaction blocks for WordPress portfolios
// Reuses Nav, Testimonials, Footer from homepage

import BaseLayout from '../layouts/BaseLayout.astro';
import RampHeader from '../components/RampHeader.astro';
import RampTestimonialsV2 from '../components/RampTestimonialsV2.astro';
import RampFooter from '../components/RampFooter.astro';
import HeaderSplit from '../components/patterns/HeaderSplit.astro';

const title = "Blocks - Basalio";
const description = "Nine curated interaction blocks built for WordPress portfolios. Grid reveals, case study transitions, scroll sequences, and more.";

const blocks = [
  {
    title: "Grid Reveal",
    description: "Reveal content in a cascading grid pattern as users scroll down the page",
    tag: "Layout Block",
    slug: "grid-reveal"
  },
  {
    title: "Case Study Transition",
    description: "Smooth transitions between case studies with parallax and fade effects",
    tag: "Navigation Block",
    slug: "case-study-transition"
  },
  {
    title: "Text Reveal",
    description: "Reveal text character-by-character or word-by-word as users scroll",
    tag: "Typography Block",
    slug: "text-reveal"
  },
  {
    title: "Magnetic Button",
    description: "Interactive button that responds to mouse movement with magnetic attraction",
    tag: "Interaction Block",
    slug: "magnetic-button"
  },
  {
    title: "Before/After",
    description: "Side-by-side image comparison with draggable divider",
    tag: "Media Block",
    slug: "before-after"
  },
  {
    title: "Filterable Grid",
    description: "Grid content that filters and animates on category selection",
    tag: "Layout Block",
    slug: "filterable-grid"
  },
  {
    title: "Custom Cursor",
    description: "Replace browser cursor with custom branded interaction feedback",
    tag: "Interaction Block",
    slug: "custom-cursor"
  },
  {
    title: "Scroll Sequence",
    description: "Trigger animations based on scroll position for synchronized storytelling",
    tag: "Animation Block",
    slug: "scroll-sequence"
  },
  {
    title: "Pinned Scroll",
    description: "Lock elements in place while content scrolls for immersive narratives",
    tag: "Animation Block",
    slug: "pinned-scroll"
  }
];

// Split description text into words for per-word animation
const descriptionWords = description.split(' ');
---

<BaseLayout title={title} description={description}>
  <!-- HEADER: Navigation bar -->
  <Fragment slot="header">
    <RampHeader />
  </Fragment>

  <!-- HERO SECTION: HeaderSplit pattern with eyebrow, headline, and description in right column -->
  <HeaderSplit
    eyebrow="OUR BLOCKS"
    heading="Nine blocks. Nothing you don't need."
    body={description}
    surface="paper"
  >
    <!-- RIGHT SLOT: Description with per-word animation -->
    <p class="hero-description">
      {descriptionWords.map((word, index) => (
        <span key={index} class="word-span" style={`--word-index: ${index}`}>
          {word}
        </span>
      ))}
    </p>
  </HeaderSplit>

  <!-- BLOCKS GRID -->
  <section class="courses-grid-section">
    <div class="courses-grid">
      {blocks.map((block, index) => {
        const imageMap = [
          'course-1.png',
          'course-2.png',
          'course-3.png',
          'course-4.png',
          'course-1.png',
          'course-2.png',
          'course-3.png',
          'course-4.png',
          'course-1.png'
        ];
        return (
        <div class={`course-card ${index >= 9 ? 'hidden-course' : ''}`}>
          <!-- Block Image Placeholder -->
          <div class="course-image-placeholder">
            <img
              src={`/assets/${imageMap[index]}`}
              alt={block.title}
              class="course-image"
            />
          </div>

          <!-- Block Info -->
          <div class="course-info">
            <a href={`#${block.slug}`} class="course-link">
              <h2 class="course-title">{block.title}</h2>
              <p class="course-description">{block.description}</p>
            </a>

            <!-- Tag Pill -->
            <a href={`#${block.slug}`} class="course-tag">{block.tag}</a>
          </div>
        </div>
      );
      })}
    </div>
  </section>

  <!-- BLOCK DETAIL SECTIONS -->

  <!-- 1. GRID REVEAL SECTION -->
  <section id="grid-reveal" class="block-detail-section">
    <HeaderSplit
      eyebrow="GRID REVEAL"
      heading="Cascading grid reveal"
      body="Reveal content in a cascading grid pattern as users scroll down the page. Perfect for portfolio pages where you want to introduce work gradually, guiding the viewer's eye through your case studies one by one."
      surface="paper"
    >
      <div class="demo-container">
        <div class="grid-reveal-demo">
          {[...Array(9)].map((_, i) => (
            <div class="demo-item" style={`--item-index: ${i}`} />
          ))}
        </div>
      </div>
      <div class="block-controls">
        <h3 class="controls-heading">What you can control</h3>
        <div class="controls-list">
          <div class="control-item">
            <span class="control-name">data-delay</span>
            <span class="control-desc">Milliseconds between each item reveal (default: 100)</span>
          </div>
          <div class="control-item">
            <span class="control-name">data-duration</span>
            <span class="control-desc">Animation duration for each item in milliseconds (default: 600)</span>
          </div>
          <div class="control-item">
            <span class="control-name">data-easing</span>
            <span class="control-desc">CSS easing function (default: cubic-bezier(0.34, 1.56, 0.64, 1))</span>
          </div>
        </div>

        <div class="accessibility-note">
          <strong>Accessible:</strong> Grid Reveal respects prefers-reduced-motion and is fully keyboard-navigable. Content reveals without disabling interactions.
        </div>
      </div>
    </HeaderSplit>
  </section>

  <!-- 2. SCROLL SEQUENCE SECTION -->
  <section id="scroll-sequence" class="block-detail-section">
    <HeaderSplit
      eyebrow="SCROLL SEQUENCE"
      heading="Synchronized scroll storytelling"
      body="Trigger animations based on scroll position for synchronized storytelling. Ideal for case studies where you want to reveal key moments at precise scroll points, creating a cinematic experience."
      surface="paper"
    >
      <div class="demo-container">
        <div class="scroll-sequence-demo">
          <div class="sequence-item" style="--sequence-step: 0">Step 1</div>
          <div class="sequence-item" style="--sequence-step: 1">Step 2</div>
          <div class="sequence-item" style="--sequence-step: 2">Step 3</div>
        </div>
      </div>
      <div class="block-controls">
        <h3 class="controls-heading">What you can control</h3>
        <div class="controls-list">
          <div class="control-item">
            <span class="control-name">data-trigger</span>
            <span class="control-desc">Scroll threshold percentage to trigger animation (default: 50)</span>
          </div>
          <div class="control-item">
            <span class="control-name">data-duration</span>
            <span class="control-desc">Animation duration in milliseconds (default: 800)</span>
          </div>
          <div class="control-item">
            <span class="control-name">data-easing</span>
            <span class="control-desc">CSS easing function (default: ease-out-quart)</span>
          </div>
        </div>

        <div class="accessibility-note">
          <strong>Accessible:</strong> Scroll Sequence respects prefers-reduced-motion and does not block content interaction during animations.
        </div>
      </div>
    </HeaderSplit>
  </section>

  <!-- 3. BEFORE/AFTER SECTION -->
  <section id="before-after" class="block-detail-section">
    <HeaderSplit
      eyebrow="BEFORE/AFTER"
      heading="Image comparison slider"
      body="Side-by-side image comparison with draggable divider. Show transformation work, design iterations, or before-and-after results with an interactive slider that users can control."
      surface="paper"
    >
      <div class="demo-container">
        <div class="before-after-demo">
          <div class="comparison-frame">
            <div class="before-image">Before</div>
            <div class="after-image">After</div>
            <div class="divider" />
          </div>
        </div>
      </div>
      <div class="block-controls">
        <h3 class="controls-heading">What you can control</h3>
        <div class="controls-list">
          <div class="control-item">
            <span class="control-name">data-initial-position</span>
            <span class="control-desc">Starting divider position as percentage (default: 50)</span>
          </div>
          <div class="control-item">
            <span class="control-name">data-min-position</span>
            <span class="control-desc">Minimum allowed divider position (default: 10)</span>
          </div>
          <div class="control-item">
            <span class="control-name">data-max-position</span>
            <span class="control-desc">Maximum allowed divider position (default: 90)</span>
          </div>
        </div>

        <div class="accessibility-note">
          <strong>Accessible:</strong> Before/After slider is fully keyboard-operable (arrow keys) and touch-friendly. Screen reader announces position updates.
        </div>
      </div>
    </HeaderSplit>
  </section>

  <!-- WHO IT'S FOR CAROUSEL: Uses default whoIsThisFor data from RampTestimonialsV2 -->
  <RampTestimonialsV2 />

  <!-- FOOTER: Reused from homepage -->
  <Fragment slot="footer">
    <RampFooter />
  </Fragment>
</BaseLayout>

<style>
  /* HERO DESCRIPTION: Right slot content in HeaderSplit (animates on page load) */
  .hero-description {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
    width: 100%;
    word-wrap: break-word;
  }

  /* Per-word span animation */
  .word-span {
    display: inline-block;
    margin-right: 0.3em;
    opacity: 0;
    filter: blur(8px);
    animation: wordBlurIn 0.8s ease-out forwards;
    animation-delay: calc(var(--word-index) * 70ms);
  }

  @keyframes wordBlurIn {
    to {
      opacity: 1;
      filter: blur(0px);
    }
  }

  /* BLOCKS GRID SECTION: Full width container, content centered via HeaderSplit layout above */
  .courses-grid-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 80px 40px;
    padding-left: calc(35% + 40px);
    background: var(--surface-paper);
    width: 100%;
    max-width: 1792px;
    box-sizing: border-box;
    gap: 80px;
    overflow-x: hidden;
    margin: 0 auto;
  }

  /* BLOCKS GRID: 2 columns, full width of right container */
  .courses-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 60px;
    width: 100%;
    overflow: hidden;
  }

  /* BLOCK CARD */
  .course-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
    overflow: visible;
  }

  /* Hide courses 4-9 initially */
  .course-card.hidden-course {
    display: none;
  }

  /* Show courses when loaded */
  .courses-grid.loaded .course-card.hidden-course {
    display: flex;
  }

  /* Block Image Placeholder - Yellow background with black icon */
  .course-image-placeholder {
    width: 100%;
    aspect-ratio: 2/1;
    background: var(--acid);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .course-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 6px;
    transition: transform 300ms ease;
  }

  .course-card:hover .course-image {
    transform: scale(1.08);
  }

  .course-image:not([src]),
  .course-image[src=""] {
    display: none;
  }

  /* Block Info */
  .course-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .course-title {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .course-description {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    color: rgb(87, 87, 87);
    margin: 0;
    padding: 0;
  }

  /* Block Link */
  .course-link {
    text-decoration: none;
    cursor: pointer;
    transition: opacity 200ms ease;
  }

  .course-link:hover {
    opacity: 0.8;
  }

  /* Tag Pill */
  .course-tag {
    display: inline-flex;
    width: fit-content;
    padding: 8px;
    background: rgba(0, 0, 0, 0.1);
    border-radius: 6px;
    font-family: "Azeret Mono", monospace;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2.8px;
    color: rgb(87, 87, 87);
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: all 200ms ease;
  }

  .course-tag:hover {
    background: rgb(87, 87, 87);
    color: var(--surface-paper);
  }

  /* LOAD MORE BUTTON */
  .load-more-wrapper {
    display: flex;
    justify-content: flex-end;
    width: 100%;
    padding-right: 40px;
  }

  .load-more-button {
    padding: 14px 32px;
    background: rgb(235, 235, 235);
    border-radius: 6px;
    border: none;
    color: rgb(0, 0, 0);
    font-family: "Azeret Mono", monospace;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2.8px;
    line-height: 19.6px;
    text-align: start;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 200ms ease;
    -webkit-font-smoothing: antialiased;
  }


  .load-more-button:hover {
    opacity: 0.8;
  }

  .load-more-button:active {
    transform: scale(0.98);
  }

  /* Testimonials section: Background only (structure from BaseLayout) */
  .testimonials-rounded {
    overflow: visible;
    padding-bottom: 200px;
    background: var(--surface-paper);
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .courses-hero {
      flex-direction: column;
      gap: 40px;
      padding: 80px 20px;
    }

    .hero-left {
      flex: 0 0 auto;
    }

    .hero-description {
      font-size: 36px;
    }

    .courses-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media (max-width: 768px) {
    .courses-hero {
      flex-direction: column;
      gap: 40px;
      padding: 60px 20px;
    }

    .hero-left {
      flex: 0 0 auto;
    }

    .hero-description {
      font-size: 28px;
      line-height: 1.3;
    }

    .courses-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .courses-grid-section {
      padding: 60px 20px;
    }

    .course-title {
      font-size: 16px;
    }

    .course-description {
      font-size: 13px;
    }
  }

  /* BLOCK DETAIL SECTIONS */
  .block-detail-section {
    scroll-margin-top: 80px;
    width: 100%;
  }

  .demo-container {
    width: 100%;
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-alt);
    border-radius: 8px;
    border: 1px solid var(--stone);
    padding: 40px;
    box-sizing: border-box;
  }

  /* GRID REVEAL DEMO */
  .grid-reveal-demo {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    width: 100%;
    max-width: 280px;
  }

  .grid-reveal-demo .demo-item {
    aspect-ratio: 1;
    background: var(--acid);
    border-radius: 4px;
    opacity: 0;
    transform: scale(0.8);
    animation: gridRevealItem 0.6s cubic-bezier(0.165, 0.84, 0.44, 1) forwards;
    animation-delay: calc(var(--item-index) * 100ms);
  }

  @keyframes gridRevealItem {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* SCROLL SEQUENCE DEMO */
  .scroll-sequence-demo {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    max-width: 240px;
  }

  .sequence-item {
    padding: 20px;
    background: var(--acid);
    color: var(--text-on-acid);
    border-radius: 6px;
    text-align: center;
    font-weight: 600;
    opacity: 0;
    transform: translateX(-20px);
    animation: sequenceReveal 0.6s ease-out forwards;
    animation-delay: calc(var(--sequence-step) * 120ms);
  }

  @keyframes sequenceReveal {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* BEFORE/AFTER DEMO */
  .before-after-demo {
    width: 100%;
    max-width: 300px;
  }

  .comparison-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    background: var(--surface-alt);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
  }

  .before-image,
  .after-image {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 14px;
  }

  .before-image {
    background: var(--surface-ink);
    color: var(--text-on-ink);
  }

  .after-image {
    background: var(--acid);
    color: var(--text-on-acid);
  }

  .divider {
    position: absolute;
    left: 50%;
    top: 0;
    width: 2px;
    height: 100%;
    background: var(--surface-paper);
    cursor: col-resize;
    transform: translateX(-1px);
  }

  /* BLOCK CONTROLS SECTION */
  .block-controls {
    width: 100%;
    margin-top: 40px;
    padding-top: 40px;
  }


  .controls-heading {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-on-paper);
    margin: 0 0 24px 0;
    padding: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .controls-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 32px;
  }

  .control-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .control-name {
    font-family: var(--font-mono-code);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-on-paper);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .control-desc {
    font-size: 14px;
    font-weight: 400;
    color: var(--text-on-paper-muted);
    line-height: 1.5;
  }

  .accessibility-note {
    padding: 16px;
    background: var(--surface-alt);
    border-left: 2px solid var(--stone);
    border-radius: 4px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-on-paper);
  }

  .accessibility-note strong {
    color: var(--text-on-paper);
  }
</style>

<script>
  // NAV BAR ENTRANCE ANIMATION
  // opacity: 0→1, y: -50→0, spring, 1000ms, bounce: 0, delay: 0
  const navHeader = document.querySelector('.ramp-header');
  if (navHeader) {
    navHeader.style.opacity = '0';
    navHeader.style.transform = 'translateY(-50px)';

    // Use CSS animation for spring effect
    navHeader.style.animation = 'navBarIn 1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards';
  }

  // MENU BUTTON LABEL ENTRANCE ANIMATION
  // opacity: 0→1, y: 10→0, spring, 600ms, bounce: 0, delay: 0
  // (Applied via CSS with .menu-label class if it exists in nav component)

  // Show all blocks on load (no "Load More" button)
  const coursesGrid = document.querySelector('.courses-grid');
  if (coursesGrid) {
    coursesGrid.classList.add('loaded');
  }
</script>

<style>
  /* Spring animation for nav bar */
  @keyframes navBarIn {
    from {
      opacity: 0;
      transform: translateY(-50px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
