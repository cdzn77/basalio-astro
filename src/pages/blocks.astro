<script>
  // NAV BAR ENTRANCE ANIMATION
  // opacity: 0→1, y: -50→0, spring, 1000ms, bounce: 0, delay: 0
  const navHeader = document.querySelector('.ramp-header');
  if (navHeader) {
    navHeader.style.opacity = '0';
    navHeader.style.transform = 'translateY(-50px)';

    // Use CSS animation for spring effect
    navHeader.style.animation = 'navBarIn 1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards';
  }

  // MENU BUTTON LABEL ENTRANCE ANIMATION
  // opacity: 0→1, y: 10→0, spring, 600ms, bounce: 0, delay: 0
  // (Applied via CSS with .menu-label class if it exists in nav component)

  // Show all blocks on load (no "Load More" button)
  const coursesGrid = document.querySelector('.courses-grid');
  if (coursesGrid) {
    coursesGrid.classList.add('loaded');
  }

  // GRID REVEAL INTERSECTION OBSERVER
  function setupGridRevealObserver() {
    const gridDemo = document.querySelector('.grid-reveal-demo');
    if (!gridDemo) return;

    const tiles = gridDemo.querySelectorAll('.grid-tile');
    const replayBtn = document.getElementById('grid-replay-btn');

    function playAnimation() {
      tiles.forEach(tile => {
        tile.classList.add('is-revealed');
      });
    }

    function resetAndReplay() {
      tiles.forEach(tile => {
        tile.classList.remove('is-revealed');
      });
      void gridDemo.offsetHeight; // Force reflow
      requestAnimationFrame(() => {
        playAnimation();
      });
    }

    // IntersectionObserver to trigger animation on scroll
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          playAnimation();
          observer.unobserve(gridDemo);
        }
      });
    }, { threshold: 0.1 });

    observer.observe(gridDemo);

    // Replay button handler
    if (replayBtn) {
      replayBtn.addEventListener('click', (e) => {
        e.preventDefault();
        resetAndReplay();
      });
    }
  }

  // SCROLL SEQUENCE - SCROLL-DRIVEN STICKY PANEL
  function setupScrollSequence() {
    const demo = document.querySelector('.scroll-sequence-demo');
    if (!demo) return;

    const blocks = demo.querySelectorAll('.sequence-copy-block');
    const panel = demo.querySelector('.sequence-panel');
    let currentState = -1;

    function updatePanelState(state) {
      if (state === currentState) return;
      currentState = state;
      panel.className = `sequence-panel sequence-state-${state}`;
    }

    blocks.forEach((block, index) => {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              updatePanelState(index);
            }
          });
        },
        {
          rootMargin: '-50% 0px -50% 0px',
          threshold: 0
        }
      );
      observer.observe(block);
    });
  }

  // BEFORE/AFTER - DRAGGABLE DIVIDER
  function setupBeforeAfter() {
    const demo = document.querySelector('.before-after-demo');
    if (!demo) return;

    const divider = demo.querySelector('.comparison-divider');
    const minPos = parseInt(demo.dataset.minPosition) || 10;
    const maxPos = parseInt(demo.dataset.maxPosition) || 90;
    let currentPos = parseInt(demo.dataset.initialPosition) || 50;
    let isDragging = false;

    function updateDivider(pos) {
      pos = Math.max(minPos, Math.min(maxPos, pos));
      if (pos === currentPos) return;
      currentPos = pos;
      demo.style.setProperty('--pos', currentPos + '%');
      demo.setAttribute('aria-valuenow', currentPos);
    }

    function onPointerDown(e) {
      if (e.button && e.button !== 0) return;
      isDragging = true;
      demo.setPointerCapture(e.pointerId);
    }

    function onPointerMove(e) {
      if (!isDragging) return;
      const rect = demo.getBoundingClientRect();
      const pos = ((e.clientX - rect.left) / rect.width) * 100;
      updateDivider(pos);
    }

    function onPointerUp() {
      isDragging = false;
    }

    function onKeyDown(e) {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        updateDivider(currentPos - 2);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        updateDivider(currentPos + 2);
      } else if (e.key === 'Home') {
        e.preventDefault();
        updateDivider(minPos);
      } else if (e.key === 'End') {
        e.preventDefault();
        updateDivider(maxPos);
      }
    }

    demo.addEventListener('pointerdown', onPointerDown);
    demo.addEventListener('pointermove', onPointerMove);
    demo.addEventListener('pointerup', onPointerUp);
    demo.addEventListener('pointercancel', onPointerUp);
    demo.addEventListener('keydown', onKeyDown);

    updateDivider(currentPos);
  }

  // Delay setup to ensure DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setupGridRevealObserver();
      setupScrollSequence();
      setupBeforeAfter();
    });
  } else {
    setupGridRevealObserver();
    setupScrollSequence();
    setupBeforeAfter();
  }
</script>

<style>
  /* Spring animation for nav bar */
  @keyframes navBarIn {
    from {
      opacity: 0;
      transform: translateY(-50px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
