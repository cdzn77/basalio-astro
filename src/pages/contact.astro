---
// Contact Page - Get in touch with Basalio

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeaderSplit from '../components/patterns/HeaderSplit.astro';
import { socialLinks } from '../data/navigation';

const title = "Contact Basalio";
const description = "Get in touch with Basalio. Submit a message and we'll get back to you within 48 hours.";
---

<BaseLayout title={title} description={description}>
  <!-- HEADER: Navigation bar -->
  <Fragment slot="header">
    <Header />
  </Fragment>

  <!-- HERO + FORM SECTION: HeaderSplit with form in right slot -->
  <HeaderSplit
    eyebrow="Contact"
    heading="A direct line to the person building it."
    body="Basalio is a one-person studio. No support tickets disappearing into a queue. Your message lands in the inbox of the developer who wrote the block you are asking about."
    level="h1"
    surface="paper"
  >
    <div class="contact-form-wrapper">
      <form
        name="contact"
        method="POST"
        action="/welcome/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="contact-form"
        id="contact-form"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="honeypot">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <div class="form-row">
          <label class="form-field">
            <span class="form-label">Name</span>
            <input type="text" name="name" placeholder="Your name" required autocomplete="name" />
          </label>
          <label class="form-field">
            <span class="form-label">Email</span>
            <input type="email" name="email" placeholder="you@studio.com" required autocomplete="email" />
          </label>
        </div>

        <fieldset class="form-field">
          <legend class="form-label">Topic</legend>
          <div class="topic-options">
            {['General question', 'Founder license', 'Bug report', 'Feature idea', 'Something else'].map((topic, i) => (
              <label class="topic-option">
                <input type="radio" name="topic" value={topic} checked={i === 0} />
                <span>{topic}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="form-field">
          <span class="form-label">Message</span>
          <textarea name="message" rows="5" placeholder="What are you building?" required></textarea>
        </label>

        <button type="submit" class="submit-button">Send message</button>
        <p class="form-note">This form sends via Netlify. A copy also goes to hello@basalio.com.</p>
      </form>
    </div>
  </HeaderSplit>

  <!-- RESOURCES SECTION -->
  <section class="resources-section">
    <div class="resources-container">
      <h2 class="resources-heading">Need help right now?</h2>
      <p class="resources-description">Browse our resources or connect with the community.</p>

      <div class="resources-grid">
        <div class="resource-card">
          <h3 class="resource-title">FAQ</h3>
          <p class="resource-description">Answers to common questions about setup, customization, and pricing.</p>
          <a href="/pricing/#faq" class="resource-link">View FAQ →</a>
        </div>

        <div class="resource-card">
          <h3 class="resource-title">GitHub community</h3>
          <p class="resource-description">Report bugs, request features, and share your implementations.</p>
          <a href={socialLinks.github} class="resource-link" target="_blank" rel="noopener noreferrer">Join on GitHub →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER: Reused from homepage -->
  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>

<style>
  /* HERO + FORM SECTION (2-COLUMN LAYOUT) */
  .contact-form-wrapper {
    width: 100%;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .honeypot {
    display: none;
  }

  .form-row {
    display: flex;
    flex-direction: row;
    gap: 16px;
  }

  .form-row .form-field {
    flex: 1;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: none;
  }

  .form-label {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: var(--font-weight-medium);
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .form-field input[type="text"],
  .form-field input[type="email"],
  .form-field textarea {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: var(--font-weight-normal);
    color: var(--text-on-paper);
    background: var(--surface-alt);
    border: 1px solid var(--surface-alt);
    padding: 12px 16px;
    border-radius: 6px;
    box-sizing: border-box;
    outline: none;
    transition: background-color 200ms ease, border-color 200ms ease;
    width: 100%;
  }

  .form-field input[type="text"]:focus,
  .form-field input[type="email"]:focus,
  .form-field textarea:focus {
    background: var(--surface-paper);
    border-color: var(--text-on-paper);
  }

  .form-field input[type="text"]::placeholder,
  .form-field input[type="email"]::placeholder,
  .form-field textarea::placeholder {
    color: var(--text-on-paper-muted);
  }

  .form-field textarea {
    min-height: 140px;
    resize: vertical;
  }

  /* TOPIC RADIO OPTIONS */
  .topic-options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .topic-option {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: var(--font-weight-normal);
    color: var(--text-on-paper);
    background: var(--surface-alt);
    border: 1px solid var(--surface-alt);
    border-radius: 6px;
    padding: 10px 14px;
    cursor: pointer;
    transition: background-color 200ms ease, border-color 200ms ease;
  }

  .topic-option:hover {
    background: var(--surface-paper);
    border-color: var(--text-on-paper-muted);
  }

  .topic-option input[type="radio"] {
    margin: 0;
    accent-color: var(--text-on-paper);
  }

  /* SUBMIT BUTTON */
  .submit-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: var(--surface-paper);
    background: var(--text-on-paper);
    border: 1px solid var(--text-on-paper);
    border-radius: 6px;
    padding: 16px 28px;
    cursor: pointer;
    transition: color 200ms ease, background-color 200ms ease, border-color 200ms ease;
  }

  .submit-button:hover {
    color: var(--text-on-paper);
    background: transparent;
  }

  .form-note {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: var(--font-weight-normal);
    line-height: 18px;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
  }

  /* RESOURCES SECTION */
  .resources-section {
    width: 100%;
    padding: 0 40px 160px 40px;
    background: var(--surface-paper);
    box-sizing: border-box;
  }

  .resources-container {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
  }

  .resources-heading {
    font-family: var(--font-sans);
    font-size: 32px;
    font-weight: var(--font-weight-normal);
    letter-spacing: var(--heading-letter-spacing);
    line-height: 1.2;
    color: var(--text-on-paper);
    margin: 0 0 12px 0;
    padding: 0;
  }

  .resources-description {
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-normal);
    line-height: 24px;
    color: var(--text-on-paper-muted);
    margin: 0 0 40px 0;
    padding: 0;
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .resource-card {
    padding: 24px;
    background: var(--surface-alt);
    border: 1px solid var(--surface-alt);
    border-radius: 8px;
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .resource-card:hover {
    border-color: var(--stone);
    transform: translateY(-2px);
  }

  .resource-card .resource-title {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: var(--font-weight-medium);
    color: var(--text-on-paper);
    margin: 0 0 8px 0;
    padding: 0;
  }

  .resource-card .resource-description {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: var(--font-weight-normal);
    line-height: 20px;
    color: var(--text-on-paper-muted);
    margin: 0 0 16px 0;
    padding: 0;
  }

  .resource-link {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: var(--font-weight-medium);
    color: var(--text-on-paper);
    display: inline-block;
    padding: 8px 0;
    min-height: 24px;
    text-decoration: none;
    border-bottom: 1px solid var(--stone);
    transition: color 200ms ease, border-color 200ms ease;
  }

  .resource-link:hover {
    color: var(--text-on-paper-muted);
    border-color: var(--text-on-paper);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .resources-section {
      padding: 0 30px 120px 30px;
    }

    .resources-heading {
      font-size: 28px;
    }

    .form-row {
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .resources-section {
      padding: 0 20px 100px 20px;
    }

    .resources-heading {
      font-size: 24px;
    }

    .resources-description,
    .resource-card .resource-description {
      font-size: 14px;
      line-height: 22px;
    }

    .topic-options {
      gap: 8px;
    }

    .topic-option {
      padding: 8px 12px;
    }

    .submit-button {
      width: 100%;
    }
  }

  /* WCAG 1.4.10 REFLOW: Below 375px, constrain copy to container */
  @media (max-width: 374px) {
    .resources-section {
      padding: 0 20px 100px 20px;
    }
  }
</style>
