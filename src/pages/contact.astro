---
// Contact Page - Get in touch with Basalio

import BaseLayout from '../layouts/BaseLayout.astro';
import RampHeader from '../components/RampHeader.astro';
import RampFooter from '../components/RampFooter.astro';
import { socialLinks } from '../data/navigation';

const title = "Contact Basalio";
const description = "Get in touch with Basalio. Submit a message and we'll get back to you within 24 hours.";
---

<BaseLayout title={title} description={description}>
  <!-- HEADER: Navigation bar -->
  <Fragment slot="header">
    <RampHeader />
  </Fragment>

  <!-- HERO + FORM SECTION (2-COLUMN LAYOUT) -->
  <section class="hero-form-section">
    <!-- LEFT COLUMN: Header & Copy -->
    <div class="hero-column">
      <div class="hero-label">GET IN TOUCH</div>
      <h1 class="hero-heading">Questions? We're here to help.</h1>
      <p class="hero-description">We typically respond within 24 hours. For urgent issues,<br />check our documentation or community.</p>

      <!-- FOLLOW US SECTION -->
      <div class="follow-us-section">
        <h2 class="follow-us-heading">Follow us</h2>
        <p class="follow-us-description">Stay updated with news, tips, and updates.</p>
      </div>

      <!-- SOCIAL LINKS -->
      <div class="social-links-inline">
        <a href={socialLinks.twitter} class="social-link" target="_blank" rel="noopener">Twitter</a>
        <a href={socialLinks.github} class="social-link" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>

    <!-- RIGHT COLUMN: Form -->
    <div class="form-column">
      <form class="contact-form" id="contact-form">
        <!-- Name Field -->
        <div class="form-group">
          <label class="form-label">Name</label>
          <input type="text" name="name" placeholder="Your name" class="form-input" required />
        </div>

        <!-- Email Field -->
        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" name="email" placeholder="you@company.com" class="form-input" required />
        </div>

        <!-- Company Field (Optional) -->
        <div class="form-group">
          <label class="form-label">Company (optional)</label>
          <input type="text" name="company" placeholder="Your company" class="form-input" />
        </div>

        <!-- Inquiry Type -->
        <div class="form-group">
          <label class="form-label">Inquiry Type</label>
          <select name="inquiry-type" class="form-input" required>
            <option value="">Select a type...</option>
            <option value="sales">Sales inquiry</option>
            <option value="support">Technical support</option>
            <option value="partnership">Partnership</option>
            <option value="bug">Bug report</option>
            <option value="feature">Feature request</option>
            <option value="other">Other</option>
          </select>
        </div>

        <!-- Message Field -->
        <div class="form-group">
          <label class="form-label">Message</label>
          <textarea name="message" placeholder="Tell us what's on your mind..." class="form-textarea" required></textarea>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="submit-button">SEND MESSAGE</button>
      </form>
    </div>
  </section>

  <!-- RESOURCES SECTION -->
  <section class="resources-section">
    <div class="resources-container">
      <h2 class="resources-heading">Need help right now?</h2>
      <p class="resources-description">Browse our resources or connect with our community.</p>

      <div class="resources-grid">
        <!-- FAQ -->
        <div class="resource-card">
          <h3 class="resource-title">FAQ</h3>
          <p class="resource-description">Answers to common questions about setup, customization, and pricing.</p>
          <a href="#faq" class="resource-link">View FAQ →</a>
        </div>

        <!-- Community -->
        <div class="resource-card">
          <h3 class="resource-title">Community</h3>
          <p class="resource-description">Connect with other Basalio users and share your implementations.</p>
          <a href={socialLinks.github} class="resource-link">Join on GitHub →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- FOOTER: Reused from homepage -->
  <Fragment slot="footer">
    <RampFooter />
  </Fragment>
</BaseLayout>

<style>
  /* HERO + FORM SECTION (2-COLUMN LAYOUT) */
  .hero-form-section {
    display: grid;
    grid-template-columns: 35% 65%;
    width: 100%;
    max-width: 1786px;
    padding: 120px 40px;
    background: #FFFFFF;
    box-sizing: border-box;
    gap: 60px;
    margin: 0 auto;
    align-items: flex-start;
  }

  .hero-column {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 450px;
  }

  .form-column {
    display: flex;
    flex-direction: column;
    max-width: 500px;
  }

  .hero-label {
    background-color: #FFED00;
    color: #000000;
    font-family: 'Azeret Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    padding: 8px 12px;
    display: inline-block;
    width: fit-content;
  }

  .hero-heading {
    font-family: Switzer, sans-serif;
    font-size: 48px;
    font-weight: 400;
    letter-spacing: -0.96px;
    line-height: 52.8px;
    color: #000000;
    margin: 0;
    padding: 0;
    text-wrap: balance;
    max-width: 600px;
  }

  .hero-description {
    font-family: Switzer, sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #575757;
    margin: 0;
    padding: 0;
    max-width: 600px;
  }


  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-family: Switzer, sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #000000;
    margin: 0;
    padding: 0;
  }

  .form-input,
  .form-textarea {
    font-family: Switzer, sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #000000;
    background: #F5F5F5;
    border: 1px solid #E8E8E8;
    padding: 12px 16px;
    border-radius: 6px;
    box-sizing: border-box;
    outline: none;
    transition: all 200ms ease;
  }

  .form-input:focus,
  .form-textarea:focus {
    background: #FFFFFF;
    border-color: #000000;
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: #888888;
  }

  .form-textarea {
    min-height: 160px;
    resize: vertical;
  }

  .submit-button {
    font-family: 'Azeret Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: #FFFFFF;
    background: #000000;
    border: none;
    padding: 14px 28px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 200ms ease;
    align-self: flex-start;
  }

  .submit-button:hover {
    background: #333333;
  }

  .submit-button:active {
    transform: scale(0.98);
  }

  /* RESOURCES SECTION */
  .resources-section {
    display: flex;
    width: 100%;
    max-width: 1786px;
    padding: 80px 40px 200px 40px;
    background: #FFFFFF;
    box-sizing: border-box;
    margin: 0 auto;
    justify-content: flex-start;
    border-bottom-left-radius: 40px;
    border-bottom-right-radius: 40px;
    position: relative;
    z-index: 2;
    margin-bottom: -40px;
  }

  .resources-container {
    width: 100%;
  }

  .resources-heading {
    font-family: Switzer, sans-serif;
    font-size: 32px;
    font-weight: 400;
    letter-spacing: -0.64px;
    line-height: 38.4px;
    color: #000000;
    margin: 0 0 12px 0;
    padding: 0;
  }

  .resources-description {
    font-family: Switzer, sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #575757;
    margin: 0 0 40px 0;
    padding: 0;
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .resource-card {
    padding: 24px;
    background: #F9F9F9;
    border: 1px solid #E8E8E8;
    border-radius: 8px;
    transition: all 200ms ease;
  }

  .resource-card:hover {
    background: #F5F5F5;
    border-color: #D0D0D0;
  }

  .resource-card .resource-title {
    font-family: Switzer, sans-serif;
    font-size: 18px;
    font-weight: 500;
    color: #000000;
    margin: 0 0 8px 0;
    padding: 0;
  }

  .resource-card .resource-description {
    font-family: Switzer, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    color: #666666;
    margin: 0 0 16px 0;
    padding: 0;
  }

  .resource-link {
    font-family: Switzer, sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #000000;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .resource-link:hover {
    color: #666666;
  }

  /* FOLLOW US SECTION IN HERO COLUMN */
  .follow-us-section {
    margin-top: 40px;
  }

  .follow-us-heading {
    font-family: Switzer, sans-serif;
    font-size: 24px;
    font-weight: 400;
    letter-spacing: -0.48px;
    line-height: 28.8px;
    color: #000000;
    margin: 0 0 8px 0;
    padding: 0;
  }

  .follow-us-description {
    font-family: Switzer, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    color: #575757;
    margin: 0 0 16px 0;
    padding: 0;
  }

  /* INLINE SOCIAL LINKS */
  .social-links-inline {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .social-link {
    font-family: Switzer, sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: #000000;
    text-decoration: none;
    padding: 8px 0;
    border-bottom: 2px solid transparent;
    transition: border-color 200ms ease;
  }

  .social-link:hover {
    border-bottom-color: #000000;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-form-section {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 60px 20px;
    }

    .hero-heading {
      font-size: 36px;
      line-height: 43.2px;
    }

    .resources-section {
      padding: 60px 20px 200px 20px;
    }

    .resources-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .hero-form-section {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 40px 20px;
    }

    .hero-heading {
      font-size: 28px;
      line-height: 33.6px;
    }

    .resources-section {
      padding: 40px 20px 200px 20px;
    }

    .resources-heading {
      font-size: 24px;
      line-height: 28.8px;
    }

    .resources-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .social-links {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>

<script>
  // Form submission handler
  const form = document.getElementById('contact-form');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = {
        name: formData.get('name'),
        email: formData.get('email'),
        company: formData.get('company'),
        inquiryType: formData.get('inquiry-type'),
        message: formData.get('message'),
        submittedAt: new Date().toISOString()
      };

      // For now, just log and show success
      console.log('Form submission:', data);
      alert('Thank you for your message! We will get back to you shortly.');
      form.reset();
    });
  }
</script>
