---
// Contact Page - Get in touch with Basalio

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeaderSplit from '../components/patterns/HeaderSplit.astro';
import Button from '../components/Button.astro';
import { socialLinks } from '../data/navigation';

const title = "Contact Basalio";
const description = "Get in touch with Basalio. Submit a message and we'll get back to you within 24 hours.";
---

<BaseLayout title={title} description={description}>
  <!-- HEADER: Navigation bar -->
  <Fragment slot="header">
    <Header />
  </Fragment>

  <!-- HERO + FORM SECTION: HeaderSplit with form in right slot -->
  <HeaderSplit
    eyebrow="GET IN TOUCH"
    heading="Questions? We're here to help."
    body="We typically respond within 24 hours. For urgent issues, check our documentation or community."
    level="h1"
    surface="paper"
  >
    <div class="contact-form-wrapper">
      <form class="contact-form" id="contact-form">
        <!-- Name Field -->
        <div class="form-group">
          <label class="form-label">Name</label>
          <input type="text" name="name" placeholder="Your name" class="form-input" required />
        </div>

        <!-- Email Field -->
        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" name="email" placeholder="you@company.com" class="form-input" required />
        </div>

        <!-- Company Field (Optional) -->
        <div class="form-group">
          <label class="form-label">Company (optional)</label>
          <input type="text" name="company" placeholder="Your company" class="form-input" />
        </div>

        <!-- Inquiry Type -->
        <div class="form-group">
          <label class="form-label">Inquiry Type</label>
          <select name="inquiry-type" class="form-input" required>
            <option value="">Select a type...</option>
            <option value="sales">Sales inquiry</option>
            <option value="support">Technical support</option>
            <option value="partnership">Partnership</option>
            <option value="bug">Bug report</option>
            <option value="feature">Feature request</option>
            <option value="other">Other</option>
          </select>
        </div>

        <!-- Message Field -->
        <div class="form-group">
          <label class="form-label">Message</label>
          <textarea name="message" placeholder="Tell us what's on your mind..." class="form-textarea" required></textarea>
        </div>

        <!-- Submit Button -->
        <Button type="submit" label="SEND MESSAGE" variant="ink" fontSize="12px" fontWeight="500" letterSpacing="2.8px" />
      </form>
    </div>
  </HeaderSplit>

  <!-- RESOURCES SECTION -->
  <section class="resources-section">
    <div class="resources-container">
      <h2 class="resources-heading">Need help right now?</h2>
      <p class="resources-description">Browse our resources or connect with our community.</p>

      <div class="resources-grid">
        <!-- FAQ -->
        <div class="resource-card">
          <h3 class="resource-title">FAQ</h3>
          <p class="resource-description">Answers to common questions about setup, customization, and pricing.</p>
          <a href="#faq" class="resource-link">View FAQ →</a>
        </div>

        <!-- Community -->
        <div class="resource-card">
          <h3 class="resource-title">Community</h3>
          <p class="resource-description">Connect with other Basalio users and share your implementations.</p>
          <a href={socialLinks.github} class="resource-link">Join on GitHub →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- FOOTER: Reused from homepage -->
  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>

<style>
  /* HERO + FORM SECTION (2-COLUMN LAYOUT) */
  .contact-form-wrapper {
    width: 100%;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .form-input,
  .form-textarea {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    color: var(--text-on-paper);
    background: var(--surface-alt);
    border: 1px solid var(--surface-alt);
    padding: 12px 16px;
    border-radius: 6px;
    box-sizing: border-box;
    outline: none;
    transition: all 200ms ease;
  }

  .form-input:focus,
  .form-textarea:focus {
    background: var(--surface-paper);
    border-color: var(--text-on-paper);
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: var(--text-on-paper-muted);
  }

  .form-textarea {
    min-height: 160px;
    resize: vertical;
  }

  /* RESOURCES SECTION */
  .resources-section {
    display: flex;
    width: 100%;
    max-width: 1786px;
    padding: 80px 40px 200px 40px;
    background: var(--surface-paper);
    box-sizing: border-box;
    margin: 0 auto;
    justify-content: flex-start;
  }

  .resources-container {
    width: 100%;
  }

  .resources-heading {
    font-family: var(--font-sans);
    font-size: 32px;
    font-weight: 400;
    letter-spacing: -0.64px;
    line-height: 38.4px;
    color: var(--text-on-paper);
    margin: 0 0 12px 0;
    padding: 0;
  }

  .resources-description {
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
    font-weight: 400;
    line-height: 24px;
    color: var(--text-on-paper-muted);
    margin: 0 0 40px 0;
    padding: 0;
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .resource-card {
    padding: 24px;
    background: var(--surface-alt);
    border: 1px solid var(--surface-alt);
    border-radius: 8px;
    transition: all 200ms ease;
  }

  .resource-card:hover {
    background: var(--surface-alt);
    border-color: var(--stone);
  }

  .resource-card .resource-title {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 500;
    color: var(--text-on-paper);
    margin: 0 0 8px 0;
    padding: 0;
  }

  .resource-card .resource-description {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    color: var(--text-on-paper-muted);
    margin: 0 0 16px 0;
    padding: 0;
  }

  .resource-link {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-on-paper);
    display: block;
    padding: 8px 0;
    min-height: 24px;
    transition: color 200ms ease;
  }

  .resource-link:hover {
    color: var(--text-on-paper-muted);
  }

  /* FOLLOW US SECTION IN HERO COLUMN */
  .follow-us-section {
    margin-top: 40px;
  }

  .follow-us-heading {
    font-family: var(--font-sans);
    font-size: 24px;
    font-weight: 400;
    letter-spacing: -0.48px;
    line-height: 28.8px;
    color: var(--text-on-paper);
    margin: 0 0 8px 0;
    padding: 0;
  }

  .follow-us-description {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    color: var(--text-on-paper-muted);
    margin: 0 0 16px 0;
    padding: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-form-section {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 60px 20px;
    }

    .hero-heading {
      font-size: 36px;
      line-height: 43.2px;
    }

    .resources-section {
      padding: 60px 20px 200px 20px;
    }

    .resources-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .hero-form-section {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 40px 20px;
    }

    .hero-heading {
      font-size: 28px;
      line-height: 33.6px;
    }

    .resources-section {
      padding: 40px 20px 200px 20px;
    }

    .resources-heading {
      font-size: 24px;
      line-height: 28.8px;
    }

    .resources-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>

<script>
  // Form submission handler
  const form = document.getElementById('contact-form');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = {
        name: formData.get('name'),
        email: formData.get('email'),
        company: formData.get('company'),
        inquiryType: formData.get('inquiry-type'),
        message: formData.get('message'),
        submittedAt: new Date().toISOString()
      };

      // For now, just log and show success
      console.log('Form submission:', data);
      alert('Thank you for your message! We will get back to you shortly.');
      form.reset();
    });
  }
</script>
