---
// Contact Page - Get in touch with Basalio

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Contact Basalio";
const description = "Get in touch with Basalio. Submit a message and we'll get back to you within 48 hours.";
---

<BaseLayout title={title} description={description}>
  <!-- HEADER: Navigation bar -->
  <Fragment slot="header">
    <Header />
  </Fragment>

  <!-- CONTACT SECTION: Copy left, form right -->
  <section class="contact-section">
    <div class="contact-inner">
      <div class="contact-copy">
        <p class="contact-eyebrow">Contact</p>
        <h1 class="contact-heading">A direct line to the person building it.</h1>
        <p class="contact-body">Basalio is a one-person studio. No support tickets disappearing into a queue. Your message lands in the inbox of the developer who wrote the block you are asking about.</p>
        <ul class="contact-highlights">
          <li><strong>Response time</strong>Usually within 48 hours, CET</li>
          <li><strong>Founder licenses</strong>Refundable until the control center ships</li>
          <li><strong>Bug reports</strong>Include your WordPress + PHP versions</li>
        </ul>
      </div>

      <form
        name="contact"
        method="POST"
        action="/welcome/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="contact-form"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <div class="form-row">
          <label class="form-field">
            <span class="form-label">Name</span>
            <input type="text" name="name" placeholder="Your name" required />
          </label>
          <label class="form-field">
            <span class="form-label">Email</span>
            <input type="email" name="email" placeholder="you@studio.com" required />
          </label>
        </div>

        <fieldset class="form-field">
          <legend class="form-label">Topic</legend>
          <div class="topic-options">
            {['General question', 'Founder license', 'Bug report', 'Feature idea', 'Something else'].map((topic, i) => (
              <label class="topic-option">
                <input type="radio" name="topic" value={topic} checked={i === 0} />
                <span>{topic}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="form-field">
          <span class="form-label">Message</span>
          <textarea name="message" rows="5" placeholder="What are you building?" required></textarea>
        </label>

        <button type="submit" class="submit-button">Send message</button>
        <p class="form-note">This form sends via Netlify. A copy also goes to hello@basalio.com.</p>
      </form>
    </div>
  </section>

  <!-- FOOTER: Reused from homepage -->
  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>

<style>
  /* CONTACT SECTION (2-COLUMN LAYOUT) */
  .contact-section {
    width: 100%;
    padding: 200px 40px 120px 40px;
    background: var(--surface-paper);
    box-sizing: border-box;
  }

  .contact-inner {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    gap: 80px;
    box-sizing: border-box;
  }

  /* LEFT COLUMN: Copy */
  .contact-copy {
    flex: 0 1 32%;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-eyebrow {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: var(--font-weight-medium);
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
    line-height: 1.6;
  }

  .contact-heading {
    font-family: var(--font-sans);
    font-size: 40px;
    font-weight: var(--font-weight-normal);
    line-height: 48px;
    letter-spacing: var(--heading-letter-spacing);
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .contact-body {
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-normal);
    line-height: 24px;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
  }

  .contact-highlights {
    display: flex;
    flex-direction: column;
    gap: 12px;
    list-style: none;
    margin: 20px 0 0 0;
    padding: 0;
  }

  .contact-highlights li {
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-normal);
    line-height: 24px;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
  }

  .contact-highlights li strong {
    display: block;
    font-weight: var(--font-weight-medium);
    color: var(--text-on-paper);
    margin-bottom: 2px;
  }

  /* RIGHT COLUMN: Form */
  .contact-form {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }

  .hidden {
    display: none;
  }

  .form-row {
    display: flex;
    flex-direction: row;
    gap: 16px;
  }

  .form-row .form-field {
    flex: 1;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: none;
  }

  .form-label {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: var(--font-weight-medium);
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .form-field input[type="text"],
  .form-field input[type="email"],
  .form-field textarea {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: var(--font-weight-normal);
    color: var(--text-on-paper);
    background: var(--surface-alt);
    border: 1px solid var(--surface-alt);
    padding: 12px 16px;
    border-radius: 6px;
    box-sizing: border-box;
    outline: none;
    transition: background-color 200ms ease, border-color 200ms ease;
    width: 100%;
  }

  .form-field input[type="text"]:focus,
  .form-field input[type="email"]:focus,
  .form-field textarea:focus {
    background: var(--surface-paper);
    border-color: var(--text-on-paper);
  }

  .form-field input[type="text"]::placeholder,
  .form-field input[type="email"]::placeholder,
  .form-field textarea::placeholder {
    color: var(--text-on-paper-muted);
  }

  .form-field textarea {
    min-height: 140px;
    resize: vertical;
  }

  /* TOPIC RADIO OPTIONS */
  .topic-options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .topic-option {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: var(--font-weight-normal);
    color: var(--text-on-paper);
    background: var(--surface-alt);
    border: 1px solid var(--surface-alt);
    border-radius: 6px;
    padding: 10px 14px;
    cursor: pointer;
    transition: background-color 200ms ease, border-color 200ms ease;
  }

  .topic-option:hover {
    background: var(--surface-paper);
    border-color: var(--text-on-paper-muted);
  }

  .topic-option input[type="radio"] {
    margin: 0;
    accent-color: var(--text-on-paper);
  }

  /* SUBMIT BUTTON */
  .submit-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: var(--surface-paper);
    background: var(--text-on-paper);
    border: 1px solid var(--text-on-paper);
    border-radius: 6px;
    padding: 16px 28px;
    cursor: pointer;
    transition: color 200ms ease, background-color 200ms ease, border-color 200ms ease;
  }

  .submit-button:hover {
    color: var(--text-on-paper);
    background: transparent;
  }

  .form-note {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: var(--font-weight-normal);
    line-height: 18px;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .contact-section {
      padding: 160px 30px 100px 30px;
    }

    .contact-inner {
      flex-direction: column;
      gap: 50px;
    }

    .contact-copy {
      flex: 1 1 100%;
    }

    .contact-heading {
      font-size: 32px;
      line-height: 40px;
    }
  }

  @media (max-width: 640px) {
    .contact-section {
      padding: 120px 20px 80px 20px;
    }

    .contact-inner {
      gap: 40px;
    }

    .contact-eyebrow {
      font-size: 12px;
      letter-spacing: 2.4px;
    }

    .contact-heading {
      font-size: 28px;
      line-height: 34px;
    }

    .contact-body,
    .contact-highlights li {
      font-size: 14px;
      line-height: 22px;
    }

    .form-row {
      flex-direction: column;
    }

    .topic-options {
      gap: 8px;
    }

    .topic-option {
      padding: 8px 12px;
    }

    .submit-button {
      width: 100%;
    }
  }

  /* WCAG 1.4.10 REFLOW: Below 375px, constrain copy to container */
  @media (max-width: 374px) {
    .contact-inner {
      padding: 0;
    }

    .contact-copy {
      flex-basis: 100%;
      max-width: 100%;
    }
  }
</style>
