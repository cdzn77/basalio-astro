---
// Modules Page - All 9 interaction modules for WordPress portfolios
// Reuses Nav, Testimonials, Footer from homepage

import RampTemplateLayout from '../layouts/RampTemplateLayout.astro';
import RampHeader from '../components/RampHeader.astro';
import RampTestimonialsV2 from '../components/RampTestimonialsV2.astro';
import RampFooter from '../components/RampFooter.astro';

const title = "Modules - Basalio";
const description = "Nine curated interaction modules built for WordPress portfolios. Grid reveals, case study transitions, scroll sequences, and more.";

const modules = [
  {
    title: "Grid Reveal",
    description: "Reveal content in a cascading grid pattern as users scroll down the page",
    tag: "Layout Module",
    slug: "grid-reveal"
  },
  {
    title: "Case Study Transition",
    description: "Smooth transitions between case studies with parallax and fade effects",
    tag: "Navigation Module",
    slug: "case-study-transition"
  },
  {
    title: "Scroll Sequence",
    description: "Trigger animations based on scroll position for synchronized storytelling",
    tag: "Animation Module",
    slug: "scroll-sequence"
  },
  {
    title: "Image Counter",
    description: "Animate numerical counters that respond to viewport interactions",
    tag: "Interaction Module",
    slug: "image-counter"
  },
  {
    title: "Timeline",
    description: "Interactive timeline component for process documentation and milestones",
    tag: "Content Module",
    slug: "timeline"
  },
  {
    title: "Image Carousel",
    description: "Responsive carousel for showcasing multiple images with smooth transitions",
    tag: "Gallery Module",
    slug: "image-carousel"
  },
  {
    title: "Fullscreen Video",
    description: "Full-width video player with autoplay and custom controls for portfolio reels",
    tag: "Media Module",
    slug: "fullscreen-video"
  },
  {
    title: "Smooth Scroll",
    description: "Custom scroll behavior with easing and anchor linking for polished navigation",
    tag: "Navigation Module",
    slug: "smooth-scroll"
  },
  {
    title: "Hover Effects",
    description: "Advanced hover states and interactive feedback for all interactive elements",
    tag: "Interaction Module",
    slug: "hover-effects"
  }
];

// Split description text into words for per-word animation
const descriptionWords = description.split(' ');
---

<RampTemplateLayout title={title} description={description}>
  <!-- HEADER: Navigation bar -->
  <Fragment slot="header">
    <RampHeader />
  </Fragment>

  <!-- HERO SECTION: Left sidebar (dot + label) + Right (description) -->
  <section class="courses-hero">
    <!-- LEFT SIDEBAR: Dot indicator + "OUR MODULES" label -->
    <div class="hero-left">
      <div class="dot-indicator" aria-hidden="true"></div>
      <p class="courses-label">OUR MODULES</p>
    </div>

    <!-- RIGHT: Description with per-word spans -->
    <div class="hero-right">
      <p class="hero-description">
        {descriptionWords.map((word, index) => (
          <span key={index} class="word-span" style={`--word-index: ${index}`}>
            {word}
          </span>
        ))}
      </p>
    </div>
  </section>

  <!-- MODULES GRID -->
  <section class="courses-grid-section">
    <div class="courses-grid">
      {modules.map((module, index) => {
        const imageMap = [
          'course-1.png',
          'course-2.png',
          'course-3.png',
          'course-4.png',
          'course-1.png',
          'course-2.png',
          'course-3.png',
          'course-4.png',
          'course-1.png'
        ];
        return (
        <div class={`course-card ${index >= 9 ? 'hidden-course' : ''}`}>
          <!-- Module Image Placeholder -->
          <div class="course-image-placeholder">
            <img
              src={`/assets/${imageMap[index]}`}
              alt={module.title}
              class="course-image"
            />
          </div>

          <!-- Module Info -->
          <div class="course-info">
            <a href={`/modules/${module.slug}`} class="course-link">
              <h2 class="course-title">{module.title}</h2>
              <p class="course-description">{module.description}</p>
            </a>

            <!-- Tag Pill -->
            <a href={`/modules/${module.slug}`} class="course-tag">{module.tag}</a>
          </div>
        </div>
      );
      })}
    </div>
  </section>

  <!-- TESTIMONIALS SECTION: From homepage -->
  <section class="testimonials-rounded">
    <RampTestimonialsV2
      sectionHeading={"Built for people who\nactually make things."}
      testimonials={[
        {
          image: "/assets/uxui_whoitsfor.png",
          quote: "I stopped explaining hover states to developers. I just build them.",
          name: "UX/UI Designer",
          results: "No handoff docs needed"
        },
        {
          image: "/assets/videographer_whoitsfor.png",
          quote: "My reel finally scrolls the way it plays - frame by frame, not just fading in.",
          name: "Videographer",
          results: "Scroll Sequence, no video embed"
        },
        {
          image: "/assets/director_whoitsfor.png",
          quote: "Case studies that morph from the grid instead of just... linking to a new page.",
          name: "Director",
          results: "One shared-element transition, zero page reload"
        },
        {
          image: "/assets/agency_whoitsfor.png",
          quote: "Every client site gets the same polish - without rebuilding it every time.",
          name: "Agency",
          results: "Nine blocks, unlimited client sites"
        }
      ]}
    />
  </section>

  <!-- FOOTER: Reused from homepage -->
  <Fragment slot="footer">
    <RampFooter address="Østerbrogade 45, 2100 København Ø, Copenhagen, Denmark" />
  </Fragment>
</RampTemplateLayout>

<style>
  /* HERO SECTION: 2-column layout (35% left + 65% right) */
  .courses-hero {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    padding: 120px 40px;
    padding-top: 120px;
    background: var(--basalio-paper, #FFFFFF);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    gap: 40px;
    margin: 0 auto;
    margin-top: 0;
  }

  /* LEFT SIDEBAR: Dot indicator + "OUR COURSES" label (35%) */
  .hero-left {
    flex: 0 1 35%;
    max-width: 35%;
    display: flex;
    flex-direction: row;
    gap: 20px;
    align-items: flex-start;
    padding-right: 40px;
  }

  .dot-indicator {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #FFEA00;
    flex: 0 0 auto;
    opacity: 0;
    transform: scale(0.5);
    animation: dotIndicatorIn 0.6s ease-out forwards;
  }

  @keyframes dotIndicatorIn {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .courses-label {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--basalio-ink, #000000);
    margin: 0;
    padding: 0;
    line-height: 1.6;
  }

  /* RIGHT: Description (65%) */
  .hero-right {
    flex: 0 1 65%;
    max-width: 65%;
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }

  .hero-description {
    font-size: 48px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--basalio-ink, #000000);
    margin: 0;
    padding: 0;
    width: 100%;
    word-wrap: break-word;
  }

  /* Per-word span animation */
  .word-span {
    display: inline-block;
    margin-right: 0.3em;
    opacity: 0;
    filter: blur(8px);
    /* Staggered animation: ~60-80ms per word (FLAGGED AS ESTIMATE - verify against live source) */
    animation: wordBlurIn 0.8s ease-out forwards;
    animation-delay: calc(var(--word-index) * 70ms);
  }

  @keyframes wordBlurIn {
    to {
      opacity: 1;
      filter: blur(0px);
    }
  }

  /* COURSES GRID SECTION: Full width container, content stays in right 65% */
  .courses-grid-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 80px 40px;
    background: var(--basalio-paper, #FFFFFF);
    width: 100%;
    max-width: 1792px;
    box-sizing: border-box;
    gap: 80px;
    overflow-x: hidden;
    margin: 0 auto;
    margin-left: auto;
    margin-right: 0;
    padding-left: calc(35% + 40px);
  }

  /* COURSES GRID: 2 columns, full width of right container */
  .courses-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 60px;
    width: 100%;
    overflow: hidden;
  }

  /* COURSE CARD */
  .course-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
    overflow: visible;
  }

  /* Hide courses 4-9 initially */
  .course-card.hidden-course {
    display: none;
  }

  /* Show courses when loaded */
  .courses-grid.loaded .course-card.hidden-course {
    display: flex;
  }

  /* Course Image Placeholder - Yellow background with black icon */
  .course-image-placeholder {
    width: 100%;
    aspect-ratio: 2/1;
    background: #FFEA00;
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .course-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 6px;
    transition: transform 300ms ease;
  }

  .course-card:hover .course-image {
    transform: scale(1.08);
  }

  .course-image:not([src]),
  .course-image[src=""] {
    display: none;
  }

  /* Course Info */
  .course-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .course-title {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--basalio-ink, #000000);
    margin: 0;
    padding: 0;
  }

  .course-description {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    color: rgb(87, 87, 87);
    margin: 0;
    padding: 0;
  }

  /* Course Link */
  .course-link {
    text-decoration: none;
    cursor: pointer;
    transition: opacity 200ms ease;
  }

  .course-link:hover {
    opacity: 0.8;
  }

  /* Tag Pill */
  .course-tag {
    display: inline-flex;
    width: fit-content;
    padding: 8px;
    background: rgba(0, 0, 0, 0.1);
    border-radius: 6px;
    font-family: "Azeret Mono", monospace;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2.8px;
    color: rgb(87, 87, 87);
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: all 200ms ease;
  }

  .course-tag:hover {
    background: rgb(87, 87, 87);
    color: #FFFFFF;
  }

  /* LOAD MORE BUTTON */
  .load-more-wrapper {
    display: flex;
    justify-content: flex-end;
    width: 100%;
    padding-right: 40px;
  }

  .load-more-button {
    padding: 14px 32px;
    background: rgb(235, 235, 235);
    border-radius: 6px;
    border: none;
    color: rgb(0, 0, 0);
    font-family: "Azeret Mono", monospace;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2.8px;
    line-height: 19.6px;
    text-align: start;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 200ms ease;
    -webkit-font-smoothing: antialiased;
  }


  .load-more-button:hover {
    opacity: 0.8;
  }

  .load-more-button:active {
    transform: scale(0.98);
  }

  /* Testimonials section: rounded bottom corners with footer overlap */
  .testimonials-rounded {
    border-bottom-left-radius: 40px;
    border-bottom-right-radius: 40px;
    overflow: visible;
    position: relative;
    z-index: 2;
    margin-bottom: -40px;
    padding-bottom: 200px;
    background: #FFFFFF;
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .courses-hero {
      flex-direction: column;
      gap: 40px;
      padding: 80px 20px;
    }

    .hero-left {
      flex: 0 0 auto;
    }

    .hero-description {
      font-size: 36px;
    }

    .courses-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media (max-width: 768px) {
    .courses-hero {
      flex-direction: column;
      gap: 40px;
      padding: 60px 20px;
    }

    .hero-left {
      flex: 0 0 auto;
    }

    .hero-description {
      font-size: 28px;
      line-height: 1.3;
    }

    .courses-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .courses-grid-section {
      padding: 60px 20px;
    }

    .course-title {
      font-size: 16px;
    }

    .course-description {
      font-size: 13px;
    }
  }
</style>

<script>
  // NAV BAR ENTRANCE ANIMATION
  // opacity: 0→1, y: -50→0, spring, 1000ms, bounce: 0, delay: 0
  const navHeader = document.querySelector('.ramp-header');
  if (navHeader) {
    navHeader.style.opacity = '0';
    navHeader.style.transform = 'translateY(-50px)';

    // Use CSS animation for spring effect
    navHeader.style.animation = 'navBarIn 1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards';
  }

  // MENU BUTTON LABEL ENTRANCE ANIMATION
  // opacity: 0→1, y: 10→0, spring, 600ms, bounce: 0, delay: 0
  // (Applied via CSS with .menu-label class if it exists in nav component)

  // Show all modules on load (no "Load More" button)
  const coursesGrid = document.querySelector('.courses-grid');
  if (coursesGrid) {
    coursesGrid.classList.add('loaded');
  }
</script>

<style>
  /* Spring animation for nav bar */
  @keyframes navBarIn {
    from {
      opacity: 0;
      transform: translateY(-50px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
