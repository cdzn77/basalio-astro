---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import RampFooter from '../components/RampFooter.astro';
import HeaderSplit from '../components/patterns/HeaderSplit.astro';
import Button from '../components/Button.astro';

const title = "Early Access - Basalio";
const description = "Get on the Basalio founder list. Nine blocks in testing, Pro control center in planning.";
---

<BaseLayout {title} {description}>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <!-- EARLY ACCESS: HeaderSplit with form in right slot -->
  <section class="early-access-section">
    <HeaderSplit
      eyebrow="EARLY ACCESS"
      heading="Get on the list."
      body="Basalio isn't on WordPress.org yet. The nine blocks are built and in testing; the Pro control center isn't started. When the free plugin lands, you'll be the first to know. If you want a founder license, say so below. The first 100 are $149, one payment, and the price goes up after that."
      surface="paper"
    >
    <div class="early-access-form-wrapper">
        <form name="early-access" method="POST" action="/welcome" data-netlify="true" data-netlify-honeypot="bot-field" class="early-access-form">
          <!-- Netlify form detection -->
          <input type="hidden" name="form-name" value="early-access" />

          <!-- Honeypot field (hidden) -->
          <div class="honeypot">
            <label for="bot-field">Don't fill this out if you're human:</label>
            <input id="bot-field" name="bot-field" type="text" />
          </div>

          <!-- Email Field -->
          <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <input
              id="email"
              type="email"
              name="email"
              placeholder="you@studio.com"
              required
              autocomplete="email"
              aria-describedby="email-hint"
              class="form-input"
            />
            <p id="email-hint" class="form-hint">We'll send you one email when the plugin ships, one if the founder price is about to change.</p>
          </div>

          <!-- Intent Fieldset (Radio Group) -->
          <fieldset class="form-fieldset">
            <legend class="form-legend">What are you here for?</legend>

            <div class="radio-group">
              <div class="radio-item">
                <input
                  id="intent-free"
                  type="radio"
                  name="intent"
                  value="Tell me when the free blocks land on WordPress.org"
                  required
                  class="radio-input"
                />
                <label for="intent-free" class="radio-label">Tell me when the free blocks land on WordPress.org</label>
              </div>

              <div class="radio-item">
                <input
                  id="intent-founder"
                  type="radio"
                  name="intent"
                  value="I want a founder license ($149, first 100)"
                  required
                  class="radio-input"
                />
                <label for="intent-founder" class="radio-label">I want a founder license ($149, first 100)</label>
              </div>
            </div>
          </fieldset>

          <!-- Submit Button -->
          <Button type="submit" label="Join the list →" variant="acid" fontSize="13px" fontWeight="600" letterSpacing="0.05em" />

          <!-- Disclaimer -->
          <p class="form-disclaimer">No spam. One email when the plugin ships, one if the founder price is about to change. Unsubscribe in every email.</p>
        </form>

        <!-- Success Message (hidden by default, shown via JS) -->
        <div id="form-success" class="form-success" role="status" aria-live="polite" style="display: none;">
          <p class="success-heading">You're on the list.</p>
          <p class="success-body">I'll email you when the plugin ships.</p>
        </div>
    </div>
    </HeaderSplit>
  </section>

  <Fragment slot="footer">
    <RampFooter hideNewsletter={true} />
  </Fragment>
</BaseLayout>


<style>
  .early-access-section {
    width: 100%;
    background: var(--surface-paper);
    padding: 80px 40px;
    box-sizing: border-box;
    padding-bottom: 200px;
  }

  .early-access-form-wrapper {
    width: 100%;
  }

  .early-access-form {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .honeypot {
    display: none;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
    display: block;
  }

  .form-input {
    width: 100%;
    padding: 12px 16px;
    min-height: 43.6px;
    background: var(--surface-paper);
    border: 1px solid var(--stone);
    border-radius: 8px;
    font-family: var(--font-mono-code);
    font-size: 14px;
    color: var(--text-on-paper);
    box-sizing: border-box;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--text-on-paper);
    box-shadow: 0 0 0 3px rgba(10, 10, 10, 0.05);
  }

  .form-input::placeholder {
    color: var(--text-on-paper-muted);
  }

  .form-hint {
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
  }

  .form-fieldset {
    border: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-legend {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
    display: block;
  }

  .radio-group {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .radio-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .radio-input {
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    margin-top: 2px;
    cursor: pointer;
    accent-color: var(--text-on-paper);
  }

  .radio-input:focus-visible {
    outline: 2px solid var(--text-on-paper);
    outline-offset: 2px;
  }

  .radio-label {
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-on-paper);
    cursor: pointer;
    margin: 0;
    padding: 0;
  }


  .form-disclaimer {
    font-size: 12px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
    text-align: center;
  }

  .form-success {
    padding: 32px 24px;
    background: rgba(10, 10, 10, 0.05);
    border-radius: 8px;
    text-align: center;
  }

  .success-heading {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-on-paper);
    margin: 0 0 12px 0;
    padding: 0;
  }

  .success-body {
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
  }

  @media (max-width: 1024px) {
    .early-access-inner {
      flex-direction: column;
      gap: 40px;
    }

    .early-access-left {
      flex: 0 0 auto;
    }

    .early-access-heading {
      font-size: 32px;
      line-height: 40px;
    }

    .early-access-body {
      font-size: 15px;
    }
  }

  @media (max-width: 768px) {
    .early-access-section {
      padding: 60px 20px;
    }

    .early-access-inner {
      flex-direction: column;
      gap: 40px;
    }

    .early-access-heading {
      font-size: 28px;
      line-height: 36px;
    }

    .early-access-body {
      font-size: 14px;
    }

    .early-access-form {
      gap: 24px;
    }

    .radio-item {
      gap: 10px;
    }
  }
</style>
