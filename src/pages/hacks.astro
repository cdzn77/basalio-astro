---
import { Fragment } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import RampHeader from '../components/RampHeader.astro';
import RampFooter from '../components/RampFooter.astro';

const title = "Hacks - Basalio";
const description = "Four free CSS/JS snippets you can paste into your site.";
---

<BaseLayout {title} {description}>
  <Fragment slot="header">
    <RampHeader />
  </Fragment>

  <section class="hacks-section section-with-footer-overlap">
    <div class="hacks-inner">
      <div class="hacks-left">
        <p class="hacks-eyebrow">HACKS</p>
        <h1 class="hacks-heading">Free is the recipe. Pro is the appliance.</h1>
        <p class="hacks-body">Four effects you can paste into your site right now. No plugin, no account, no email.</p>
      </div>

      <div class="hacks-right">
        <div class="hack-card">
          <h2>Reveal on Scroll</h2>
          <p>Fade in elements as the user scrolls</p>
          <pre><code>{{SNIPPET_PLACEHOLDER}}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <RampFooter description="Nine curated interaction blocks for WordPress portfolios. Nothing you'd need Framer for." address="Østerbrogade 45, 2100 København Ø, Copenhagen, Denmark" />
  </Fragment>
</BaseLayout>

<style>
  .hacks-section {
    width: 100%;
    background: var(--surface-paper);
    padding: 80px 40px;
    box-sizing: border-box;
  }

  .hacks-inner {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    max-width: 1786px;
    margin: 0 auto;
    gap: 60px;
    box-sizing: border-box;
  }

  .hacks-left {
    flex: 0 1 28%;
  }

  .hacks-right {
    flex: 1;
  }

  .hacks-eyebrow {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .hacks-heading {
    font-size: 40px;
    font-weight: 400;
    line-height: 48px;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .hacks-body {
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
  }

  .hack-card h2 {
    font-size: 28px;
    font-weight: 400;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .hack-card pre {
    margin: 0;
    padding: 20px;
    background: #F5F5F5;
    border-radius: 8px;
    overflow-x: auto;
  }
</style>
