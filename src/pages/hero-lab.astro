---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';

const title = 'Hero Lab - Type Performs';
const description = 'Two concepts: monumental reveal and the switch';
---

<BaseLayout {title} {description} noindex>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <!-- LAB BANNER: Warning that page-scoped CSS does not reproduce production cascade -->
  <div class="lab-banner">
    <p class="lab-banner-text">LAB — page-scoped CSS. Does not reproduce production cascade. Variants must be re-verified on / after promotion.</p>
  </div>

  <!-- H — MONUMENTAL REVEAL: Headline performs word-by-word -->
  <section class="hero-type hero-h" id="concept-h" data-surface="ink">
    <div class="hero-bg" style={{ backgroundColor: 'var(--surface-ink)' }}></div>

    <div class="hero-content">
      <p class="hero-eyebrow">A WORDPRESS PLUGIN FOR CREATIVES</p>

      <h1 class="hero-headline">
        <span class="word" style={{ '--word-index': 0 } as any}>Framer-quality</span>
        <span class="word" style={{ '--word-index': 1 } as any}>interactions,</span>
        <span class="word" style={{ '--word-index': 2 } as any}>native</span>
        <span class="word" style={{ '--word-index': 3 } as any}>to</span>
        <span class="word" style={{ '--word-index': 4 } as any}>WordPress.</span>
      </h1>

      <div class="hero-cta-wrapper">
        <Button label="Explore Blocks" href="/blocks" variant="acid" />
      </div>
    </div>

    <div class="concept-label">H MONUMENTAL REVEAL</div>
  </section>

  <!-- J — CURSOR SPOTLIGHT: Headline revealed by cursor movement -->
  <section class="hero-type hero-j" id="concept-j" data-surface="ink">
    <div class="hero-bg" style={{ backgroundColor: 'var(--surface-ink)' }}></div>

    <div class="hero-content">
      <p class="hero-eyebrow">A WORDPRESS PLUGIN FOR CREATIVES</p>

      <!-- Base headline: ink-on-ink, very low contrast -->
      <h1 class="hero-headline headline-base">
        <span class="word">Framer-quality</span>
        <span class="word">interactions,</span>
        <span class="word">native</span>
        <span class="word">to</span>
        <span class="word">WordPress.</span>
      </h1>

      <!-- Revealed headline: full contrast, masked by spotlight circle -->
      <h1 class="hero-headline headline-revealed" aria-hidden="true">
        <span class="word">Framer-quality</span>
        <span class="accent-word">interactions,</span>
        <span class="word">native</span>
        <span class="word">to</span>
        <span class="word">WordPress.</span>
      </h1>

      <div class="hero-cta-wrapper">
        <Button label="Explore Blocks" href="/blocks" variant="acid" />
      </div>
    </div>

    <div class="concept-label">J CURSOR SPOTLIGHT</div>
  </section>

  <!-- M — VIDEO BACKGROUND: Exact replica of index.astro hero, video background only -->
  <Hero
    eyebrow="A WORDPRESS PLUGIN FOR CREATIVES"
    teaserText="Give your work a foundation to stand on. Nine curated interaction blocks, from grid reveals to case-study transitions to scroll-tied sequences, built only for portfolio and case-study sites. Nothing you'd need Framer for. Nothing you don't."
    teaserButton="EXPLORE BLOCKS"
    teaserLink="/blocks"
    buttonVariant="acid"
    background={{ type: 'video', src: '/assets/basalio-hero.mp4', poster: '/assets/basalio-hero-poster.webp', scrim: 0 }}
    surface="ink"
  >
    <h1 class="hero-heading hero-headline" slot="heading">Framer-quality <span class="accent-word">interactions,</span><br/>native to WordPress.</h1>
  </Hero>

  <Fragment slot="footer">
    <Footer hideNewsletter={true} />
  </Fragment>
</BaseLayout>

<style>
  /* LAB BANNER */
  .lab-banner {
    width: 100%;
    background-color: var(--acid);
    padding: 16px 20px;
    text-align: center;
    position: fixed;
    top: 80px;
    left: 0;
    right: 0;
    z-index: 50;
    height: 48px;
  }

  /* Compensate for fixed header (80px) + banner (48px) — push all content below both */
  :global(body) {
    padding-top: 128px;
  }

  .lab-banner-text {
    font-family: 'Azeret Mono', monospace;
    font-size: 12px;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--surface-ink);
    margin: 0;
    padding: 0;
    line-height: 1.4;
  }

  /* SHARED STYLES */
  .hero-type {
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 80px 40px;
    box-sizing: border-box;
    overflow: hidden;
    z-index: 1;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 100vw;
  }

  .hero-eyebrow {
    font-family: 'Azeret Mono', monospace;
    font-size: 12px;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 40px 0;
    padding: 0;
    line-height: 1.4;
    color: var(--text-on-ink-muted);
    opacity: 0;
    animation: eyebrow-fade 600ms cubic-bezier(0.16, 1, 0.3, 1) 0ms forwards;
  }

  .hero-headline {
    font-family: var(--font-sans);
    font-size: clamp(40px, 12vw, 160px);
    font-weight: var(--font-weight-bold);
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin: 0 0 60px 0;
    padding: 0;
    color: var(--text-on-ink);
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em;
  }

  .word {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.4em);
    animation: word-reveal 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc((var(--word-index) * 90ms) + 100ms);
    will-change: transform, opacity;
  }

  /* Last word (interactions) in acid, arrives after all others */
  .word:nth-child(2) {
    color: var(--acid);
    animation-delay: calc((4 * 90ms) + 100ms);
  }

  @keyframes eyebrow-fade {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes word-reveal {
    0% {
      opacity: 0;
      transform: translateY(0.4em);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-cta-wrapper {
    opacity: 0;
    animation: cta-fade 600ms cubic-bezier(0.16, 1, 0.3, 1) 1300ms forwards;
  }

  @keyframes cta-fade {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  /* CONCEPT J: CURSOR SPOTLIGHT */
  .headline-base {
    position: relative;
    z-index: 1;
    /* Ink-on-ink: very low contrast using border token */
    color: var(--border-on-ink);
  }

  .headline-revealed {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--text-on-ink);
    z-index: 2;
    -webkit-mask-image: radial-gradient(circle 160px at 50% 50%, white 0%, transparent 100%);
    mask-image: radial-gradient(circle 160px at 50% 50%, white 0%, transparent 100%);
    -webkit-mask-position: 0 0;
    mask-position: 0 0;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    pointer-events: none;
    /* On-load sweep animation */
    animation: headline-sweep 2s ease-out forwards;
  }

  .headline-revealed.idle-return {
    animation: none;
    -webkit-mask-image: radial-gradient(circle 9999px at 50% 50%, white 0%, white 100%);
    mask-image: radial-gradient(circle 9999px at 50% 50%, white 0%, white 100%);
  }

  @keyframes headline-sweep {
    0% {
      -webkit-mask-position: -500px 0;
      mask-position: -500px 0;
    }
    100% {
      -webkit-mask-position: 50% 0;
      mask-position: 50% 0;
    }
  }

  .headline-revealed .accent-word {
    color: var(--acid);
  }

  /* Cursor spotlight interaction state */
  .hero-j.interactive .headline-revealed {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .headline-revealed {
      animation: none;
      -webkit-mask-image: radial-gradient(circle 9999px at 50% 50%, white 0%, white 100%);
      mask-image: radial-gradient(circle 9999px at 50% 50%, white 0%, white 100%);
      color: var(--text-on-ink);
    }
  }

  @media (pointer: coarse) {
    .headline-revealed {
      animation: none;
      -webkit-mask-image: radial-gradient(circle 9999px at 50% 50%, white 0%, white 100%);
      mask-image: radial-gradient(circle 9999px at 50% 50%, white 0%, white 100%);
    }
  }

  /* Reduced motion: show final state instantly */
  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow,
    .word,
    .hero-cta-wrapper {
      animation: none;
      opacity: 1;
      transform: translateY(0);
    }

    .opening-state {
      display: none;
    }

    .hero-i .revealed-state {
      animation: none;
      clip-path: inset(0);
    }

    .opening-text {
      animation: none;
    }
  }

  .concept-label {
    position: absolute;
    bottom: 40px;
    right: 40px;
    font-family: 'Azeret Mono', monospace;
    font-size: 11px;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.5;
    z-index: 11;
    color: var(--text-on-ink-muted);
  }

  /* Lab variant: Enlarged heading with clamp (page-scoped, does not reproduce production cascade) */
  h1.hero-heading.hero-headline {
    font-size: clamp(36px, 4.5vw, 72px);
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .hero-type {
      padding: 100px 40px 80px;
    }

    .hero-eyebrow {
      margin-bottom: 30px;
    }

    .hero-headline {
      margin-bottom: 40px;
      font-size: clamp(36px, 10vw, 120px);
    }
  }

  @media (max-width: 540px) {
    .hero-type {
      padding: 100px 20px 60px;
    }

    .hero-eyebrow {
      font-size: 11px;
      margin-bottom: 20px;
    }

    .hero-headline {
      margin-bottom: 30px;
      font-size: clamp(24px, 8vw, 80px);
      gap: 0.2em;
    }

    .opening-state {
      padding-top: 100px;
      padding-left: 20px;
    }

    .opening-text {
      font-size: 14px;
    }

    .concept-label {
      bottom: 15px;
      right: 15px;
      font-size: 9px;
    }
  }


</style>

<script>
  // CONCEPT J: CURSOR SPOTLIGHT - Interaction-driven headline reveal
  const heroJ = document.querySelector('.hero-j');
  const headlineRevealed = document.querySelector('.headline-revealed') as HTMLElement;
  const conceptSection = heroJ?.querySelector('.hero-content') as HTMLElement;

  // Check for pointer fine and reduced motion preferences
  const hasPointerFine = window.matchMedia('(pointer: fine)').matches;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Spotlight state
  let currentX = 0;
  let currentY = 0;
  let targetX = 0;
  let targetY = 0;
  let idleTimer: ReturnType<typeof setTimeout> | null = null;
  let sweepComplete = false;
  let rafId: number | null = null;

  // After sweep animation completes (2s), enable cursor tracking
  if (hasPointerFine && !prefersReducedMotion && conceptSection) {
    setTimeout(() => {
      sweepComplete = true;
      heroJ?.classList.add('interactive');
      setupCursorTracking();
    }, 2000);
  }

  function setupCursorTracking() {
    if (!hasPointerFine || !headlineRevealed) return;

    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        document.addEventListener('pointermove', onPointerMove);
      } else {
        document.removeEventListener('pointermove', onPointerMove);
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
        }
      }
    });

    if (conceptSection) {
      observer.observe(conceptSection);
    }
  }

  function onPointerMove(e: PointerEvent) {
    if (!sweepComplete || !headlineRevealed) return;

    targetX = e.clientX;
    targetY = e.clientY;

    // Clear idle timer and reset
    if (idleTimer) {
      clearTimeout(idleTimer);
    }
    headlineRevealed.classList.remove('idle-return');

    // Request animation frame to throttle updates
    if (rafId !== null) {
      cancelAnimationFrame(rafId);
    }
    rafId = requestAnimationFrame(updateSpotlight);

    // Start idle timer
    idleTimer = setTimeout(() => {
      // After 4 seconds of no movement, return to fully revealed
      headlineRevealed.classList.add('idle-return');
    }, 4000);
  }

  function updateSpotlight() {
    if (!headlineRevealed) return;

    // Ease current position toward target (0.1 easing factor for slight trail)
    currentX += (targetX - currentX) * 0.1;
    currentY += (targetY - currentY) * 0.1;

    headlineRevealed.style.webkitMaskPosition = `${currentX}px ${currentY}px`;
    headlineRevealed.style.maskPosition = `${currentX}px ${currentY}px`;
  }

  // Cleanup on unload
  window.addEventListener('beforeunload', () => {
    if (rafId !== null) {
      cancelAnimationFrame(rafId);
    }
    if (idleTimer) {
      clearTimeout(idleTimer);
    }
  });

  // CONCEPT M: Local MP4 playback with fallback
  const videoElement = document.querySelector('.hero-bg-video') as HTMLVideoElement;

  // Error handler: hide video on playback error, poster remains visible as background-image
  if (videoElement) {
    videoElement.addEventListener('error', () => {
      console.log('[VIDEO] MP4 playback error, poster fallback active');
      videoElement.style.display = 'none';
    });
  }
</script>
