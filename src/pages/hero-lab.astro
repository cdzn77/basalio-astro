---
import BaseLayout from '../layouts/BaseLayout.astro';
import RampHeader from '../components/RampHeader.astro';
import RampFooter from '../components/RampFooter.astro';
import Button from '../components/Button.astro';

const title = 'Hero Lab - Motion Exploration';
const description = 'Three motion options for the monumental letterform hero';
---

<BaseLayout {title} {description} noindex>
  <Fragment slot="header">
    <RampHeader surface="ink" />
  </Fragment>

  <!-- OPTION A: DRIFT - Slow continuous horizontal movement -->
  <section class="hero-motion hero-motion-a" id="option-a">
    <div class="hero-bg-monumental">
      <div class="monumental-text monumental-drift" aria-hidden="true">BASALIO</div>
    </div>
    <div class="hero-content">
      <p class="hero-eyebrow">A WORDPRESS PLUGIN FOR CREATIVES</p>
      <h1 class="hero-h1">Framer-quality <span class="accent-word">interactions,</span> native to WordPress.</h1>
      <Button label="Explore Blocks" href="/blocks" variant="acid" />
    </div>
    <div class="motion-label">A DRIFT</div>
  </section>

  <!-- OPTION B: REVEAL - Letters arrive on load -->
  <section class="hero-motion hero-motion-b" id="option-b">
    <div class="hero-bg-monumental">
      <div class="monumental-text monumental-reveal" aria-hidden="true">
        <span class="letter" style="--letter-index: 0">B</span><span class="letter" style="--letter-index: 1">A</span><span class="letter" style="--letter-index: 2">S</span><span class="letter" style="--letter-index: 3">A</span><span class="letter" style="--letter-index: 4">L</span><span class="letter" style="--letter-index: 5">I</span><span class="letter" style="--letter-index: 6">O</span>
      </div>
    </div>
    <div class="hero-content">
      <p class="hero-eyebrow">A WORDPRESS PLUGIN FOR CREATIVES</p>
      <h1 class="hero-h1">Framer-quality <span class="accent-word">interactions,</span> native to WordPress.</h1>
      <Button label="Explore Blocks" href="/blocks" variant="acid" />
    </div>
    <div class="motion-label">B REVEAL</div>
  </section>

  <!-- OPTION C: PARALLAX - Responds to cursor -->
  <section class="hero-motion hero-motion-c" id="option-c">
    <div class="hero-bg-monumental">
      <div class="monumental-text monumental-parallax" aria-hidden="true">BASALIO</div>
    </div>
    <div class="hero-content">
      <p class="hero-eyebrow">A WORDPRESS PLUGIN FOR CREATIVES</p>
      <h1 class="hero-h1">Framer-quality <span class="accent-word">interactions,</span> native to WordPress.</h1>
      <Button label="Explore Blocks" href="/blocks" variant="acid" />
    </div>
    <div class="motion-label">C PARALLAX</div>
  </section>

  <Fragment slot="footer">
    <RampFooter hideNewsletter={true} />
  </Fragment>
</BaseLayout>

<style>
  /* SHARED HERO MOTION STYLES */
  .hero-motion {
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 80px 40px;
    box-sizing: border-box;
    overflow: hidden;
    background: var(--surface-ink);
    z-index: 1;
  }

  .hero-bg-monumental {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .monumental-text {
    font-family: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(400px, 60vw, 1000px);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--stone);
    line-height: 1;
    white-space: nowrap;
    opacity: 0.15;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 500px;
  }

  .hero-eyebrow {
    font-family: 'Azeret Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 20px 0;
    padding: 0;
    line-height: 1.4;
    color: var(--text-on-ink-muted);
  }

  .hero-h1 {
    font-family: 'Switzer', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: clamp(32px, 8vw, 72px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 40px 0;
    padding: 0;
    color: var(--text-on-ink);
  }

  .accent-word {
    color: var(--acid);
  }

  .motion-label {
    position: absolute;
    bottom: 40px;
    right: 40px;
    font-family: 'Azeret Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.5;
    z-index: 11;
    color: var(--text-on-ink-muted);
  }

  /* OPTION A: DRIFT - Slow continuous horizontal movement */
  .monumental-drift {
    animation: drift 75s linear infinite;
  }

  @keyframes drift {
    0% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(-8vw);
    }
    100% {
      transform: translateX(0);
    }
  }

  /* OPTION B: REVEAL - Letters arrive on load with stagger */
  .monumental-reveal {
    display: flex;
    gap: 0;
  }

  .letter {
    display: inline-block;
    opacity: 0;
    transform: translateY(40px);
    animation: letter-reveal 700ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: calc(var(--letter-index) * 180ms);
  }

  @keyframes letter-reveal {
    0% {
      opacity: 0;
      transform: translateY(40px);
    }
    100% {
      opacity: 0.15;
      transform: translateY(0);
    }
  }

  /* OPTION C: PARALLAX - Responds to cursor */
  .monumental-parallax {
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Reduced motion: all options show static state */
  @media (prefers-reduced-motion: reduce) {
    .monumental-drift {
      animation: none;
      transform: translateX(0);
    }

    .letter {
      animation: none;
      opacity: 0.15;
      transform: translateY(0);
    }

    .monumental-parallax {
      transition: none;
      transform: translate(0, 0);
    }
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .hero-motion {
      padding: 100px 40px 80px;
    }

    .monumental-text {
      font-size: clamp(200px, 50vw, 600px);
    }
  }

  @media (max-width: 540px) {
    .hero-motion {
      padding: 100px 20px 60px;
    }

    .hero-h1 {
      font-size: clamp(24px, 6vw, 36px);
      margin-bottom: 30px;
    }

    .hero-eyebrow {
      font-size: 11px;
    }

    .monumental-text {
      font-size: clamp(120px, 40vw, 300px);
    }

    .motion-label {
      bottom: 15px;
      right: 15px;
      font-size: 9px;
    }
  }
</style>

<script>
  // PARALLAX IMPLEMENTATION (Option C only)
  const parallaxElements = document.querySelectorAll('.monumental-parallax');
  let ticking = false;
  let mouseX = 0;
  let mouseY = 0;
  let observer: IntersectionObserver | null = null;
  let listeners: { element: Element; handler: (e: MouseEvent) => void }[] = [];

  function updateParallax() {
    parallaxElements.forEach((el) => {
      const rect = el.getBoundingClientRect();
      const heroSection = el.closest('.hero-motion-c');
      if (!heroSection) return;

      const heroRect = heroSection.getBoundingClientRect();
      const centerX = heroRect.left + heroRect.width / 2;
      const centerY = heroRect.top + heroRect.height / 2;

      const distX = (mouseX - centerX) / heroRect.width;
      const distY = (mouseY - centerY) / heroRect.height;

      const maxOffset = 20;
      const x = distX * maxOffset;
      const y = distY * maxOffset;

      (el as HTMLElement).style.transform = `translate(${x}px, ${y}px)`;
    });
    ticking = false;
  }

  function handleMouseMove(e: MouseEvent) {
    mouseX = e.clientX;
    mouseY = e.clientY;

    if (!ticking) {
      requestAnimationFrame(updateParallax);
      ticking = true;
    }
  }

  // Only enable parallax on pointer devices, not touch
  const isPointerDevice = () => {
    return (
      window.matchMedia('(pointer:fine)').matches ||
      navigator.maxTouchPoints === 0
    );
  };

  if (isPointerDevice()) {
    const heroMotionC = document.querySelector('.hero-motion-c');
    if (heroMotionC) {
      const handler = handleMouseMove;
      heroMotionC.addEventListener('mousemove', handler);
      listeners.push({ element: heroMotionC, handler });
    }

    // Intersection Observer: remove listener when hero scrolls out of view
    if (observer === null) {
      observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const heroMotionC = entry.target as HTMLElement;
            const idx = listeners.findIndex((l) => l.element === heroMotionC);
            if (idx !== -1) {
              const { handler } = listeners[idx];
              if (!entry.isIntersecting) {
                heroMotionC.removeEventListener('mousemove', handler);
                listeners.splice(idx, 1);
                // Reset parallax to center
                const parallax = heroMotionC.querySelector(
                  '.monumental-parallax'
                ) as HTMLElement;
                if (parallax) {
                  parallax.style.transform = 'translate(0, 0)';
                }
              }
            }
          });
        },
        { threshold: 0 }
      );

      document.querySelectorAll('.hero-motion-c').forEach((el) => {
        observer!.observe(el);
      });
    }
  }
</script>
