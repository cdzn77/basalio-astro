---
import BaseLayout from '../layouts/BaseLayout.astro';
import RampHeader from '../components/RampHeader.astro';
import RampFooter from '../components/RampFooter.astro';
import Button from '../components/Button.astro';

// Generate plotter lines at build time
function generatePlotterLines() {
  const lines = [];
  const width = 1440;
  const height = 900;
  const spacing = 40;
  const attractorX = width * 0.6;
  const attractorY = height * 0.5;
  const attractorRadius = 300;

  for (let i = 0; i < height; i += spacing) {
    const points: string[] = [];
    for (let x = 0; x <= width; x += 10) {
      const dx = x - attractorX;
      const dy = i - attractorY;
      const dist = Math.sqrt(dx * dx + dy * dy);
      const pull = Math.max(0, (attractorRadius - dist) / attractorRadius);
      const deflection = pull * 30 * Math.sin(i / 100);
      const y = i + deflection;
      points.push(`${x},${y}`);
    }
    lines.push(points.join(' '));
  }
  return lines;
}

// Generate grid reveal tiles with random acid accents
function generateGridTiles() {
  const cols = 6;
  const rows = 4;
  const total = cols * rows;
  const acidIndices = new Set();

  // Randomly pick 1-2 tiles to be acid
  const acidCount = Math.random() < 0.5 ? 1 : 2;
  while (acidIndices.size < acidCount) {
    acidIndices.add(Math.floor(Math.random() * total));
  }

  return Array.from({ length: total }, (_, i) => ({
    index: i,
    isAcid: acidIndices.has(i)
  }));
}

const plotterLines = generatePlotterLines();
const gridTiles = generateGridTiles();

const title = 'Hero Lab - Basalio';
const description = 'Experimental hero background concepts';
---

<BaseLayout {title} {description} noindex>
  <Fragment slot="header">
    <RampHeader surface="ink" />
  </Fragment>

  <!-- INK VERSIONS (Dark background with color accents) -->

  <!-- CONCEPT 01: MONUMENTAL TYPE (INK) -->
  <section class="hero-concept hero-01-ink" id="concept-01-ink">
    <div class="hero-bg-monumental-ink">
      <div class="monumental-text-ink" aria-hidden="true">BASALIO</div>
    </div>
    <div class="hero-content">
      <p class="hero-eyebrow">A WORDPRESS PLUGIN FOR CREATIVES</p>
      <h1 class="hero-h1">Framer-quality <span class="accent-word">interactions,</span> native to WordPress.</h1>
      <Button label="Explore Blocks" href="/blocks" variant="acid" />
    </div>
    <div class="concept-label">01 MONUMENTAL TYPE (Dark)</div>
  </section>

  <!-- CONCEPT 02: HALFTONE FIELD (INK) -->
  <section class="hero-concept hero-02-ink" id="concept-02-ink">
    <div class="hero-bg-halftone-ink"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">A WORDPRESS PLUGIN FOR CREATIVES</p>
      <h1 class="hero-h1">Framer-quality <span class="accent-word">interactions,</span> native to WordPress.</h1>
      <Button label="Explore Blocks" href="/blocks" variant="acid" />
    </div>
    <div class="concept-label">02 HALFTONE FIELD (Dark)</div>
  </section>

  <!-- CONCEPT 03: PLOTTER LINES (INK) -->
  <section class="hero-concept hero-03-ink" id="concept-03-ink">
    <svg class="hero-bg-plotter-ink" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
      <rect width="1440" height="900" fill="var(--surface-ink)" />
      <g stroke="var(--acid)" stroke-width="1.5" fill="none" stroke-linecap="round">
        {plotterLines.map((pathData) => (
          <polyline points={pathData} opacity={0.8} />
        ))}
      </g>
    </svg>
    <div class="hero-content">
      <p class="hero-eyebrow">A WORDPRESS PLUGIN FOR CREATIVES</p>
      <h1 class="hero-h1">Framer-quality <span class="accent-word">interactions,</span> native to WordPress.</h1>
      <Button label="Explore Blocks" href="/blocks" variant="acid" />
    </div>
    <div class="concept-label">03 PLOTTER LINES (Dark)</div>
  </section>

  <!-- CONCEPT 04: GRID REVEAL (INK) -->
  <section class="hero-concept hero-04-ink" id="concept-04-ink">
    <div class="hero-bg-grid-ink">
      <div class="grid-container-ink">
        {gridTiles.map((tile) => (
          <div class="grid-tile-ink" style={{ '--tile-index': tile.index, '--is-acid': tile.isAcid ? 1 : 0 } as any}></div>
        ))}
      </div>
    </div>
    <div class="hero-content">
      <p class="hero-eyebrow">A WORDPRESS PLUGIN FOR CREATIVES</p>
      <h1 class="hero-h1">Framer-quality <span class="accent-word">interactions,</span> native to WordPress.</h1>
      <Button label="Explore Blocks" href="/blocks" variant="acid" />
    </div>
    <div class="concept-label">04 GRID REVEAL (Dark)</div>
  </section>

  <!-- REFERENCE: Best acid version side-by-side -->
  <section class="hero-concept hero-03-acid-ref" id="concept-03-acid-ref">
    <svg class="hero-bg-plotter-acid" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
      <rect width="1440" height="900" fill="var(--acid)" />
      <g stroke="var(--surface-ink)" stroke-width="1.5" fill="none" stroke-linecap="round">
        {plotterLines.map((pathData) => (
          <polyline points={pathData} opacity={0.4} />
        ))}
      </g>
    </svg>
    <div class="hero-content">
      <p class="hero-eyebrow">A WORDPRESS PLUGIN FOR CREATIVES</p>
      <h1 class="hero-h1">Framer-quality interactions, native to WordPress.</h1>
      <button class="hero-cta">Explore Blocks</button>
    </div>
    <div class="concept-label">03 PLOTTER LINES (Light) - Reference</div>
  </section>

  <Fragment slot="footer">
    <RampFooter hideNewsletter={true} />
  </Fragment>
</BaseLayout>

<style>
  /* SHARED HERO STYLES */
  .hero-concept {
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 80px 40px;
    box-sizing: border-box;
    overflow: hidden;
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 500px;
  }

  .hero-eyebrow {
    font-family: 'Azeret Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 20px 0;
    padding: 0;
    line-height: 1.4;
  }

  .hero-h1 {
    font-family: 'Switzer', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: clamp(32px, 8vw, 72px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 40px 0;
    padding: 0;
  }

  .accent-word {
    color: var(--acid);
  }

  .hero-cta {
    font-family: 'Azeret Mono', monospace;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 12px 24px;
    border: 1px solid currentColor;
    background: transparent;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hero-cta:hover {
    transform: translateY(-2px);
  }

  .hero-cta-acid {
    color: var(--acid);
    border-color: var(--acid);
  }

  .concept-label {
    position: absolute;
    bottom: 40px;
    right: 40px;
    font-family: 'Azeret Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.5;
    z-index: 11;
  }

  /* INK VERSIONS - Dark background */

  /* CONCEPT 01: MONUMENTAL TYPE (INK) */
  .hero-01-ink {
    background: var(--surface-ink);
  }

  .hero-01-ink .hero-eyebrow {
    color: var(--text-on-ink-muted);
  }

  .hero-01-ink .hero-h1 {
    color: var(--text-on-ink);
  }

  .hero-01-ink .concept-label {
    color: var(--text-on-ink-muted);
  }

  .hero-bg-monumental-ink {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .monumental-text-ink {
    font-family: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(400px, 60vw, 1000px);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--stone);
    line-height: 1;
    white-space: nowrap;
    opacity: 0.15;
    transform: translateY(10%);
  }

  /* CONCEPT 02: HALFTONE FIELD (INK) - CSS radial gradient, no SVG circles */
  .hero-02-ink {
    background: var(--surface-ink);
  }

  .hero-02-ink .hero-eyebrow {
    color: var(--text-on-ink-muted);
  }

  .hero-02-ink .hero-h1 {
    color: var(--text-on-ink);
  }

  .hero-02-ink .concept-label {
    color: var(--text-on-ink-muted);
  }

  .hero-bg-halftone-ink {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    background-image: radial-gradient(var(--stone) 1.5px, transparent 1.5px);
    background-size: 14px 14px;
    background-attachment: fixed;
    mask-image: linear-gradient(90deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.8) 100%);
    animation: drift-slow 40s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg-halftone-ink {
      animation: none;
    }
  }

  /* CONCEPT 03: PLOTTER LINES (INK) */
  .hero-03-ink {
    background: var(--surface-ink);
  }

  .hero-03-ink .hero-eyebrow {
    color: var(--text-on-ink-muted);
  }

  .hero-03-ink .hero-h1 {
    color: var(--text-on-ink);
  }

  .hero-03-ink .concept-label {
    color: var(--text-on-ink-muted);
  }

  .hero-bg-plotter-ink {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    animation: drift-slow 45s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg-plotter-ink {
      animation: none;
    }
  }

  /* CONCEPT 04: GRID REVEAL (INK) */
  .hero-04-ink {
    background: var(--surface-ink);
  }

  .hero-04-ink .hero-eyebrow {
    color: var(--text-on-ink-muted);
  }

  .hero-04-ink .hero-h1 {
    color: var(--text-on-ink);
  }

  .hero-04-ink .concept-label {
    color: var(--text-on-ink-muted);
  }

  .hero-bg-grid-ink {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .grid-container-ink {
    position: absolute;
    inset: -20%;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(4, 1fr);
    gap: 0;
    animation: grid-reveal 12s ease-in-out infinite;
  }

  .grid-tile-ink {
    opacity: 0;
    transform: translateY(20px);
    animation: tile-reveal-ink 700ms cubic-bezier(0.33, 0, 0.66, 1) forwards;
    animation-delay: calc(var(--tile-index) * 180ms);
  }

  .grid-tile-ink {
    background: var(--is-acid: 0) ? var(--stone) : var(--stone);
    background: var(--stone);
  }

  .grid-tile-ink[style*="--is-acid: 1"] {
    background: var(--acid);
  }

  @keyframes tile-reveal-ink {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 0.7;
      transform: translateY(0);
    }
  }

  @keyframes grid-reveal {
    0% {
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .grid-container-ink {
      animation: none;
    }
    .grid-tile-ink {
      animation: none;
      opacity: 0.7;
      transform: translateY(0);
    }
  }

  /* REFERENCE: ACID VERSION (Light background) */
  .hero-03-acid-ref {
    background: var(--acid);
  }

  .hero-03-acid-ref .hero-eyebrow,
  .hero-03-acid-ref .hero-h1,
  .hero-03-acid-ref .hero-cta {
    color: var(--surface-ink);
  }

  .hero-03-acid-ref .concept-label {
    color: var(--surface-ink);
  }

  .hero-bg-plotter-acid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  /* ANIMATIONS */
  @keyframes drift-slow {
    0% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(20px, -10px);
    }
    100% {
      transform: translate(0, 0);
    }
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .hero-concept {
      height: auto;
      min-height: 100vh;
      padding: 100px 40px 80px;
    }

    .monumental-text-ink {
      font-size: clamp(200px, 50vw, 600px);
    }

    .concept-label {
      bottom: 20px;
      right: 20px;
      font-size: 10px;
    }
  }

  @media (max-width: 540px) {
    .hero-concept {
      padding: 100px 20px 60px;
    }

    .hero-h1 {
      font-size: clamp(24px, 6vw, 36px);
      margin-bottom: 30px;
    }

    .hero-eyebrow {
      font-size: 11px;
    }

    .monumental-text-ink {
      font-size: clamp(120px, 40vw, 300px);
    }

    .concept-label {
      bottom: 15px;
      right: 15px;
      font-size: 9px;
    }
  }
</style>

<script>
  // Prefers reduced motion check for logging
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  console.log('Prefers reduced motion:', prefersReduced);
</script>
