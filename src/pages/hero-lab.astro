---
import BaseLayout from '../layouts/BaseLayout.astro';
import RampHeader from '../components/RampHeader.astro';
import RampFooter from '../components/RampFooter.astro';

// Generate plotter lines at build time
function generatePlotterLines() {
  const lines = [];
  const width = 1440;
  const height = 900;
  const spacing = 40;
  const attractorX = width * 0.6;
  const attractorY = height * 0.5;
  const attractorRadius = 300;

  for (let i = 0; i < height; i += spacing) {
    const points: string[] = [];
    for (let x = 0; x <= width; x += 10) {
      // Distance from attractor
      const dx = x - attractorX;
      const dy = i - attractorY;
      const dist = Math.sqrt(dx * dx + dy * dy);

      // Pull towards or away from attractor
      const pull = Math.max(0, (attractorRadius - dist) / attractorRadius);
      const deflection = pull * 30 * Math.sin(i / 100);
      const y = i + deflection;
      points.push(`${x},${y}`);
    }
    lines.push(points.join(' '));
  }
  return lines;
}

// Generate halftone dots with density gradient
function generateHaltoneDots() {
  const dots = [];
  const width = 1440;
  const height = 900;
  const spacing = 12;

  for (let y = 0; y < height; y += spacing) {
    for (let x = 0; x < width; x += spacing) {
      // Density: sparse at left, dense at right
      const densityLeft = 0.1;
      const densityRight = 0.8;
      const density = densityLeft + (x / width) * (densityRight - densityLeft);

      if (Math.random() < density) {
        // Radius varies with density
        const radius = 1.5 + density * 1.5;
        dots.push({ x, y, r: radius });
      }
    }
  }
  return dots;
}

// Generate grid reveal tiles
function generateGridTiles() {
  const tiles = [];
  const cols = 6;
  const rows = 4;
  const tileIndex = Array.from({ length: cols * rows }, (_, i) => i);

  return tileIndex;
}

const plotterLines = generatePlotterLines();
const haltoneDots = generateHaltoneDots();
const gridTiles = generateGridTiles();

const title = 'Hero Lab - Basalio';
const description = 'Experimental hero background concepts';
---

<BaseLayout {title} {description} noindex>
  <Fragment slot="header">
    <RampHeader />
  </Fragment>

  <!-- CONCEPT 01: MONUMENTAL TYPE -->
  <section class="hero-concept hero-01" id="concept-01">
    <div class="hero-bg-monumental">
      <div class="monumental-text" aria-hidden="true">BASALIO</div>
    </div>
    <div class="hero-content">
      <p class="hero-eyebrow">A WORDPRESS PLUGIN FOR CREATIVES</p>
      <h1 class="hero-h1">Framer-quality interactions, native to WordPress.</h1>
      <button class="hero-cta">Explore Blocks</button>
    </div>
    <div class="concept-label">01 MONUMENTAL TYPE</div>
  </section>

  <!-- CONCEPT 02: HALFTONE FIELD -->
  <section class="hero-concept hero-02" id="concept-02">
    <svg class="hero-bg-halftone" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
      <defs>
        <pattern id="halftone-pattern" x="0" y="0" width="12" height="12" patternUnits="userSpaceOnUse">
          <circle cx="6" cy="6" r="2" fill="var(--surface-ink)" />
        </pattern>
        <mask id="halftone-mask">
          <linearGradient id="mask-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="black" stop-opacity="0.1" />
            <stop offset="100%" stop-color="black" stop-opacity="0.8" />
          </linearGradient>
          <rect width="1440" height="900" fill="url(#mask-gradient)" />
        </mask>
      </defs>
      <rect width="1440" height="900" fill="var(--acid)" />
      <g mask="url(#halftone-mask)">
        {haltoneDots.map(dot => (
          <circle cx={dot.x} cy={dot.y} r={dot.r} fill="var(--surface-ink)" />
        ))}
      </g>
    </svg>
    <div class="hero-content">
      <p class="hero-eyebrow">A WORDPRESS PLUGIN FOR CREATIVES</p>
      <h1 class="hero-h1">Framer-quality interactions, native to WordPress.</h1>
      <button class="hero-cta">Explore Blocks</button>
    </div>
    <div class="concept-label">02 HALFTONE FIELD</div>
  </section>

  <!-- CONCEPT 03: PLOTTER LINES -->
  <section class="hero-concept hero-03" id="concept-03">
    <svg class="hero-bg-plotter" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
      <rect width="1440" height="900" fill="var(--acid)" />
      <g stroke="var(--surface-ink)" stroke-width="1.5" fill="none" stroke-linecap="round">
        {plotterLines.map((pathData, i) => (
          <polyline points={pathData} opacity={0.6} />
        ))}
      </g>
    </svg>
    <div class="hero-content">
      <p class="hero-eyebrow">A WORDPRESS PLUGIN FOR CREATIVES</p>
      <h1 class="hero-h1">Framer-quality interactions, native to WordPress.</h1>
      <button class="hero-cta">Explore Blocks</button>
    </div>
    <div class="concept-label">03 PLOTTER LINES</div>
  </section>

  <!-- CONCEPT 04: GRID REVEAL -->
  <section class="hero-concept hero-04" id="concept-04">
    <div class="hero-bg-grid">
      <div class="grid-container">
        {gridTiles.map((index) => (
          <div class="grid-tile" style={{ '--tile-index': index } as any}></div>
        ))}
      </div>
    </div>
    <div class="hero-content">
      <p class="hero-eyebrow">A WORDPRESS PLUGIN FOR CREATIVES</p>
      <h1 class="hero-h1">Framer-quality interactions, native to WordPress.</h1>
      <button class="hero-cta">Explore Blocks</button>
    </div>
    <div class="concept-label">04 GRID REVEAL</div>
  </section>

  <Fragment slot="footer">
    <RampFooter hideNewsletter={true} />
  </Fragment>
</BaseLayout>

<style>
  /* SHARED HERO STYLES */
  .hero-concept {
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 80px 40px;
    box-sizing: border-box;
    overflow: hidden;
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 500px;
  }

  .hero-eyebrow {
    font-family: 'Azeret Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 20px 0;
    padding: 0;
    line-height: 1.4;
  }

  .hero-h1 {
    font-family: 'Switzer', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: clamp(32px, 8vw, 72px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 40px 0;
    padding: 0;
  }

  .hero-cta {
    font-family: 'Azeret Mono', monospace;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 12px 24px;
    border: 1px solid currentColor;
    background: transparent;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hero-cta:hover {
    transform: translateY(-2px);
  }

  .concept-label {
    position: absolute;
    bottom: 40px;
    right: 40px;
    font-family: 'Azeret Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.5;
    z-index: 11;
  }

  /* CONCEPT 01: MONUMENTAL TYPE */
  .hero-01 {
    background: var(--acid);
  }

  .hero-01 .hero-eyebrow,
  .hero-01 .hero-h1,
  .hero-01 .hero-cta {
    color: var(--surface-ink);
  }

  .hero-01 .concept-label {
    color: var(--surface-ink);
  }

  .hero-bg-monumental {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .monumental-text {
    font-family: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: clamp(400px, 60vw, 1000px);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--surface-ink);
    line-height: 1;
    white-space: nowrap;
    opacity: 0.08;
    transform: translateY(10%);
  }

  /* CONCEPT 02: HALFTONE FIELD */
  .hero-02 {
    background: var(--acid);
  }

  .hero-02 .hero-eyebrow,
  .hero-02 .hero-h1,
  .hero-02 .hero-cta {
    color: var(--surface-ink);
  }

  .hero-02 .concept-label {
    color: var(--surface-ink);
  }

  .hero-bg-halftone {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    animation: drift-slow 40s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg-halftone {
      animation: none;
    }
  }

  /* CONCEPT 03: PLOTTER LINES */
  .hero-03 {
    background: var(--acid);
  }

  .hero-03 .hero-eyebrow,
  .hero-03 .hero-h1,
  .hero-03 .hero-cta {
    color: var(--surface-ink);
  }

  .hero-03 .concept-label {
    color: var(--surface-ink);
  }

  .hero-bg-plotter {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    animation: drift-slow 45s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg-plotter {
      animation: none;
    }
  }

  /* CONCEPT 04: GRID REVEAL */
  .hero-04 {
    background: var(--acid);
  }

  .hero-04 .hero-eyebrow,
  .hero-04 .hero-h1,
  .hero-04 .hero-cta {
    color: var(--surface-ink);
  }

  .hero-04 .concept-label {
    color: var(--surface-ink);
  }

  .hero-bg-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .grid-container {
    position: absolute;
    inset: -20%;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(4, 1fr);
    gap: 0;
    animation: grid-reveal 12s ease-in-out infinite;
  }

  .grid-tile {
    background: var(--surface-ink);
    opacity: 0;
    transform: translateY(20px);
    animation: tile-reveal 700ms cubic-bezier(0.33, 0, 0.66, 1) forwards;
    animation-delay: calc(var(--tile-index) * 180ms);
  }

  @keyframes tile-reveal {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 0.6;
      transform: translateY(0);
    }
  }

  @keyframes grid-reveal {
    0% {
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .grid-container {
      animation: none;
    }
    .grid-tile {
      animation: none;
      opacity: 0.6;
      transform: translateY(0);
    }
  }

  /* ANIMATIONS */
  @keyframes drift-slow {
    0% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(20px, -10px);
    }
    100% {
      transform: translate(0, 0);
    }
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .hero-concept {
      height: auto;
      min-height: 100vh;
      padding: 100px 40px 80px;
    }

    .monumental-text {
      font-size: clamp(200px, 50vw, 600px);
    }

    .concept-label {
      bottom: 20px;
      right: 20px;
      font-size: 10px;
    }
  }

  @media (max-width: 540px) {
    .hero-concept {
      padding: 100px 20px 60px;
    }

    .hero-h1 {
      font-size: clamp(24px, 6vw, 36px);
      margin-bottom: 30px;
    }

    .hero-eyebrow {
      font-size: 11px;
    }

    .monumental-text {
      font-size: clamp(120px, 40vw, 300px);
    }

    .concept-label {
      bottom: 15px;
      right: 15px;
      font-size: 9px;
    }
  }
</style>

<script>
  // Prefers reduced motion check for logging
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  console.log('Prefers reduced motion:', prefersReduced);
</script>
