---
// homepage-v1.astro — Sample-blend product showcase
// Full-viewport hero, block grid, nine live feature demos, comparison,
// stats, testimonials, FAQ, and founder-pricing CTA.

import '../components/demos/sample/sample-styles.css';

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import FeatureSection from '../components/demos/FeatureSection.astro';

import EditorShot from '../components/demos/sample/EditorShot.astro';
import Marquee from '../components/demos/sample/Marquee.astro';
import BlockCardGrid from '../components/demos/sample/BlockCardGrid.astro';
import GridRevealDemo from '../components/demos/sample/demos/GridRevealDemo.astro';
import TextRevealDemo from '../components/demos/sample/demos/TextRevealDemo.astro';
import ScrollSequenceDemo from '../components/demos/sample/demos/ScrollSequenceDemo.astro';
import PinnedScrollDemo from '../components/demos/sample/demos/PinnedScrollDemo.astro';
import BeforeAfterDemo from '../components/demos/sample/demos/BeforeAfterDemo.astro';
import CaseStudyDemo from '../components/demos/sample/demos/CaseStudyDemo.astro';
import CustomCursorDemo from '../components/demos/sample/demos/CustomCursorDemo.astro';
import FilterableGridDemo from '../components/demos/sample/demos/FilterableGridDemo.astro';
import MagneticDemo from '../components/demos/sample/demos/MagneticDemo.astro';
import ComparisonTable from '../components/demos/sample/ComparisonTable.astro';
import Stats from '../components/demos/sample/Stats.astro';
import Testimonials from '../components/demos/sample/Testimonials.astro';
import Faq from '../components/demos/sample/Faq.astro';

import { pricingTiers, FOUNDER_PRICE, POST_CAP_PRICE, proShipTarget } from '../data/pricing';
import { getFaqs } from '../data/faq';

const faqs = getFaqs(POST_CAP_PRICE, proShipTarget);

const title = 'Basalio | Interaction blocks for WordPress';
const description = 'Framer-quality interactions, native to WordPress. Nine curated interaction blocks for portfolio and case-study sites.';

const paidTier = pricingTiers.find((t) => t.id === 'paid');
const ctaHref = paidTier?.cta?.href || '/early-access';
const ctaLabel = paidTier?.cta?.label || 'Join the founder list';
---

<BaseLayout {title} {description}>
  <Fragment slot="header">
    <Header surface="ink" />
  </Fragment>

  <!-- 1. HERO: Full-viewport dark manifesto with editor shot -->
  <section class="sample-hero" data-surface="ink">
    <div class="sample-hero-inner reveal">
      <div class="sample-hero-glow sample-hero-glow-1" aria-hidden="true"></div>
      <div class="sample-hero-glow sample-hero-glow-2" aria-hidden="true"></div>
      <div class="sample-hero-text">
        <p class="sample-mono-label sample-hero-eyebrow">For WordPress. Not a page builder.</p>
        <h1 class="sample-hero-headline">Framer-quality interactions, native to WordPress.</h1>
        <p class="sample-hero-body">Give your work a foundation to stand on. Nine curated interaction blocks, from grid reveals to case-study transitions to scroll-tied sequences, built only for portfolio and case-study sites.</p>
        <div class="sample-hero-ctas">
          <Button variant="acid" label="Explore the blocks" href="/blocks" />
          <a href="/pricing" class="sample-hero-cta-secondary">Pricing</a>
        </div>
        <p class="sample-hero-trust">GPL-2.0 · No lock-in · Keyboard-operable by default</p>
      </div>
      <div class="sample-hero-shot">
        <EditorShot />
      </div>
    </div>
  </section>

  <!-- 2. MARQUEE: Client-name strip -->
  <section class="sample-marquee-section" data-surface="ink">
    <div class="sample-marquee-inner reveal">
      <Marquee items={['Northwind', 'Salt & Pine', 'Meridian', 'Field Notes', 'Atlas & Co', 'Low Tide', 'Fjeld', 'Studio Aar']} />
    </div>
  </section>

  <!-- 3. BLOCK CARD GRID: Overview of all nine blocks -->
  <section class="sample-blocks-section" data-surface="ink">
    <div class="sample-blocks-inner reveal">
      <div class="sample-blocks-header">
        <p class="sample-mono-label sample-blocks-eyebrow">The blocks</p>
        <h2 class="sample-blocks-headline">Nine blocks. Nothing you don't need.</h2>
        <p class="sample-blocks-description">Each block solves one specific problem. No bloat, no learning curve, and every one is keyboard-operable and reduced-motion aware. That isn't a Pro feature. That's the floor.</p>
      </div>
      <BlockCardGrid />
    </div>
  </section>

  <!-- 4. FEATURE SECTIONS: Live demos of each block -->
  <FeatureSection surface="alt" number="01" label="Grid Reveal" headline="Content that cascades into view." body="Reveal work in a cascading grid pattern as visitors scroll." href="/blocks">
    <GridRevealDemo slot="mockup" />
  </FeatureSection>

  <FeatureSection surface="ink" number="02" label="Text Reveal" headline="Headlines that assemble themselves." body="Animate type into place with split-line or character-driven reveals." reverse={true} href="/blocks">
    <TextRevealDemo slot="mockup" />
  </FeatureSection>

  <FeatureSection surface="acid" number="03" label="Scroll Sequence" headline="A story told one scroll at a time." body="Progress through a timed sequence of frames tied to scroll position." href="/blocks">
    <ScrollSequenceDemo slot="mockup" />
  </FeatureSection>

  <FeatureSection surface="paper" number="04" label="Pinned Scroll" headline="Panels that hold their ground." body="Pin key scenes in place while content scrolls past in sticky layers." reverse={true} href="/blocks">
    <PinnedScrollDemo slot="mockup" />
  </FeatureSection>

  <FeatureSection surface="alt" number="05" label="Before/After" headline="Two states, one draggable moment." body="Let visitors wipe between before and after views with a clean slider." href="/blocks">
    <BeforeAfterDemo slot="mockup" />
  </FeatureSection>

  <FeatureSection surface="ink" number="06" label="Case Study Transition" headline="Seamless project handoffs." body="Morph from overview into detail with a smooth editorial transition." reverse={true} href="/blocks">
    <CaseStudyDemo slot="mockup" />
  </FeatureSection>

  <FeatureSection surface="acid" number="07" label="Custom Cursor" headline="A cursor with intention." body="Replace the default pointer with a context-aware follow element." href="/blocks">
    <CustomCursorDemo slot="mockup" />
  </FeatureSection>

  <FeatureSection surface="paper" number="08" label="Filterable Grid" headline="Sort without losing the rhythm." body="Reorder gallery items with animated, keyboard-friendly filtering." reverse={true} href="/blocks">
    <FilterableGridDemo slot="mockup" />
  </FeatureSection>

  <FeatureSection surface="alt" number="09" label="Magnetic Button" headline="Calls to action that pull people in." body="Add subtle magnetic attraction to buttons on hover and focus." href="/blocks">
    <MagneticDemo slot="mockup" />
  </FeatureSection>

  <!-- 5. COMPARISON TABLE: Why Basalio wins -->
  <section class="sample-comparison-section" data-surface="ink">
    <div class="sample-comparison-inner reveal">
      <ComparisonTable />
    </div>
  </section>

  <!-- 6. STATS: Editorial proof points -->
  <section class="sample-stats-section" data-surface="alt">
    <div class="sample-stats-inner reveal">
      <Stats items={[
        { value: 9, label: 'Blocks, not 90' },
        { value: 1, label: 'Plugin, zero page-builder lock-in' },
        { value: 0, label: 'Generic presets. Only opinionated ones.' },
        { value: 100, label: 'Founder licenses at $149, then $249' },
      ]} />
    </div>
  </section>

  <!-- 7. TESTIMONIALS: Early design partners -->
  <section class="sample-testimonials-section" data-surface="ink">
    <div class="sample-testimonials-inner reveal">
      <Testimonials />
    </div>
  </section>

  <!-- 8. FAQ: Common questions -->
  <section class="sample-faq-section" data-surface="paper">
    <div class="sample-faq-inner reveal">
      <div class="sample-faq-header">
        <p class="sample-faq-eyebrow">Questions</p>
        <h2 class="sample-faq-headline">Asked before you did.</h2>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <!-- 9. FOUNDER PRICING CTA: Ink band so the acid card pops and separates from the acid footer -->
  <section class="pricing-section" data-surface="ink">
    <div class="pricing-inner reveal">
      <div class="pricing-text">
        <p class="pricing-eyebrow">Founder pricing</p>
        <h2 class="pricing-headline">Get the Pro control center at founder pricing.</h2>
        <p class="pricing-body">{paidTier?.leadLine || `Everything in the free version, plus the Pro layer. One payment, unlimited sites, yours permanently, and refundable until the control center ships.`}</p>
      </div>
      <div class="pricing-card">
        <p class="pricing-label">{paidTier?.label || 'FOUNDER · 100 LICENSES'}</p>
        <p class="pricing-price">{FOUNDER_PRICE}</p>
        <p class="pricing-billing">one time</p>
        <p class="pricing-teaser">100 founder licenses at {FOUNDER_PRICE}, then {POST_CAP_PRICE}.</p>
        <div class="pricing-cta">
          <Button
            label={ctaLabel}
            href={ctaHref}
            variant="ink"
            fontSize="clamp(10px, 2.5vw, 14px)"
            letterSpacing="clamp(1.5px, 0.6vw, 2.8px)"
          />
        </div>
        <p class="pricing-micro">{paidTier?.microLine || '30-day refund, no questions asked.'}</p>
      </div>
    </div>
  </section>

  <script>
    (function () {
      const initReveal = () => {
        const reveals = document.querySelectorAll('.reveal');
        if (!reveals.length) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          reveals.forEach((el) => el.classList.add('reveal-visible'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        reveals.forEach((el) => observer.observe(el));
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveal);
      } else {
        initReveal();
      }
    })();
  </script>

  <Fragment slot="footer">
    <Footer hideNewsletter={true} />
  </Fragment>
</BaseLayout>

<style>
  /* ---------- HERO ---------- */
  .sample-hero {
    position: relative;
    width: 100%;
    min-height: auto;
    background-color: var(--surface-ink);
    padding: 150px 40px 48px;
    margin-top: -80px;
    box-sizing: border-box;
    display: flex;
    overflow: hidden;
  }

  .sample-hero-inner {
    position: relative;
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .sample-hero-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(120px);
    background: radial-gradient(circle, color-mix(in srgb, var(--acid) 55%, transparent), transparent 70%);
    opacity: 0.45;
    z-index: 0;
  }

  .sample-hero-glow-1 {
    width: min(360px, 60vw);
    height: min(360px, 60vw);
    top: -120px;
    left: -40px;
  }

  .sample-hero-glow-2 {
    width: min(320px, 55vw);
    height: min(320px, 55vw);
    top: 60px;
    right: -40px;
  }

  .sample-hero-text {
    position: relative;
    z-index: 1;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .sample-hero-eyebrow {
    color: var(--acid);
  }

  .sample-hero-headline {
    font-family: var(--font-sans);
    font-size: clamp(34px, 5vw, 68px);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: var(--heading-letter-spacing);
    color: var(--text-on-ink);
    margin: 0;
    text-wrap: balance;
  }

  .sample-hero-body {
    font-size: 17px;
    line-height: 1.55;
    color: var(--text-on-ink-muted);
    margin: 0;
    max-width: 500px;
  }

  .sample-hero-ctas {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 2px;
  }

  .sample-hero-trust {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-ink-muted);
    margin: 0;
  }

  .sample-hero-cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 43.6px;
    padding: 0 24px;
    border: 1px solid var(--text-on-ink);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: var(--font-weight-medium);
    letter-spacing: 2.8px;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-on-ink);
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .sample-hero-cta-secondary:hover {
    background-color: var(--text-on-ink);
    color: var(--surface-ink);
  }

  .sample-hero-shot {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: min(960px, 92%);
    max-height: 42vh;
    margin: 0 auto;
    display: flex;
    justify-content: center;
  }

  .sample-hero-shot :global(.sample-editor-shot) {
    width: auto;
    max-width: 100%;
    max-height: 100%;
  }

  /* ---------- MARQUEE ---------- */
  .sample-marquee-section {
    width: 100%;
    background-color: var(--surface-ink);
    padding: 48px 0;
    box-sizing: border-box;
  }

  .sample-marquee-inner {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
  }

  /* ---------- BLOCK CARD GRID ---------- */
  .sample-blocks-section {
    width: 100%;
    background-color: var(--surface-ink);
    padding: 120px 40px;
    box-sizing: border-box;
  }

  .sample-blocks-inner {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .sample-blocks-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 640px;
  }

  .sample-blocks-eyebrow {
    color: var(--acid);
  }

  .sample-blocks-headline {
    font-family: var(--font-sans);
    font-size: clamp(36px, 5vw, 72px);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: var(--heading-letter-spacing);
    color: var(--text-on-ink);
    margin: 0;
    text-wrap: balance;
  }

  .sample-blocks-description {
    font-size: var(--font-size-body);
    line-height: var(--line-height-relaxed);
    color: var(--text-on-ink-muted);
    margin: 0;
  }

  /* ---------- COMPARISON ---------- */
  .sample-comparison-section {
    width: 100%;
    background-color: var(--surface-ink);
    box-sizing: border-box;
  }

  .sample-comparison-inner {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
  }

  /* ---------- STATS ---------- */
  .sample-stats-section {
    width: 100%;
    background-color: var(--surface-alt);
    box-sizing: border-box;
  }

  .sample-stats-inner {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
  }

  /* ---------- TESTIMONIALS ---------- */
  .sample-testimonials-section {
    width: 100%;
    background-color: var(--surface-ink);
    box-sizing: border-box;
  }

  .sample-testimonials-inner {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
  }

  /* ---------- FAQ ---------- */
  .sample-faq-section {
    width: 100%;
    background-color: var(--surface-paper);
    padding: 120px 40px;
    box-sizing: border-box;
  }

  .sample-faq-inner {
    width: 100%;
    max-width: var(--container-narrow);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .sample-faq-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sample-faq-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-paper-muted);
    margin: 0;
  }

  .sample-faq-headline {
    font-family: var(--font-sans);
    font-size: clamp(36px, 5vw, 72px);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: var(--heading-letter-spacing);
    color: var(--text-on-paper);
    margin: 0;
    text-wrap: balance;
  }

  /* ---------- FOUNDER PRICING CTA ---------- */
  .pricing-section {
    width: 100%;
    background-color: var(--surface-ink);
    padding: 120px 40px;
    box-sizing: border-box;
  }

  .pricing-inner {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .pricing-inner > * {
    min-width: 0;
  }

  .pricing-text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .pricing-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-ink-muted);
    margin: 0;
  }

  .pricing-headline {
    font-family: var(--font-sans);
    font-size: clamp(36px, 5vw, 72px);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: var(--heading-letter-spacing);
    color: var(--text-on-ink);
    margin: 0;
    text-wrap: balance;
  }

  .pricing-body {
    font-size: var(--font-size-body);
    line-height: var(--line-height-relaxed);
    color: var(--text-on-ink-muted);
    margin: 0;
    max-width: 560px;
  }

  .pricing-card {
    background-color: var(--acid);
    border-radius: 8px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .pricing-label {
    font-family: var(--font-mono);
    font-size: var(--label-size);
    font-weight: var(--label-weight);
    letter-spacing: var(--label-letter-spacing);
    text-transform: uppercase;
    color: var(--text-on-acid);
    margin: 0;
  }

  .pricing-price {
    font-family: var(--font-sans);
    font-size: 64px;
    font-weight: var(--font-weight-bold);
    line-height: 1;
    letter-spacing: var(--heading-letter-spacing);
    color: var(--text-on-acid);
    margin: 0;
  }

  .pricing-billing {
    font-size: var(--font-size-body);
    color: var(--text-on-acid-muted);
    margin: 0;
  }

  .pricing-teaser {
    font-size: var(--font-size-body);
    font-style: italic;
    color: var(--text-on-acid-muted);
    margin: 0 0 12px;
  }

  .pricing-cta {
    margin-top: 8px;
  }

  .pricing-micro {
    font-size: var(--font-size-14);
    color: var(--text-on-acid-muted);
    margin: 8px 0 0;
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 1024px) {
    .sample-hero-glow-1,
    .sample-hero-glow-2 {
      opacity: 0.3;
    }

    .sample-blocks-inner {
      gap: 40px;
    }

    .pricing-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .pricing-card {
      max-width: 480px;
    }
  }

  @media (max-width: 768px) {
    .sample-hero {
      min-height: auto;
      padding: 180px 20px 60px;
      margin-top: -80px;
    }

    .sample-hero-headline {
      font-size: clamp(32px, 10vw, 48px);
    }

    .sample-hero-ctas {
      flex-direction: column;
      align-items: flex-start;
    }

    .sample-blocks-section,
    .sample-faq-section,
    .pricing-section {
      padding: 80px 20px;
    }

    .sample-blocks-headline,
    .sample-faq-headline,
    .pricing-headline {
      font-size: clamp(28px, 8vw, 48px);
    }

    .pricing-card {
      padding: 24px;
    }

    .pricing-price {
      font-size: 48px;
    }
  }
</style>
