---
// Pricing Page - Basalio founder pre-sale
// Cohesive design using existing site components and patterns

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import FAQ from '../components/FAQ.astro';
import PricingCards from '../components/patterns/PricingCards.astro';
import HeaderSplit from '../components/patterns/HeaderSplit.astro';
import { getFaqs } from '../data/faq';
import { CHECKOUT_STATE, FOUNDER_PRICE, POST_CAP_PRICE } from '../data/pricing';

const title = "Pricing - Basalio";
const description = "The nine blocks are free forever. The Pro control center is one payment for the first 100 people.";

const supportEmail = "hello@basalio.com";
const founderPrice = FOUNDER_PRICE;
const postCapPrice = POST_CAP_PRICE;
const proShipTarget = "February 2027";
const refundWindow = "30";

// Correct nine block names from src/data/pricing.ts
const blockNames = [
  "Grid Reveal",
  "Case Study Transition",
  "Text Reveal",
  "Magnetic Button",
  "Before/After",
  "Filterable Grid",
  "Custom Cursor",
  "Scroll Sequence",
  "Pinned Scroll"
];

// Build status rows - verified against actual repo state
const buildStatus = [
  { item: "Nine interaction blocks", status: "IN TESTING", note: `${blockNames.join(", ")}. In testing, shipping free.` },
  { item: "Four free Hacks", status: "LIVE", note: "Copy-paste snippets available now on /hacks." },
  { item: "WordPress.org listing", status: "NOT SUBMITTED", note: "Submission planned after launch." },
  { item: "Pro control center sidebar", status: "NOT STARTED", note: `Target ship date: ${proShipTarget}. Editor sidebar for live tuning.` },
  { item: "Full Hacks vault (5 recipes)", status: "IN PROGRESS", note: "Specced, not built. Founder licenses include all five as they ship." },
  { item: "One-click hack-trailer effects", status: "PLANNED", note: "Follows Pro sidebar launch." },
  { item: "WordPress version compatibility", status: "ONGOING", note: "Testing against beta and RC releases before launch." }
];

const faqs = getFaqs(postCapPrice, proShipTarget);
---

<BaseLayout {title} {description}>
  <!-- HEADER: Navigation bar -->
  <Fragment slot="header">
    <Header />
  </Fragment>

  <!-- 1. PRICING TIERS SECTION: HeaderSplit with pricing cards in right slot -->
  <section class="pricing-hero-section">
    <HeaderSplit
      eyebrow="PRICING"
      heading="The blocks are free. The Pro layer is one payment, once."
      body={`Nine interaction blocks, free forever on WordPress.org: no locked blocks, no watermarks, no instance limits. The Pro control center and the full Hacks vault are a single ${founderPrice} founder license for the first 100 people.`}
      level="h1"
      surface="paper"
    >
      <PricingCards variant="full" level="h2" />
    </HeaderSplit>
  </section>

  <!-- 2. BUILD LEDGER SECTION -->
  <section class="ledger-section">
    <div class="ledger-container">
      <div class="ledger-header">
        <p class="ledger-eyebrow">TRANSPARENCY</p>
        <h2 class="ledger-title">What's built, what isn't</h2>
        <p class="ledger-description">A founder license is partly a bet on unfinished work. Below is the real status.</p>
      </div>

      <div class="ledger-table">
        {buildStatus.map((row) => (
          <div class="ledger-row">
            <div class="ledger-item-name">{row.item}</div>
            <div class={`ledger-status ledger-${row.status.toLowerCase().replace(/\s+/g, '-')}`}>
              <span class="status-badge">{row.status}</span>
            </div>
            <div class="ledger-item-note">{row.note}</div>
          </div>
        ))}
      </div>

      <p class="ledger-footer">Nothing on this page is described as finished when it isn't. If a row moves, this table moves with it.</p>
    </div>
  </section>

  <!-- 3. RISK REVERSAL SECTION -->
  <section class="risk-section">
    <div class="risk-container">
      {CHECKOUT_STATE === 'founder' ? (
        <>
          <h2 class="risk-title">If I don't ship it</h2>
          <div class="risk-content">
            <p>Basalio is built by one person. You should know what that means before you pay.</p>
            <p>The nine blocks are free whether or not you buy anything. They don't depend on me staying in business. The Pro layer does. So: refundable at any time until the Pro control center ships. If it never ships, you never lose your money.</p>
            <p>Everything is GPL-2.0-or-later. If I disappear tomorrow, the code you have keeps working and stays yours to fork.</p>
          </div>
        </>
      ) : (
        <>
          <h2 class="risk-title">30 days to try it</h2>
          <div class="risk-content">
            <p>30-day refund, no questions asked. If it isn't what you expected, tell us and we'll refund it.</p>
            <p>Everything is GPL-2.0-or-later. If I disappear tomorrow, the code you have keeps working and stays yours to fork.</p>
          </div>
        </>
      )}
    </div>
  </section>

  <!-- 4. FAQ SECTION -->
  <section class="faq-wrapper">
    <FAQ {faqs} heading="Questions" />
  </section>

  <!-- FOOTER -->
  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const faqButtons = document.querySelectorAll('.faq-question');

    faqButtons.forEach(button => {
      button.addEventListener('click', () => {
        const faqItem = button.closest('.faq-item');
        const isOpen = faqItem.classList.contains('open');

        // Close all other items
        document.querySelectorAll('.faq-item.open').forEach(item => {
          if (item !== faqItem) {
            item.classList.remove('open');
          }
        });

        // Toggle current item
        if (isOpen) {
          faqItem.classList.remove('open');
        } else {
          faqItem.classList.add('open');
        }
      });
    });
  });
</script>

<style>
  /* PRICING HERO SECTION: Top padding for breathing room from header */
  .pricing-hero-section {
    width: 100%;
    padding-top: 250px;
    background: var(--surface-alt);
  }

  /* 2. BUILD LEDGER SECTION */
  .ledger-section {
    width: 100%;
    background: var(--surface-paper);
    padding: 80px 40px;
    box-sizing: border-box;
  }

  .ledger-container {
    width: 100%;
    max-width: 1786px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .ledger-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ledger-eyebrow {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .ledger-title {
    font-size: 40px;
    font-weight: 400;
    line-height: 48px;
    letter-spacing: var(--heading-letter-spacing);
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .ledger-description {
    font-size: var(--font-size-body);
    font-weight: 400;
    line-height: 24px;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
  }

  .ledger-table {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--surface-alt);
    border-bottom: 1px solid var(--surface-alt);
  }

  .ledger-row {
    display: grid;
    grid-template-columns: 1.5fr 140px 1fr;
    gap: 40px;
    padding: 24px 0;
    border-bottom: 1px solid var(--surface-alt);
    align-items: flex-start;
  }

  .ledger-row:last-child {
    border-bottom: none;
  }

  .ledger-item-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .ledger-status {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .status-badge {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 6px 10px;
    border-radius: 4px;
    display: inline-block;
    white-space: nowrap;
  }

  .ledger-live .status-badge {
    background: var(--acid);
    color: var(--text-on-paper);
  }

  .ledger-in-build .status-badge {
    border: 1px solid var(--text-on-paper);
    color: var(--text-on-paper);
    background: transparent;
  }

  .ledger-planned .status-badge {
    background: var(--surface-alt);
    color: var(--text-on-paper);
  }

  .ledger-ongoing .status-badge {
    background: var(--surface-alt);
    color: var(--text-on-paper);
  }

  .ledger-in-review .status-badge {
    border: 1px solid var(--text-on-paper);
    color: var(--text-on-paper);
    background: transparent;
  }

  .ledger-item-note {
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
  }

  .ledger-footer {
    font-size: 13px;
    font-weight: 400;
    line-height: 19.5px;
    color: rgba(0, 0, 0, 0.5);
    margin: 20px 0 0 0;
    padding: 20px 0 0 0;
    border-top: 1px solid var(--surface-alt);
  }

  /* 3. RISK REVERSAL SECTION */
  .risk-section {
    width: 100%;
    background: var(--surface-paper);
    padding: 80px 40px;
    box-sizing: border-box;
  }

  .faq-wrapper {
    background: var(--surface-paper);
  }

  .risk-container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .risk-title {
    font-size: 40px;
    font-weight: 400;
    line-height: 48px;
    letter-spacing: var(--heading-letter-spacing);
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .risk-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .risk-content p {
    font-size: var(--font-size-body);
    font-weight: 400;
    line-height: 24px;
    color: var(--text-on-paper-muted);
    margin: 0;
    padding: 0;
  }

  /* Custom pricing cards grid */
  .pricing-cards-grid {
    display: flex;
    flex-direction: row;
    gap: 20px;
    width: 100%;
  }

  /* Individual pricing card */
  .pricing-card {
    flex: 1 1 0%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0;
    background: var(--surface-paper);
    border-radius: 6px;
    padding: 24px;
    box-sizing: border-box;
  }

  .pricing-card-founder {
    background: var(--acid);
  }

  /* Card header: label, name, price */
  .card-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    flex: 0 0 auto;
  }

  /* Card content: expands to fill available space */
  .card-content {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .card-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.7);
  }

  .card-name {
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .card-price {
    font-size: 28px;
    font-weight: 600;
    color: var(--text-on-paper);
    margin: 0;
    padding: 0;
  }

  .card-price-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .price-main {
    font-size: 28px;
    font-weight: 600;
    color: var(--text-on-paper);
  }

  .price-note {
    font-size: 13px;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.6);
  }

  .price-after {
    font-size: 13px;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.6);
  }

  /* Card deck (description) */
  .card-deck {
    font-size: 15px;
    font-weight: 400;
    line-height: 22px;
    color: rgba(0, 0, 0, 0.85);
    margin: 0 0 20px 0;
    padding: 0;
  }

  /* Card features list */
  .card-features {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .feature-item {
    font-size: 13px;
    font-weight: 400;
    line-height: 18px;
    color: rgba(0, 0, 0, 0.8);
    margin: 0;
    padding: 12px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .feature-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* Card benefits (secondary info) */
  .card-benefit {
    font-size: 13px;
    font-weight: 400;
    line-height: 18px;
    color: rgba(0, 0, 0, 0.7);
    margin: 0 0 10px 0;
    padding: 0;
  }

  .card-benefit:last-of-type {
    margin-bottom: 0;
  }

  /* Card footnote */
  .card-footnote {
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    color: rgba(0, 0, 0, 0.5);
    margin: 0 0 20px 0;
    padding: 0;
  }

  /* Card footer wrapper (CTA + micro text) */
  .card-footer {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 0 0 auto;
    margin-top: 20px;
  }

  /* CTA buttons */
  .card-cta {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Micro text under CTA */
  .card-micro {
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    color: rgba(0, 0, 0, 0.6);
    margin: 0;
    padding: 0;
    text-align: left;
  }

  /* Pricing section responsive */
  @media (max-width: 1024px) {
    .pricing-inner {
      flex-direction: column;
      gap: 40px;
      padding: 0 20px 40px 20px;
    }

    .pricing-left {
      flex: 1 1 100%;
    }

    .pricing-heading {
      font-size: 32px;
      line-height: 40px;
    }

    .pricing-subhead {
      font-size: 15px;
      line-height: 22px;
    }
  }

  @media (max-width: 768px) {
    .pricing-hero-section {
      padding-top: 150px;
    }

    .pricing-inner {
      flex-direction: column;
      gap: 30px;
      padding: 0 20px 30px 20px;
    }

    .pricing-heading {
      font-size: 28px;
      line-height: 36px;
    }

    .pricing-subhead {
      font-size: 14px;
      line-height: 20px;
    }
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .ledger-section {
      padding: 60px 20px;
    }

    .ledger-title {
      font-size: 32px;
    }

    .ledger-row {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .risk-section {
      padding: 60px 20px;
    }

    .risk-title {
      font-size: 32px;
    }
  }

  @media (max-width: 768px) {
    .ledger-section {
      padding: 40px 20px;
    }

    .ledger-title {
      font-size: 28px;
      line-height: 36px;
    }

    .ledger-row {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 16px 0;
    }

    .risk-section {
      padding: 40px 20px;
    }

    .risk-title {
      font-size: 28px;
      line-height: 36px;
    }

  }
</style>
