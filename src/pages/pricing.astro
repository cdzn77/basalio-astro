---
// Pricing Page — Basalio founder pre-sale
// Cohesive design using existing site components and patterns

import RampTemplateLayout from '../layouts/RampTemplateLayout.astro';
import RampHeader from '../components/RampHeader.astro';
import RampRetainer from '../components/RampRetainer.astro';
import RampFAQ from '../components/RampFAQ.astro';
import RampFooter from '../components/RampFooter.astro';

const title = "Pricing — Basalio";
const description = "The nine blocks are free forever. The Pro control center is one payment for the first 100 people.";

const supportEmail = "hello@basalio.com";
const founderPrice = "$149";
const postCapPrice = "$249";
const proShipTarget = "October 2026";
const refundWindow = "30 days";

// Build status rows — verified against actual repo state
const buildStatus = [
  { item: "Nine interaction blocks", status: "LIVE", note: "Grid Reveal, Case Study Transition, Scroll Sequence, Image Counter, Timeline, Image Carousel, Fullscreen Video, Smooth Scroll, Hover Effects. In testing, shipping free." },
  { item: "Four free Hacks", status: "LIVE", note: "Copy-paste snippets available now on /hacks." },
  { item: "WordPress.org listing", status: "IN REVIEW", note: "Plugin submitted. Public download coming at launch." },
  { item: "Pro control center sidebar", status: "IN BUILD", note: `Target ship date: ${proShipTarget}. Editor sidebar for live tuning.` },
  { item: "Full Hacks vault (12+)", status: "IN BUILD", note: "Grows continuously post-launch." },
  { item: "One-click hack-trailer effects", status: "PLANNED", note: "Follows Pro sidebar launch." },
  { item: "WordPress version compatibility", status: "ONGOING", note: "Testing against beta and RC releases before launch." }
];

// FAQ items — pricing-focused questions
const faqs = [
  {
    question: "Do the nine blocks stay free?",
    answer: `Yes. All nine, complete, on WordPress.org, forever. No block moves behind Pro. Free is not a trial—the free tier is not a countdown.`
  },
  {
    question: "It's GPL — why pay for it?",
    answer: `You're not paying for permission; GPL already grants that. You're paying for the Hacks vault, the sidebar, and the work of testing against every WordPress release before it lands. The code is free. Maintaining it isn't.`
  },
  {
    question: "How many sites?",
    answer: `Unlimited sites per license. Works on client sites, personal projects, anything.`
  },
  {
    question: "What happens after the 100 founder licenses?",
    answer: `The price goes to ${postCapPrice} once 100 founder licenses are gone or the Pro control center ships (October 2026), whichever happens first. Founder licenses stay valid, keep every future block and Hack, and are never re-billed.`
  },
  {
    question: "What if my license lapses?",
    answer: `It can't. One payment, no renewal, no subscription. Your site keeps working with or without me.`
  },
  {
    question: "Does my content break if I uninstall?",
    answer: `No. Basalio is theme-agnostic and your content survives uninstall. Interactions stop; the content stays.`
  },
  {
    question: "Is it actually lightweight?",
    answer: `One shared script, loaded only on pages that use a block. See /compatibility for the numbers.`
  },
  {
    question: "When does Pro ship?",
    answer: `${proShipTarget}. If it doesn't, see the refund guarantee below.`
  },
  {
    question: "Will it ever be cheaper than $149?",
    answer: `No. $149 is the lowest Basalio Pro will ever be. There is no launch sale coming and no discount below this.`
  }
];
---

<RampTemplateLayout {title} {description}>
  <!-- HEADER: Navigation bar -->
  <Fragment slot="header">
    <RampHeader />
  </Fragment>

  <!-- 1. PRICING TIERS SECTION: Using existing RampRetainer component -->
  <RampRetainer
    sectionLabel="PRICING"
    sectionHeading="The blocks are free. The Pro layer is one payment, once."
  />

  <!-- 2. BUILD LEDGER SECTION -->
  <section class="ledger-section">
    <div class="ledger-container">
      <div class="ledger-header">
        <p class="ledger-eyebrow">TRANSPARENCY</p>
        <h2 class="ledger-title">What's built, what isn't</h2>
        <p class="ledger-description">A founder license is partly a bet on work that isn't finished. Here's the honest state of it.</p>
      </div>

      <div class="ledger-table">
        {buildStatus.map((row) => (
          <div class="ledger-row">
            <div class="ledger-item-name">{row.item}</div>
            <div class={`ledger-status ledger-${row.status.toLowerCase().replace(/\s+/g, '-')}`}>
              <span class="status-badge">{row.status}</span>
            </div>
            <div class="ledger-item-note">{row.note}</div>
          </div>
        ))}
      </div>

      <p class="ledger-footer">Nothing on this page is described as finished when it isn't. If a row moves, this table moves with it.</p>
    </div>
  </section>

  <!-- 3. RISK REVERSAL SECTION -->
  <section class="risk-section">
    <div class="risk-container">
      <h2 class="risk-title">If I don't ship it</h2>

      <div class="risk-content">
        <p>Basalio is built by one person. You should know what that means before you pay.</p>

        <p>The nine blocks are free whether or not you ever buy anything — they don't depend on me staying in business. The Pro layer does. So: a {refundWindow}-day refund, no questions and no form. And if the Pro control center hasn't shipped by {proShipTarget}, email {supportEmail} and I refund you in full, past the window, no argument.</p>

        <p>Everything is GPL-2.0-or-later. If I disappear tomorrow, the code you have keeps working and stays yours to fork.</p>
      </div>
    </div>
  </section>

  <!-- 4. FAQ SECTION -->
  <section class="pricing-faq">
    <RampFAQ {faqs} />
  </section>

  <!-- FOOTER -->
  <Fragment slot="footer">
    <RampFooter address="Østerbrogade 45, 2100 København Ø, Copenhagen, Denmark" />
  </Fragment>
</RampTemplateLayout>

<style>
  /* 2. BUILD LEDGER SECTION */
  .ledger-section {
    width: 100%;
    background: #FFFFFF;
    padding: 80px 40px;
    box-sizing: border-box;
  }

  .ledger-container {
    width: 100%;
    max-width: 1786px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .ledger-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ledger-eyebrow {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: #000000;
    margin: 0;
    padding: 0;
  }

  .ledger-title {
    font-size: 40px;
    font-weight: 400;
    line-height: 48px;
    letter-spacing: -0.8px;
    color: #000000;
    margin: 0;
    padding: 0;
  }

  .ledger-description {
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #575757;
    margin: 0;
    padding: 0;
  }

  .ledger-table {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid #E8E8E8;
    border-bottom: 1px solid #E8E8E8;
  }

  .ledger-row {
    display: grid;
    grid-template-columns: 1.5fr 140px 1fr;
    gap: 40px;
    padding: 24px 0;
    border-bottom: 1px solid #E8E8E8;
    align-items: flex-start;
  }

  .ledger-row:last-child {
    border-bottom: none;
  }

  .ledger-item-name {
    font-size: 15px;
    font-weight: 600;
    color: #000000;
    margin: 0;
    padding: 0;
  }

  .ledger-status {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .status-badge {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 6px 10px;
    border-radius: 4px;
    display: inline-block;
    white-space: nowrap;
  }

  .ledger-live .status-badge {
    background: #FFEA00;
    color: #000000;
  }

  .ledger-in-build .status-badge {
    border: 1px solid #000000;
    color: #000000;
    background: transparent;
  }

  .ledger-planned .status-badge {
    background: #E8E8E8;
    color: #000000;
  }

  .ledger-ongoing .status-badge {
    background: #E8E8E8;
    color: #000000;
  }

  .ledger-in-review .status-badge {
    border: 1px solid #000000;
    color: #000000;
    background: transparent;
  }

  .ledger-item-note {
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    color: #575757;
    margin: 0;
    padding: 0;
  }

  .ledger-footer {
    font-size: 13px;
    font-weight: 400;
    line-height: 19.5px;
    color: rgba(0, 0, 0, 0.5);
    margin: 20px 0 0 0;
    padding: 20px 0 0 0;
    border-top: 1px solid #E8E8E8;
  }

  /* 3. RISK REVERSAL SECTION */
  .risk-section {
    width: 100%;
    background: #FFFFFF;
    padding: 80px 40px;
    box-sizing: border-box;
  }

  .risk-container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .risk-title {
    font-size: 40px;
    font-weight: 400;
    line-height: 48px;
    letter-spacing: -0.8px;
    color: #000000;
    margin: 0;
    padding: 0;
  }

  .risk-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .risk-content p {
    font-size: 16px;
    font-weight: 400;
    line-height: 28px;
    color: #575757;
    margin: 0;
    padding: 0;
  }

  /* 4. FAQ SECTION */
  .pricing-faq {
    width: 100%;
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .ledger-section {
      padding: 60px 20px;
    }

    .ledger-title {
      font-size: 32px;
    }

    .ledger-row {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .risk-section {
      padding: 60px 20px;
    }

    .risk-title {
      font-size: 32px;
    }
  }

  @media (max-width: 768px) {
    .ledger-section {
      padding: 40px 20px;
    }

    .ledger-title {
      font-size: 28px;
      line-height: 36px;
    }

    .ledger-row {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 16px 0;
    }

    .risk-section {
      padding: 40px 20px;
    }

    .risk-title {
      font-size: 28px;
      line-height: 36px;
    }

    .risk-content p {
      font-size: 15px;
      line-height: 24px;
    }
  }
</style>
