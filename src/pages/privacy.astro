---
import BaseLayout from '../layouts/BaseLayout.astro';
import RampHeader from '../components/RampHeader.astro';
import RampFooter from '../components/RampFooter.astro';

const title = "Privacy Policy - Basalio";
const description = "Privacy Policy for Basalio. Applies to basalio.so and the Basalio plugin dashboard.";
---

<BaseLayout {title} {description}>
  <Fragment slot="header">
    <RampHeader />
  </Fragment>

  <section class="privacy-header">
    <div class="privacy-container">
      <p class="privacy-eyebrow">Legal</p>
      <h1 class="privacy-heading">Privacy Policy</h1>
      <p class="privacy-effective">Effective July 9, 2026. Applies to basalio.so and the Basalio plugin dashboard.</p>

      <div class="privacy-scope">
        <span class="scope-label">Scope</span>
        <p class="scope-text">This covers data we collect about you: beta testers, license holders, site visitors. It doesn't cover data your own portfolio visitors generate, Basalio's blocks don't track them, and we never see your site's content.</p>
      </div>

      <div class="privacy-nav">
        <a href="#collect" class="privacy-nav-link">What we collect</a>
        <a href="#use" class="privacy-nav-link">How we use it</a>
        <a href="#dont" class="privacy-nav-link">What we don't do</a>
        <a href="#thirdparty" class="privacy-nav-link">Third parties</a>
        <a href="#rights" class="privacy-nav-link">Your rights</a>
      </div>
    </div>
  </section>

  <section class="privacy-content">
    <div class="privacy-container">
      <div id="collect" class="privacy-section">
        <p class="section-number">01</p>
        <h2 class="section-heading">Information we collect</h2>
        <p class="section-text"><strong>Directly from you:</strong></p>
        <ul class="section-list">
          <li>Email address, when you join the beta waitlist or the newsletter</li>
          <li>Name and payment details, handled entirely by our checkout provider, when you buy a license</li>
          <li>Anything you send us directly, support emails, block suggestions, bug reports</li>
        </ul>
        <p class="section-text"><strong>Automatically, from the plugin itself:</strong></p>
        <ul class="section-list">
          <li>Your license key and the site URL it's activated on, so updates and support work</li>
          <li>Basalio version and WordPress version, sent only when checking for updates, standard for any WordPress plugin</li>
        </ul>
      </div>

      <div id="use" class="privacy-section">
        <p class="section-number">02</p>
        <h2 class="section-heading">How we use it</h2>
        <ul class="section-list">
          <li><strong>Updates and support:</strong> We use your license key and site URL to deliver plugin updates and to respond to support requests</li>
          <li><strong>Communication:</strong> We send newsletters about new blocks, features, and bug fixes only to those who asked for them</li>
          <li><strong>Security and abuse prevention:</strong> We monitor for patterns of misuse or fraud</li>
          <li><strong>Analytics (aggregated only):</strong> We count how many sites use each block, how often, to guide our development priorities</li>
        </ul>
      </div>

      <div id="dont" class="privacy-section">
        <p class="section-number">03</p>
        <h2 class="section-heading">What we don't do</h2>
        <ul class="section-list">
          <li><strong>We don't sell your data.</strong> Not to marketers, not to analytics firms, not to anyone</li>
          <li><strong>We don't track you across the web.</strong> Basalio doesn't use pixels, tags, or cookies to follow you on other sites</li>
          <li><strong>We don't use third-party trackers.</strong> Your data doesn't go to Google Analytics, Segment, or similar</li>
          <li><strong>We don't profile or build behavioral dossiers.</strong> We care about what you build, not your browsing habits</li>
        </ul>
      </div>

      <div id="thirdparty" class="privacy-section">
        <p class="section-number">04</p>
        <h2 class="section-heading">Third parties we work with</h2>
        <ul class="section-list">
          <li><strong>Stripe:</strong> Handles all payment processing. We never touch your card data. <a href="https://stripe.com/privacy" target="_blank" rel="noopener">Stripe privacy policy</a></li>
          <li><strong>Netlify:</strong> Hosts this site. <a href="https://www.netlify.com/privacy/" target="_blank" rel="noopener">Netlify privacy policy</a></li>
          <li><strong>GitHub:</strong> Stores our code. <a href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement" target="_blank" rel="noopener">GitHub privacy policy</a></li>
        </ul>
      </div>

      <div id="rights" class="privacy-section">
        <p class="section-number">05</p>
        <h2 class="section-heading">Your rights</h2>
        <p class="section-text">Under GDPR, CCPA, and similar laws, you have the right to:</p>
        <ul class="section-list">
          <li><strong>Access:</strong> Get a copy of the data we have about you</li>
          <li><strong>Correct:</strong> Fix inaccuracies</li>
          <li><strong>Delete:</strong> Request we erase your data (we will, within legal obligations)</li>
          <li><strong>Restrict:</strong> Ask us not to process your data for certain purposes</li>
          <li><strong>Port:</strong> Get your data in a portable format</li>
        </ul>
        <p class="section-text">To exercise any of these rights, email <a href="mailto:hello@basalio.com">hello@basalio.com</a> with "Privacy Request" in the subject line.</p>
      </div>

      <div id="contact" class="privacy-section">
        <p class="section-number">06</p>
        <h2 class="section-heading">Questions?</h2>
        <p class="section-text">Email <a href="mailto:hello@basalio.com">hello@basalio.com</a> with any questions.</p>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <RampFooter hideNewsletter={true} />
  </Fragment>
</BaseLayout>

<style>
  .privacy-header {
    background: var(--surface-ink);
    padding: 220px 32px 40px;
  }

  .privacy-container {
    max-width: 760px;
    margin: 0 auto;
  }

  .privacy-eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-on-ink-muted);
    margin: 0 0 16px 0;
  }

  .privacy-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    font-size: clamp(30px, 4vw, 44px);
    margin: 0 0 12px 0;
    color: var(--text-on-ink);
  }

  .privacy-effective {
    color: var(--text-on-ink-muted);
    font-size: 14px;
    margin: 0 0 24px 0;
  }

  .privacy-scope {
    display: flex;
    gap: 14px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 16px 18px;
    margin-bottom: 24px;
  }

  .scope-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-on-ink-muted);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    padding: 3px 10px;
    flex-shrink: 0;
  }

  .scope-text {
    font-size: 13.5px;
    color: var(--text-on-ink-muted);
    margin: 0;
  }

  .privacy-nav {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .privacy-nav-link {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--text-on-ink-muted);
    border: 1px solid var(--border-on-ink);
    border-radius: 999px;
    padding: 6px 14px;
    transition: border-color 0.15s ease, color 0.15s ease;
    text-decoration: none;
  }

  .privacy-nav-link:hover {
    border-color: var(--acid);
    color: var(--text-on-ink);
  }

  .privacy-content {
    background: var(--surface-ink);
    padding: 24px 32px 80px;
  }

  .privacy-section {
    padding-top: 40px;
  }

  .privacy-section:first-child {
    padding-top: 24px;
  }

  .section-number {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--text-on-ink-muted);
    margin: 0 0 8px 0;
  }

  .section-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 22px;
    margin: 0 0 14px 0;
    color: var(--text-on-ink);
  }

  .section-text {
    color: var(--text-on-ink-muted);
    font-size: 15px;
    line-height: 1.7;
    margin: 0 0 12px 0;
  }

  .section-list {
    color: var(--text-on-ink-muted);
    font-size: 15px;
    line-height: 1.7;
    margin: 0 0 16px 0;
    padding-left: 20px;
  }

  .section-list li {
    margin-bottom: 8px;
  }

  .section-list a {
    color: var(--acid);
    text-decoration: none;
  }

  .section-list a:hover {
    color: var(--text-on-ink);
  }

  @media (max-width: 768px) {
    .privacy-header {
      padding: 100px 20px 30px;
    }

    .privacy-content {
      padding: 24px 20px 50px;
    }

    .privacy-heading {
      font-size: clamp(26px, 3.6vw, 38px);
    }

    .section-heading {
      font-size: 18px;
    }
  }
</style>
