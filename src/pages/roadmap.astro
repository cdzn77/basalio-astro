---
import BaseLayout from '../layouts/BaseLayout.astro';
import RampHeader from '../components/RampHeader.astro';
import RampFooter from '../components/RampFooter.astro';
import HeaderSplit from '../components/patterns/HeaderSplit.astro';

const title = "Roadmap - Basalio";
const description = "Basalio development roadmap. See what's coming next for the nine interaction blocks.";

const roadmapItems = [
  {
    status: 'IN TESTING',
    title: 'Nine Core Blocks',
    date: 'June 2026',
    description: 'Grid Reveal, Case Study Transition, Text Reveal, Magnetic Button, Before/After, Filterable Grid, Custom Cursor, Scroll Sequence, Pinned Scroll. Built and in testing. Shipping free forever on WordPress.org when submission completes.'
  },
  {
    status: 'SHIPPED',
    title: 'Free Hacks Vault',
    date: 'June 2026',
    description: 'Four free CSS/JS snippets. Reveal on Scroll, Color Peek, Tilt Effect, Typewriter Text. Copy-paste into any site.'
  },
  {
    status: 'NOT STARTED',
    title: 'Pro Control Center',
    date: 'February 2027',
    description: 'Editor sidebar for live-tuning every block. Adjust timing, easing, colors, and behavior without leaving WordPress. Target ship date: February 2027. Launch date is a hard commitment.'
  },
  {
    status: 'IN PROGRESS',
    title: 'Full Hacks Vault (12+)',
    date: 'Q2 2027',
    description: '12+ CSS/JS effects. Refraction, Glitch, 3D Flip, Hover Trail, and more. Four available now. The full vault grows post-launch. Open-source, free to copy-paste.'
  },
  {
    status: 'PLANNED',
    title: 'Block Pack #2',
    date: 'Q3 2027',
    description: 'Five new blocks. Parallax Reveal, Stagger Load, Morphing Button, Video Timeline, Infinite Carousel. Free forever on WordPress.org.'
  },
  {
    status: 'PLANNED',
    title: 'Design System Template',
    date: 'Q4 2027',
    description: 'Pre-made design tokens library. Colors, typography, spacing, animations. Download, customize for your brand, apply to all blocks at once.'
  },
  {
    status: 'IN REVIEW',
    title: 'WordPress.org Listing',
    date: 'Post-launch',
    description: 'Official WordPress plugin directory. Submission planned after launch. Makes discovery and updates simpler.'
  }
];
---

<BaseLayout {title} {description}>
  <Fragment slot="header">
    <RampHeader />
  </Fragment>

  <!-- HERO: Light background header with eyebrow, heading, body -->
  <HeaderSplit
    eyebrow="Coming Soon"
    heading="Roadmap"
    body="Here's what we're building next. Priorities can shift, but we ship what we promise."
    surface="alt"
  />

  <!-- TIMELINE: Roadmap items on light background -->
  <section class="roadmap-content">
    <div class="roadmap-container">
      {roadmapItems.map((item) => (
        <div class="roadmap-item">
          <div class={`roadmap-marker roadmap-${item.status.toLowerCase().replace(/\s+/g, '-')}`}>
            {item.status}
          </div>
          <div class="roadmap-item-content">
            <h2 class="roadmap-item-title">{item.title}</h2>
            <p class="roadmap-item-date">{item.date}</p>
            <p class="roadmap-item-description">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- NOTES: Explanatory text on light background -->
  <section class="roadmap-notes">
    <div class="roadmap-container">
      <h2 class="notes-heading">Notes</h2>
      <ul class="notes-list">
        <li><strong>All nine blocks are free forever.</strong> No paywall, no locked features, no watermarks. Free is not a trial or a countdown.</li>
        <li><strong>Pro tier is optional.</strong> The control center sidebar is the only paid feature. Everything else ships free.</li>
        <li><strong>Dates are best-guesses.</strong> We ship when ready, not on calendars. Launch date for Pro is the only hard deadline.</li>
        <li><strong>Roadmap changes if users ask.</strong> Open an issue on GitHub or email hello@basalio.com with feature requests. Big asks can shift priorities.</li>
        <li><strong>Security updates come first.</strong> If a block has a vulnerability, we patch it before roadmap items.</li>
      </ul>
    </div>
  </section>

  <Fragment slot="footer">
    <RampFooter hideNewsletter={true} />
  </Fragment>
</BaseLayout>

<style>
  .roadmap-container {
    max-width: 760px;
    margin: 0 auto;
  }

  .roadmap-content {
    background: var(--surface-paper);
    padding: 60px 40px;
  }

  .roadmap-item {
    padding-bottom: 40px;
    margin-bottom: 40px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .roadmap-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .roadmap-marker {
    display: inline-block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 4px;
    margin-bottom: 12px;
    font-weight: 600;
  }

  .roadmap-shipped {
    background: var(--acid);
    color: var(--text-on-acid);
    border: none;
  }

  .roadmap-in-progress {
    background: transparent;
    color: var(--text-on-paper);
    border: 1px solid rgba(0, 0, 0, 0.2);
  }

  .roadmap-planned {
    background: var(--stone);
    color: var(--text-on-paper);
    border: none;
  }

  .roadmap-in-review {
    background: transparent;
    color: var(--text-on-paper);
    border: 1px solid rgba(0, 0, 0, 0.2);
  }

  .roadmap-not-started {
    background: transparent;
    color: var(--text-on-paper);
    border: 1px solid rgba(0, 0, 0, 0.2);
  }

  .roadmap-item-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .roadmap-item-title {
    font-size: 20px;
    font-weight: 600;
    margin: 0;
    color: var(--text-on-paper);
  }

  .roadmap-item-date {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--text-on-paper-muted);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .roadmap-item-description {
    color: var(--text-on-paper-muted);
    font-size: 15px;
    line-height: 1.7;
    margin: 0;
  }

  .roadmap-notes {
    background: var(--surface-paper);
    padding: 60px 40px;
  }

  .notes-heading {
    font-size: 40px;
    font-weight: 400;
    line-height: 48px;
    letter-spacing: -0.8px;
    margin: 0 0 24px 0;
    color: var(--text-on-paper);
  }

  .notes-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .notes-list li {
    color: var(--text-on-paper-muted);
    font-size: 15px;
    line-height: 1.7;
    margin: 0;
  }

  .notes-list li strong {
    color: var(--text-on-paper);
  }

  @media (max-width: 1024px) {
    .roadmap-content,
    .roadmap-notes {
      padding: 40px 30px;
    }

    .notes-heading {
      font-size: 32px;
      line-height: 40px;
    }
  }

  @media (max-width: 640px) {
    .roadmap-content,
    .roadmap-notes {
      padding: 30px 20px;
    }

    .roadmap-item {
      padding-bottom: 30px;
      margin-bottom: 30px;
    }

    .roadmap-item-title {
      font-size: 18px;
    }

    .notes-heading {
      font-size: 24px;
      line-height: 32px;
    }
  }
</style>
