---
import BaseLayout from '../layouts/BaseLayout.astro';
import RampHeader from '../components/RampHeader.astro';
import RampFooter from '../components/RampFooter.astro';

const title = "Roadmap - Basalio";
const description = "Basalio development roadmap. See what's coming next for the nine interaction blocks.";
---

<BaseLayout {title} {description}>
  <Fragment slot="header">
    <RampHeader />
  </Fragment>

  <section class="roadmap-header">
    <div class="roadmap-container">
      <p class="roadmap-eyebrow">Coming Soon</p>
      <h1 class="roadmap-heading">Roadmap</h1>
      <p class="roadmap-subheading">Here's what we're building next. Priorities can shift, but we ship what we promise.</p>
    </div>
  </section>

  <section class="roadmap-content">
    <div class="roadmap-container">
      <div class="roadmap-item">
        <div class="roadmap-marker roadmap-in-progress">IN TESTING</div>
        <h2 class="roadmap-item-title">Nine Core Blocks</h2>
        <p class="roadmap-item-date">June 2026</p>
        <p class="roadmap-item-description">Grid Reveal, Case Study Transition, Text Reveal, Magnetic Button, Before/After, Filterable Grid, Custom Cursor, Scroll Sequence, Pinned Scroll. Built and in testing. Shipping free forever on WordPress.org when submission completes.</p>
      </div>

      <div class="roadmap-item">
        <div class="roadmap-marker roadmap-shipped">SHIPPED</div>
        <h2 class="roadmap-item-title">Free Hacks Vault</h2>
        <p class="roadmap-item-date">June 2026</p>
        <p class="roadmap-item-description">Four free CSS/JS snippets. Reveal on Scroll, Color Peek, Tilt Effect, Typewriter Text. Copy-paste into any site.</p>
      </div>

      <div class="roadmap-item">
        <div class="roadmap-marker roadmap-planned">NOT STARTED</div>
        <h2 class="roadmap-item-title">Pro Control Center</h2>
        <p class="roadmap-item-date">February 2027</p>
        <p class="roadmap-item-description">Editor sidebar for live-tuning every block. Adjust timing, easing, colors, and behavior without leaving WordPress. Target ship date: February 2027. Launch date is a hard commitment.</p>
      </div>

      <div class="roadmap-item">
        <div class="roadmap-marker roadmap-in-progress">IN PROGRESS</div>
        <h2 class="roadmap-item-title">Full Hacks Vault (12+)</h2>
        <p class="roadmap-item-date">Q2 2027</p>
        <p class="roadmap-item-description">12+ CSS/JS effects. Refraction, Glitch, 3D Flip, Hover Trail, and more. Four available now. The full vault grows post-launch. Open-source, free to copy-paste.</p>
      </div>

      <div class="roadmap-item">
        <div class="roadmap-marker roadmap-planned">PLANNED</div>
        <h2 class="roadmap-item-title">Block Pack #2</h2>
        <p class="roadmap-item-date">Q3 2027</p>
        <p class="roadmap-item-description">Five new blocks. Parallax Reveal, Stagger Load, Morphing Button, Video Timeline, Infinite Carousel. Free forever on WordPress.org.</p>
      </div>

      <div class="roadmap-item">
        <div class="roadmap-marker roadmap-planned">PLANNED</div>
        <h2 class="roadmap-item-title">Design System Template</h2>
        <p class="roadmap-item-date">Q4 2027</p>
        <p class="roadmap-item-description">Pre-made design tokens library. Colors, typography, spacing, animations. Download, customize for your brand, apply to all blocks at once.</p>
      </div>

      <div class="roadmap-item">
        <div class="roadmap-marker roadmap-in-review">IN REVIEW</div>
        <h2 class="roadmap-item-title">WordPress.org Listing</h2>
        <p class="roadmap-item-date">Post-launch</p>
        <p class="roadmap-item-description">Official WordPress plugin directory. Submission planned after launch. Makes discovery and updates simpler.</p>
      </div>
    </div>
  </section>

  <section class="roadmap-notes">
    <div class="roadmap-container">
      <h2 class="notes-heading">Notes</h2>
      <ul class="notes-list">
        <li><strong>All nine blocks are free forever.</strong> No paywall, no locked features, no watermarks. Free is not a trial or a countdown.</li>
        <li><strong>Pro tier is optional.</strong> The control center sidebar is the only paid feature. Everything else ships free.</li>
        <li><strong>Dates are best-guesses.</strong> We ship when ready, not on calendars. Launch date for Pro is the only hard deadline.</li>
        <li><strong>Roadmap changes if users ask.</strong> Open an issue on GitHub or email hello@basalio.com with feature requests. Big asks can shift priorities.</li>
        <li><strong>Security updates come first.</strong> If a block has a vulnerability, we patch it before roadmap items.</li>
      </ul>
    </div>
  </section>

  <Fragment slot="footer">
    <RampFooter hideNewsletter={true} />
  </Fragment>
</BaseLayout>

<style>
  .roadmap-header {
    background: var(--surface-ink);
    padding: 120px 32px 60px;
  }

  .roadmap-container {
    max-width: 760px;
    margin: 0 auto;
  }

  .roadmap-eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-on-ink-muted);
    margin: 0 0 16px 0;
  }

  .roadmap-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: clamp(30px, 4vw, 44px);
    margin: 0 0 12px 0;
    color: var(--text-on-ink);
  }

  .roadmap-subheading {
    color: var(--text-on-ink-muted);
    font-size: 16px;
    margin: 0;
  }

  .roadmap-content {
    background: var(--surface-ink);
    padding: 60px 32px;
  }

  .roadmap-item {
    padding: 40px 0;
    border-bottom: 1px solid var(--border-on-ink);
  }

  .roadmap-item:last-child {
    border-bottom: none;
  }

  .roadmap-marker {
    display: inline-block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
    margin-bottom: 12px;
    font-weight: 600;
  }

  .roadmap-shipped {
    background: var(--acid);
    color: var(--text-on-acid);
    border: none;
  }

  .roadmap-in-progress {
    background: transparent;
    color: var(--text-on-ink);
    border: 1px solid var(--text-on-ink);
  }

  .roadmap-planned {
    background: var(--stone);
    color: var(--text-on-paper);
    border: none;
  }

  .roadmap-item-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 22px;
    margin: 0 0 8px 0;
    color: var(--text-on-ink);
  }

  .roadmap-item-date {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--text-on-ink-muted);
    margin: 0 0 12px 0;
  }

  .roadmap-item-description {
    color: var(--text-on-ink-muted);
    font-size: 15px;
    line-height: 1.7;
    margin: 0;
  }

  .roadmap-notes {
    background: var(--surface-ink);
    padding: 60px 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .notes-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 28px;
    margin: 0 0 24px 0;
    color: var(--text-on-ink);
  }

  .notes-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .notes-list li {
    color: var(--text-on-ink-muted);
    font-size: 15px;
    line-height: 1.7;
    margin-bottom: 16px;
    padding-left: 0;
  }

  .notes-list li strong {
    color: var(--text-on-ink);
  }

  @media (max-width: 768px) {
    .roadmap-header {
      padding: 80px 20px 40px;
    }

    .roadmap-content,
    .roadmap-notes {
      padding: 40px 20px;
    }

    .roadmap-heading {
      font-size: clamp(26px, 3.6vw, 38px);
    }

    .roadmap-item-title {
      font-size: 18px;
    }

    .notes-heading {
      font-size: 22px;
    }
  }
</style>
