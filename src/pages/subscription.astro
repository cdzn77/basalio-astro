---
// Pricing Page - Basalio WordPress Plugin Pricing
// One-time purchase model with two tiers: Free and Founder Lifetime

import RampTemplateLayout from '../layouts/RampTemplateLayout.astro';
import RampHeader from '../components/RampHeader.astro';
import RampRetainer from '../components/RampRetainer.astro';
import RampTestimonialsV2 from '../components/RampTestimonialsV2.astro';
import RampFAQ from '../components/RampFAQ.astro';
import RampFooter from '../components/RampFooter.astro';

const title = "Pricing — Basalio";
const description = "One plugin. One price. No subscription. All nine interaction modules with powerful controls for creative sites.";

const faqs = [
  {
    question: "Can I use Basalio on multiple sites with the Free tier?",
    answer: "Yes. Both Free and Founder Lifetime include unlimited sites. Free gives you all 9 blocks plus 4 free Hacks. Founder Lifetime adds the full Hacks vault and Pro control center for tuning every interaction live."
  },
  {
    question: "What's included with Founder Lifetime?",
    answer: "The $149 one-time purchase includes all 9 blocks (same as Free), the complete Hacks vault (12+ ready-to-use interactions), Pro control center for live tuning, unlimited sites with no renewal ever, and the Founder badge. Every new block and hack released is included, forever."
  },
  {
    question: "Are there any recurring fees?",
    answer: "No. Founder Lifetime is a true one-time purchase. $149, then nothing else. All future blocks and hacks are included. It's not a subscription—once you own it, you own it forever."
  },
  {
    question: "Can I upgrade from Free to Founder Lifetime later?",
    answer: "Yes. Start with Free (all 9 blocks, 4 Hacks), and upgrade to Founder Lifetime anytime. You'll only pay the difference between what Free would cost and the Founder price."
  },
  {
    question: "What if I want to use Basalio on a client site?",
    answer: "Both tiers are licensed per site owner. If you're building client sites, each client who owns their own site will need their own Founder Lifetime license. If you're reselling, that's a custom arrangement—reach out."
  },
  {
    question: "Is there a trial period?",
    answer: "Free is your trial. All 9 blocks, full functionality, 4 Hacks included. Use it on production sites, no expiration. Upgrade to Founder Lifetime if you want the full Hacks vault and Pro controls."
  }
];
---

<RampTemplateLayout title={title} description={description}>
  <!-- HEADER: Navigation bar -->
  <Fragment slot="header">
    <RampHeader />
  </Fragment>

  <!-- PRICING SECTION: Using RampRetainer component -->
  <RampRetainer
    sectionLabel="PRICING"
    sectionHeading="One plugin. One price. No subscription."
    ctaLabel="Get started"
    ctaLink="/contact"
  />

  <!-- TESTIMONIALS SECTION: "Built for people who actually make things" -->
  <section class="testimonials-rounded">
    <RampTestimonialsV2
      sectionHeading={"Built for people who\nactually make things."}
      testimonials={[
        {
          image: "/assets/uxui_whoitsfor.png",
          quote: "I stopped explaining hover states to developers. I just build them.",
          name: "UX/UI Designer",
          results: "No handoff docs needed"
        },
        {
          image: "/assets/videographer_whoitsfor.png",
          quote: "My reel finally scrolls the way it plays — frame by frame, not just fading in.",
          name: "Videographer",
          results: "Scroll Sequence, no video embed"
        },
        {
          image: "/assets/director_whoitsfor.png",
          quote: "Case studies that morph from the grid instead of just... linking to a new page.",
          name: "Director",
          results: "One shared-element transition, zero page reload"
        },
        {
          image: "/assets/agency_whoitsfor.png",
          quote: "Every client site gets the same polish — without rebuilding it every time.",
          name: "Agency",
          results: "Nine blocks, unlimited client sites"
        }
      ]}
    />
  </section>

  <!-- FAQ SECTION: Common questions about Basalio pricing -->
  <RampFAQ
    faqs={faqs}
  />

  <!-- FOOTER -->
  <Fragment slot="footer">
    <RampFooter address="Østerbrogade 45, 2100 København Ø, Copenhagen, Denmark" />
  </Fragment>
</RampTemplateLayout>

