---
import BaseLayout from '../layouts/BaseLayout.astro';
import RampHeader from '../components/RampHeader.astro';
import RampFooter from '../components/RampFooter.astro';
import HeaderSplit from '../components/patterns/HeaderSplit.astro';

const title = "Terms of Service - Basalio";
const description = "Basalio Terms of Service. Legal terms for using the WordPress plugin and blocks.";
---

<BaseLayout {title} {description}>
  <Fragment slot="header">
    <RampHeader />
  </Fragment>

  <HeaderSplit
    eyebrow="Legal"
    heading="Terms of Service"
    body="Last updated: July 2026"
    surface="alt"
  />

  <section class="terms-content">
    <div class="terms-container">
      <div class="terms-section">
        <h2 class="section-heading">1. License Grant</h2>
        <p class="section-text">Basalio provides a license to use the nine interaction blocks on WordPress.org under the GPL-2.0-or-later license. You may use, modify, and distribute the blocks under the terms of that license.</p>
        <p class="section-text">The Pro control center (when available) is licensed under a commercial single-site or multi-site license purchased from Basalio.</p>
      </div>

      <div class="terms-section">
        <h2 class="section-heading">2. Acceptable Use</h2>
        <p class="section-text">You agree not to use Basalio blocks for:</p>
        <ul class="section-list">
          <li>Illegal activities or violating any law or regulation</li>
          <li>Infringing on intellectual property rights</li>
          <li>Distributing malware or malicious code</li>
          <li>Harassing, threatening, or defaming anyone</li>
          <li>Spam or unsolicited communications</li>
        </ul>
      </div>

      <div class="terms-section">
        <h2 class="section-heading">3. Intellectual Property</h2>
        <p class="section-text">Basalio retains all intellectual property rights to the code and design of the blocks. You retain the rights to any content you create with them. The blocks themselves are provided under GPL-2.0-or-later; modifications and distributions must follow that license.</p>
      </div>

      <div class="terms-section">
        <h2 class="section-heading">4. Warranty Disclaimer</h2>
        <p class="section-text">Basalio is provided "as is" without warranty of any kind, express or implied. We do not guarantee that the blocks will be error-free or uninterrupted. Use at your own risk.</p>
      </div>

      <div class="terms-section">
        <h2 class="section-heading">5. Limitation of Liability</h2>
        <p class="section-text">Basalio is not liable for any indirect, incidental, special, consequential, or punitive damages arising from your use or inability to use the blocks, even if we've been advised of the possibility of such damages.</p>
      </div>

      <div class="terms-section">
        <h2 class="section-heading">6. Third-Party Services</h2>
        <p class="section-text">Basalio may integrate with third-party services (Stripe for payments, etc.). Your use of those services is subject to their terms. We are not responsible for third-party content or services.</p>
      </div>

      <div class="terms-section">
        <h2 class="section-heading">7. Termination</h2>
        <p class="section-text">We may terminate or suspend your access to Basalio if you violate these terms. You may stop using Basalio at any time. Your GPL rights to the free blocks continue under the license.</p>
      </div>

      <div class="terms-section">
        <h2 class="section-heading">8. Changes to These Terms</h2>
        <p class="section-text">We may update these terms at any time. Continued use of Basalio after updates constitutes acceptance of the new terms. Significant changes will be announced.</p>
      </div>

      <div class="terms-section">
        <h2 class="section-heading">9. Governing Law</h2>
        <p class="section-text">These terms are governed by the laws of the jurisdiction where Basalio is operated, without regard to its conflict of laws principles.</p>
      </div>

      <div class="terms-section">
        <h2 class="section-heading">10. Contact</h2>
        <p class="section-text">Questions about these terms? Email <a href="mailto:hello@basalio.com" class="terms-link">hello@basalio.com</a></p>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <RampFooter hideNewsletter={true} />
  </Fragment>
</BaseLayout>

<style>
  .terms-container {
    max-width: 760px;
    margin: 0 auto;
  }

  .terms-content {
    background: var(--surface-paper);
    padding: 60px 40px 80px;
  }

  .terms-section {
    margin-bottom: 40px;
  }

  .terms-section:last-child {
    margin-bottom: 0;
  }

  .section-heading {
    font-size: 20px;
    font-weight: 600;
    margin: 0 0 16px 0;
    color: var(--text-on-paper);
    line-height: 1.4;
  }

  .section-text {
    color: var(--text-on-paper-muted);
    font-size: 15px;
    line-height: 1.7;
    margin: 0 0 12px 0;
  }

  .section-list {
    color: var(--text-on-paper-muted);
    font-size: 15px;
    line-height: 1.7;
    margin: 0 0 12px 0;
    padding-left: 20px;
  }

  .section-list li {
    margin-bottom: 8px;
  }

  .terms-link {
    color: var(--text-on-paper);
    text-decoration: underline;
    text-decoration-color: var(--acid);
    transition: text-decoration-thickness 0.2s ease;
  }

  .terms-link:hover {
    text-decoration-thickness: 2px;
  }

  @media (max-width: 1024px) {
    .terms-content {
      padding: 40px 30px 60px;
    }
  }

  @media (max-width: 640px) {
    .terms-content {
      padding: 30px 20px 50px;
    }

    .section-heading {
      font-size: 16px;
    }
  }
</style>
