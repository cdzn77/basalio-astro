---
import BaseLayout from '../layouts/BaseLayout.astro';
import RampHeader from '../components/RampHeader.astro';
import RampHero from '../components/RampHero.astro';
---

<BaseLayout title="Test B Variants">
  <!-- Variant 1: Acid background + acid surface -->
  <Fragment slot="header">
    <RampHeader surface="acid" />
  </Fragment>

  <RampHero
    teaserLabel="For WordPress • Not a page builder"
    teaserText="Give your work a foundation to stand on. Nine curated interaction blocks, from grid reveals to case-study transitions to scroll-tied sequences, built only for portfolio and case-study sites. Nothing you'd need Framer for. Nothing you don't."
    teaserButton="EXPLORE BLOCKS"
    teaserLink="/blocks"
    heroImage="https://framerusercontent.com/images/WAxIIZFwFsal6BUSuk7mft7nN7U.png"
    background={{ type: 'color', token: 'acid' }}
    surface="acid"
  />

  <!-- Variant 2: Image background + ink surface -->
  <!-- Note: We need to render with different header surface too, so create new BaseLayout wrapper -->
</BaseLayout>

---

<!-- Variant 2 in separate BaseLayout with different header surface -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Test B - Variant 2</title>
  <link rel="stylesheet" href="/styles/global.css">
  <link rel="stylesheet" href="/styles/tokens.css">
  <style>
    body { padding-top: 80px; }
  </style>
</head>
<body>
  <header class="base-header" id="base-header">
    <div class="header-container" data-surface="ink">
      <a href="/" class="brand-logo">Basalio.</a>
      <div class="menu-wrapper">
        <button id="menu-toggle" class="menu-btn" aria-label="Toggle menu">
          <span>MENU</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
            <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2"/>
          </svg>
        </button>
        <div class="menu-dropdown" id="menu-dropdown">
          <a href="/blocks" class="menu-item">Blocks</a>
          <a href="/pricing" class="menu-item">Pricing</a>
        </div>
      </div>
    </div>
  </header>

  <main class="base-main">
    <section class="hero" data-surface="ink">
      <div class="hero-background">
        <img src="https://framerusercontent.com/images/WAxIIZFwFsal6BUSuk7mft7nN7U.png" alt="" class="hero-bg-image" style="object-position: center; position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; z-index: 0;" />
        <div class="hero-bg-scrim" style="position: absolute; inset: 0; width: 100%; height: 100%; background-color: var(--surface-ink); opacity: 0.35; pointer-events: none; z-index: 0;"></div>
      </div>

      <div class="hero-image-wrapper">
        <img src="https://framerusercontent.com/images/WAxIIZFwFsal6BUSuk7mft7nN7U.png" alt="Hero" class="hero-image-bg" />
      </div>

      <div class="hero-container">
        <div class="hero-left">
          <h1 class="hero-heading">Framer-quality<br/>interactions,<br/>native to WordPress.</h1>
        </div>
      </div>

      <div class="course-teaser">
        <div class="course-left">
          <p class="course-label">For WordPress • Not a page builder</p>
          <p class="course-description">Give your work a foundation to stand on. Nine curated interaction blocks, from grid reveals to case-study transitions to scroll-tied sequences, built only for portfolio and case-study sites. Nothing you'd need Framer for. Nothing you don't.</p>
        </div>
        <a href="/blocks" class="cta-button" style="background: var(--acid); color: var(--text-on-paper); padding: 12px 24px; border-radius: 6px; text-decoration: none; display: inline-block; font-family: 'Azeret Mono', monospace; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; cursor: pointer;">EXPLORE BLOCKS</a>
      </div>
    </section>
  </main>

  <style>
    .hero {
      background: transparent;
      width: 100%;
      max-width: 1791px;
      min-height: 100vh;
      padding: 0;
      margin: 0 auto;
      margin-top: -80px;
      display: flex;
      flex-direction: column;
      box-sizing: border-box;
      overflow: visible;
      position: relative;
      padding-top: 80px;
    }

    .hero-background {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
    }

    .hero-image-wrapper {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 28%;
      max-width: 400px;
      aspect-ratio: 0.7;
      overflow: hidden;
      z-index: 2;
      pointer-events: none;
      border-radius: 8px;
    }

    .hero-image-bg {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      filter: sepia(0.25) saturate(1.1) hue-rotate(-15deg);
      opacity: 0.95;
    }

    .hero-container {
      width: 100%;
      max-width: 1791px;
      flex: 1;
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      gap: 0;
      margin: 0 auto;
      box-sizing: border-box;
      position: relative;
      overflow: visible;
      z-index: 1;
    }

    .hero-left {
      width: 50%;
      padding: 40px 40px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      box-sizing: border-box;
      position: relative;
      z-index: 1;
    }

    .hero-heading {
      font-family: 'Switzer', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 72px;
      font-weight: 400;
      line-height: 72px;
      letter-spacing: -1.44px;
      margin: 0;
      padding: 0;
      margin-top: 80px;
    }

    .hero[data-surface='ink'] .hero-heading {
      color: var(--text-on-ink);
    }

    .course-teaser {
      width: 100%;
      max-width: 1791px;
      padding: 40px 40px;
      background: transparent;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 40px;
      margin: 0 auto;
      box-sizing: border-box;
      position: relative;
      z-index: 2;
      flex-shrink: 0;
    }

    .course-left {
      flex: 0 1 auto;
      max-width: 365px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .course-label {
      font-family: 'Azeret Mono', monospace;
      font-size: 14px;
      font-weight: 500;
      line-height: 19.6px;
      letter-spacing: 2.8px;
      text-transform: uppercase;
      display: block;
      width: auto;
      height: auto;
      margin: 0 0 12px 0;
      padding: 0;
      cursor: pointer;
      transition: color 0.3s cubic-bezier(0, 0, 1, 1);
      text-wrap-style: balance;
    }

    .hero[data-surface='ink'] .course-label {
      color: var(--text-on-ink);
    }

    .course-description {
      font-family: 'Switzer', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 16px;
      font-weight: 400;
      line-height: 22.4px;
      width: 500px;
      margin: 0;
      padding: 0;
      text-wrap-style: balance;
    }

    .hero[data-surface='ink'] .course-description {
      color: var(--text-on-ink);
    }

    .header-container {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 100%;
      box-sizing: border-box;
    }

    .brand-logo {
      background-color: rgba(0, 0, 0, 0);
      box-sizing: border-box;
      cursor: pointer;
      display: inline;
      font-family: Manrope, sans-serif;
      font-size: 30px;
      font-weight: 600;
      height: auto;
      letter-spacing: -1.5px;
      line-height: 30px;
      padding: 0;
      text-align: start;
      text-decoration: none;
      text-wrap-mode: nowrap;
      transition: color 0.3s cubic-bezier(0, 0, 1, 1);
      width: auto;
    }

    .header-container[data-surface='ink'] .brand-logo {
      color: var(--text-on-ink);
    }

    .menu-btn {
      border: none;
      padding: 0 16px;
      border-radius: 6px;
      font-family: 'Azeret Mono', monospace;
      font-size: 14px;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 182px;
      height: 41px;
    }

    .header-container[data-surface='ink'] .menu-btn {
      background: var(--surface-paper);
      color: var(--text-on-paper);
    }

    .base-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 20px 40px;
      width: 100%;
      box-sizing: border-box;
      height: 80px;
      display: flex;
      align-items: center;
      background: transparent;
    }

    .base-main {
      flex: 1;
      position: relative;
      z-index: 10;
    }
  </style>
</body>
</html>
