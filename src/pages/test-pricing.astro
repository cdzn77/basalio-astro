---
import PricingCards from '../components/patterns/PricingCards.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Test: PricingCards Component" description="Testing both variants">
  <div style="padding: 60px 32px;">
    <h1 style="font-size: 32px; margin-bottom: 40px; font-family: Instrument Sans;">Compact Variant (Homepage)</h1>
    <PricingCards variant="compact" />

    <div style="margin-top: 120px;">
      <h1 style="font-size: 32px; margin-bottom: 40px; font-family: Instrument Sans;">Full Variant (/pricing)</h1>
      <PricingCards variant="full" />
    </div>
  </div>
</BaseLayout>
