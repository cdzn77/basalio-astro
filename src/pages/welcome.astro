---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeaderSplit from '../components/patterns/HeaderSplit.astro';
import Button from '../components/Button.astro';

const title = "You're on the List - Basalio";
const description = "Thank you for joining the Basalio waitlist. You'll get one email when the plugin ships.";
---

<BaseLayout {title} {description} noindex>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <HeaderSplit
    eyebrow="YOU'RE ON THE LIST"
    heading="You're in."
    body="Basalio isn't on WordPress.org yet. When the free plugin lands, you'll get one email. If the founder price is about to change, you'll get one more. That's all."
    surface="paper"
  >
    <div class="welcome-link-wrapper">
      <Button label="Read the Hacks" href="/hacks" variant="ink" />
    </div>
  </HeaderSplit>


  <Fragment slot="footer">
    <Footer hideNewsletter={true} />
  </Fragment>
</BaseLayout>

<style>
  .welcome-link-wrapper {
    width: 100%;
  }
</style>
